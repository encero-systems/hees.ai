    prior = phase_one_state(SESSION_START + 100, 1)
    moved = proposal(ContinuityOperationKind.Continue, Some(prior), "phase_two", SESSION_START + 101, 2)
    assert_eq(fixture_rejection(moved), "continue_phase_mismatch")


