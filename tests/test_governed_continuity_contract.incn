    early = proposal(
        ContinuityOperationKind.Close,
        Some(phase_two_state(phase_two_start(), 2)),
        "phase_two",
        SESSION_START + TOTAL_TARGET - 1,
        3,
    )
    assert_eq(fixture_rejection(early), "goal_budget_not_reached")


def test_close_at_exact_total_target_is_admitted() -> None:
    closed = admitted_closed_state()
    assert_eq(closed.closed, true)
    assert_eq(closed.last_clock_seconds, SESSION_START + TOTAL_TARGET)


def expire_at(prior: SessionContinuityState, phase: str, clock: int) -> ContinuityProposal:
    """Return an Expire proposal from ``prior`` in ``phase`` at ``clock``, at the next event index."""

    return proposal(ContinuityOperationKind.Expire, Some(prior.clone()), phase, clock, prior.last_event_index + 1)


def phase_one_overrun_clock() -> int:
    """Return the first clock value at which phase_one has run past its declared maximum."""

    return SESSION_START + PHASE_ONE_MAXIMUM + 1


def admitted_expired_state() -> SessionContinuityState:
    """Return the state ``evaluate_continuity`` produces when it admits Expire one second past phase_one's maximum."""

    expire = expire_at(phase_one_state(SESSION_START + 100, 1), "phase_one", phase_one_overrun_clock())
    return admitted_state(evaluate(continuity_package(), expire), "phase_maximum_expired")


def test_expire_one_second_past_the_phase_maximum_closes_the_session_as_expired() -> None:
    expired = admitted_expired_state()
    assert_eq(expired.phase_id, phase_id("phase_one"))
    assert_eq(expired.started_at_seconds, SESSION_START)
    assert_eq(expired.phase_started_at_seconds, SESSION_START)
    assert_eq(expired.last_clock_seconds, phase_one_overrun_clock())
    assert_eq(expired.last_event_index, 2)
    assert_eq(expired.clock_source, HOST_CLOCK)
    assert_eq(expired.closed, true)
    assert_eq(expired.expired, true)


def test_expire_in_a_later_phase_keeps_both_start_times() -> None:
    prior = phase_two_state(phase_two_start() + 10, 2)
    overrun = phase_two_start() + PHASE_TWO_MAXIMUM + 1
    expired = admitted_state(
        evaluate(continuity_package(), expire_at(prior, "phase_two", overrun)),
        "phase_maximum_expired",
    )
    assert_eq(expired.started_at_seconds, SESSION_START)
    assert_eq(expired.phase_started_at_seconds, phase_two_start())
    assert_eq(expired.expired, true)


def test_expire_at_or_before_the_phase_maximum_is_rejected() -> None:
    prior = phase_one_state(SESSION_START + 100, 1)
    at_maximum = expire_at(prior.clone(), "phase_one", SESSION_START + PHASE_ONE_MAXIMUM)
    assert_eq(fixture_rejection(at_maximum), "phase_maximum_not_exceeded")
    early = expire_at(prior, "phase_one", SESSION_START + 101)
    assert_eq(fixture_rejection(early), "phase_maximum_not_exceeded")


def test_expire_for_a_goal_without_declared_expiry_is_rejected() -> None:
    mut no_expiry = goal_one()
    no_expiry.expiry_allowed = false
    package = with_goal(no_expiry)
    prior = session_state_for(package, "phase_one", SESSION_START, SESSION_START + 100, 1)
    assert_eq(
        rejection(
            package,
            proposal_for(package, ContinuityOperationKind.Expire, Some(prior), "phase_one", phase_one_overrun_clock(), 2),
        ),
        "expiry_not_declared",
    )


def test_expire_naming_another_phase_is_rejected() -> None:
    prior = phase_one_state(SESSION_START + 100, 1)
    assert_eq(fixture_rejection(expire_at(prior, "phase_two", phase_one_overrun_clock())), "expire_phase_mismatch")


def test_expire_passes_the_shared_prior_state_checks() -> None:
    prior = phase_one_state(SESSION_START + 100, 1)
    mut replayed = expire_at(prior.clone(), "phase_one", phase_one_overrun_clock())
    replayed.event_index = 1
    assert_eq(fixture_rejection(replayed), "event_index_not_monotonic")
    assert_eq(fixture_rejection(expire_at(prior.clone(), "phase_one", SESSION_START + 99)), "clock_regression")
    external = on_clock(expire_at(prior.clone(), "phase_one", phase_one_overrun_clock()), EXTERNAL_CLOCK)
    assert_eq(fixture_rejection(external), "clock_source_changed")
    mut forged = prior.clone()
    forged.last_clock_seconds = SESSION_START + 101
    assert_eq(
        fixture_rejection(expire_at(forged, "phase_one", phase_one_overrun_clock())),
        "prior_state_witness_invalid",
    )
    mut undeclared_action = expire_at(prior, "phase_one", phase_one_overrun_clock())
    undeclared_action.proposed_action_id = action_id("delete_everything")
    assert_eq(fixture_rejection(undeclared_action), "action_not_allowed_for_goal")


def test_expire_with_an_action_the_phase_does_not_declare_is_rejected() -> None:
    prior = phase_two_state(phase_two_start(), 2)
    mut guide = expire_at(prior, "phase_two", phase_two_start() + PHASE_TWO_MAXIMUM + 1)
    guide.proposed_action_id = action_id("guide")
    assert_eq(fixture_rejection(guide), "action_not_allowed_for_phase")


def test_every_operation_on_an_expired_session_is_rejected() -> None:
    expired = admitted_expired_state()
    clock = phase_one_overrun_clock() + 1
    continuing = proposal(ContinuityOperationKind.Continue, Some(expired.clone()), "phase_one", clock, 3)
    assert_eq(fixture_rejection(continuing), "session_already_closed")
    transitioning = proposal(ContinuityOperationKind.Transition, Some(expired.clone()), "phase_two", clock, 3)
    assert_eq(fixture_rejection(transitioning), "session_already_closed")
    closing = proposal(ContinuityOperationKind.Close, Some(expired.clone()), "phase_one", clock, 3)
    assert_eq(fixture_rejection(closing), "session_already_closed")
    expiring_again = proposal(ContinuityOperationKind.Expire, Some(expired.clone()), "phase_one", clock, 3)
    assert_eq(fixture_rejection(expiring_again), "session_already_closed")
    restarting = proposal(ContinuityOperationKind.Start, Some(expired), "phase_one", clock, 0)
    assert_eq(fixture_rejection(restarting), "start_requires_empty_state")


def test_forged_expired_flag_fails_the_witness() -> None:
    mut flagged_open = phase_one_state(SESSION_START + 100, 1)
    flagged_open.expired = true
    assert_eq(fixture_rejection(continue_from(flagged_open)), "prior_state_witness_invalid")

    mut unexpired = admitted_expired_state()
    unexpired.expired = false
    reopened = proposal(ContinuityOperationKind.Continue, Some(unexpired), "phase_one", phase_one_overrun_clock(), 3)
    assert_eq(fixture_rejection(reopened), "prior_state_witness_invalid")

    normal_close = admitted_closed_state()
    mut relabeled_close = normal_close.clone()
    relabeled_close.expired = true
    relabeled = proposal(
        ContinuityOperationKind.Continue,
        Some(relabeled_close),
        "phase_two",
        SESSION_START + TOTAL_TARGET,
        4,
    )
    assert_eq(fixture_rejection(relabeled), "prior_state_witness_invalid")


def test_prior_state_with_inconsistent_expiry_is_rejected() -> None:
    mut expired_but_open = phase_one_state(phase_one_overrun_clock(), 2)
    expired_but_open.expired = true
    assert_eq(
        inconsistent_prior_reason(expired_but_open, "phase_one", phase_one_overrun_clock()),
        "prior_state_inconsistent",
    )

    mut expired_within_maximum = phase_one_state(SESSION_START + PHASE_ONE_MAXIMUM, 2)
    expired_within_maximum.closed = true
    expired_within_maximum.expired = true
    assert_eq(
        inconsistent_prior_reason(expired_within_maximum, "phase_one", SESSION_START + PHASE_ONE_MAXIMUM),
        "prior_state_inconsistent",
    )

    mut closed_past_maximum = phase_two_state(phase_two_start() + PHASE_TWO_MAXIMUM + 1, 3)
    closed_past_maximum.closed = true
    assert_eq(
        inconsistent_prior_reason(closed_past_maximum, "phase_two", phase_two_start() + PHASE_TWO_MAXIMUM + 1),
        "prior_state_inconsistent",
    )

    mut expired_past_maximum = phase_one_state(phase_one_overrun_clock(), 2)
    expired_past_maximum.closed = true
    expired_past_maximum.expired = true
    assert_eq(
        inconsistent_prior_reason(expired_past_maximum, "phase_one", phase_one_overrun_clock()),
        "session_already_closed",
    )


def test_genuine_continuity_package_is_valid() -> None:
    assert_eq(validation_reason(continuity_package()), "valid")
    assert_eq(validation_reason(two_goal_package()), "valid")


def test_stale_continuity_package_digest_after_schedule_change_is_rejected() -> None:
    mut mutated = continuity_package()
    mut first_schedule = mutated.schedules[0]
    first_schedule.total_target_seconds = first_schedule.total_target_seconds + 1
    mutated.schedules[0] = first_schedule
    assert_eq(validation_reason(mutated), "continuity_declaration_digest_mismatch")


def test_stale_continuity_package_digest_after_goal_change_is_rejected() -> None:
    mut mutated = continuity_package()
    mut first_goal = mutated.goals[0]
    first_goal.allowed_action_ids = [action_id("answer")]
    mutated.goals[0] = first_goal
    assert_eq(validation_reason(mutated), "continuity_declaration_digest_mismatch")


def test_stale_continuity_package_digest_after_expiry_declaration_change_is_rejected() -> None:
    mut mutated = continuity_package()
    mut first_goal = mutated.goals[0]
    first_goal.expiry_allowed = false
    mutated.goals[0] = first_goal
    assert_eq(validation_reason(mutated), "continuity_declaration_digest_mismatch")


def test_continuity_declaration_digest_hashes_its_type_tag() -> None:
    package = continuity_package()
    projection = declaration_projection_json(package)
    tagged = assert_is_ok(digest_tagged_json(DECLARATION_TYPE_TAG, projection))
    assert_eq(digest_continuity_package(package), tagged)
    assert_eq(digest_continuity_package(package) == assert_is_ok(digest_canonical_json(projection)), false)
    assert_eq(digest_continuity_package(package) == assert_is_ok(digest_tagged_json(STATE_TYPE_TAG, projection)), false)


def test_package_without_goals_or_schedules_is_rejected() -> None:
    mut no_goals = continuity_package()
    no_goals.goals = []
    assert_eq(validation_reason(rewitnessed(no_goals)), "continuity_declarations_empty")
    mut no_schedules = continuity_package()
    no_schedules.schedules = []
    assert_eq(validation_reason(rewitnessed(no_schedules)), "continuity_declarations_empty")


def repeated_goals(count: int) -> list[GovernedGoal]:
    """Return ``count`` copies of the fixture goal."""

    mut goals: list[GovernedGoal] = []
    for _index in range(count):
        goals.append(goal_one())
    return goals


def repeated_schedules(count: int) -> list[GovernedSchedule]:
    """Return ``count`` copies of the fixture schedule."""

    mut schedules: list[GovernedSchedule] = []
    for _index in range(count):
        schedules.append(schedule_one())
    return schedules


def repeated_phases(count: int) -> list[GovernedPhase]:
    """Return ``count`` copies of the fixture entry phase."""

    mut phases: list[GovernedPhase] = []
    for _index in range(count):
        phases.append(phase_one())
    return phases


def repeated_phase_two_ids(count: int) -> list[PhaseId]:
    """Return ``count`` copies of the phase_two identifier."""

    mut ids: list[PhaseId] = []
    for _index in range(count):
        ids.append(phase_id("phase_two"))
    return ids


def distinct_actions(count: int) -> list[ActionId]:
    """Return ``count`` distinct canonical action identifiers."""

    mut ids: list[ActionId] = []
    for index in range(count):
        ids.append(action_id(f"action_{index}"))
    return ids


def distinct_clock_sources(count: int) -> list[str]:
    """Return ``count`` distinct canonical clock-source names."""

    mut sources: list[str] = []
    for index in range(count):
        sources.append(f"clock_{index}")
    return sources


def test_goal_and_schedule_counts_at_bound_pass_and_one_over_are_rejected() -> None:
    mut goals_at_bound = continuity_package()
    goals_at_bound.goals = repeated_goals(MAX_CONTINUITY_GOALS)
    assert_eq(validation_reason(rewitnessed(goals_at_bound)), "duplicate_goal_id")
    mut goals_over = continuity_package()
    goals_over.goals = repeated_goals(MAX_CONTINUITY_GOALS + 1)
    assert_eq(validation_reason(rewitnessed(goals_over)), "continuity_bounds_exceeded")

    mut schedules_at_bound = continuity_package()
    schedules_at_bound.schedules = repeated_schedules(MAX_CONTINUITY_SCHEDULES)
    assert_eq(validation_reason(rewitnessed(schedules_at_bound)), "duplicate_schedule_id")
    mut schedules_over = continuity_package()
    schedules_over.schedules = repeated_schedules(MAX_CONTINUITY_SCHEDULES + 1)
    assert_eq(validation_reason(rewitnessed(schedules_over)), "continuity_bounds_exceeded")


def test_phase_count_at_bound_passes_and_one_over_is_rejected() -> None:
    assert_eq(validation_reason(with_phases(repeated_phases(MAX_SCHEDULE_PHASES))), "duplicate_phase_id")
    assert_eq(validation_reason(with_phases(repeated_phases(MAX_SCHEDULE_PHASES + 1))), "continuity_bounds_exceeded")


def test_clock_source_count_at_bound_passes_and_one_over_is_rejected() -> None:
    mut at_bound = schedule_one()
    at_bound.allowed_clock_sources = distinct_clock_sources(MAX_SCHEDULE_CLOCK_SOURCES)
    assert_eq(validation_reason(with_schedule(at_bound)), "valid")
    mut over = schedule_one()
    over.allowed_clock_sources = distinct_clock_sources(MAX_SCHEDULE_CLOCK_SOURCES + 1)
    assert_eq(validation_reason(with_schedule(over)), "continuity_bounds_exceeded")


def test_action_counts_at_bound_pass_and_one_over_are_rejected() -> None:
    mut phase_at_bound = phase_one()
    phase_at_bound.allowed_action_ids = distinct_actions(MAX_DECLARED_ACTIONS)
    assert_eq(validation_reason(with_first_phase(phase_at_bound)), "valid")
    mut phase_over = phase_one()
    phase_over.allowed_action_ids = distinct_actions(MAX_DECLARED_ACTIONS + 1)
    assert_eq(validation_reason(with_first_phase(phase_over)), "continuity_bounds_exceeded")

    mut goal_at_bound = goal_one()
    goal_at_bound.allowed_action_ids = distinct_actions(MAX_DECLARED_ACTIONS)
    assert_eq(validation_reason(with_goal(goal_at_bound)), "valid")
    mut goal_over = goal_one()
    goal_over.allowed_action_ids = distinct_actions(MAX_DECLARED_ACTIONS + 1)
    assert_eq(validation_reason(with_goal(goal_over)), "continuity_bounds_exceeded")


def test_phase_reference_counts_at_bound_pass_and_one_over_are_rejected() -> None:
    mut completion_at_bound = goal_one()
    completion_at_bound.completion_phase_ids = repeated_phase_two_ids(MAX_SCHEDULE_PHASES)
    assert_eq(validation_reason(with_goal(completion_at_bound)), "valid")
    mut completion_over = goal_one()
    completion_over.completion_phase_ids = repeated_phase_two_ids(MAX_SCHEDULE_PHASES + 1)
    assert_eq(validation_reason(with_goal(completion_over)), "continuity_bounds_exceeded")

    mut next_at_bound = phase_one()
    next_at_bound.next_phase_ids = repeated_phase_two_ids(MAX_SCHEDULE_PHASES)
    assert_eq(validation_reason(with_first_phase(next_at_bound)), "valid")
    mut next_over = phase_one()
    next_over.next_phase_ids = repeated_phase_two_ids(MAX_SCHEDULE_PHASES + 1)
    assert_eq(validation_reason(with_first_phase(next_over)), "continuity_bounds_exceeded")


def test_seconds_at_bound_pass_and_one_over_are_rejected() -> None:
    mut longest_phase = phase_two()
    longest_phase.maximum_seconds = MAX_CONTINUITY_INTEGER
    mut at_bound = schedule_one()
    at_bound.phases = [phase_one(), longest_phase.clone()]
    at_bound.total_target_seconds = MAX_CONTINUITY_INTEGER
    assert_eq(validation_reason(with_schedule(at_bound)), "valid")

    mut phase_over = longest_phase.clone()
    phase_over.maximum_seconds = MAX_CONTINUITY_INTEGER + 1
    assert_eq(validation_reason(with_phases([phase_one(), phase_over])), "continuity_bounds_exceeded")

    mut target_over = at_bound.clone()
    target_over.total_target_seconds = MAX_CONTINUITY_INTEGER + 1
    assert_eq(validation_reason(with_schedule(target_over)), "continuity_bounds_exceeded")


def test_package_with_unsafe_identifier_text_is_rejected() -> None:
    mut spaced_package = continuity_package()
    spaced_package.package_id = PackageId(SymbolicIdType(IdType("Package One")))
    assert_eq(validation_reason(rewitnessed(spaced_package)), "invalid_continuity_identifier")

    mut malformed_digest = continuity_package()
    malformed_digest.continuity_declaration_digest = DigestIdType(IdType("sha256:not-a-digest"))
    assert_eq(validation_reason(malformed_digest), "invalid_continuity_identifier")

    mut uppercase_goal = goal_one()
    uppercase_goal.goal_id = GoalId(SymbolicIdType(IdType("Goal_One")))
    assert_eq(validation_reason(with_goal(uppercase_goal)), "invalid_continuity_identifier")

    mut spaced_phase = phase_one()
    spaced_phase.phase_id = PhaseId(SymbolicIdType(IdType(" phase_one")))
    assert_eq(validation_reason(with_first_phase(spaced_phase)), "invalid_continuity_identifier")

    mut uppercase_action = phase_one()
    uppercase_action.allowed_action_ids = [ActionId(SymbolicIdType(IdType("Answer")))]
    assert_eq(validation_reason(with_first_phase(uppercase_action)), "invalid_continuity_identifier")


def test_clock_source_text_is_validated_and_bounded() -> None:
    mut empty = schedule_one()
    empty.allowed_clock_sources = [""]
    assert_eq(validation_reason(with_schedule(empty)), "invalid_continuity_identifier")
    mut spaced = schedule_one()
    spaced.allowed_clock_sources = ["Host Clock"]
    assert_eq(validation_reason(with_schedule(spaced)), "invalid_continuity_identifier")
    mut at_bound = schedule_one()
    at_bound.allowed_clock_sources = [repeated_a(MAX_IDENTIFIER_LENGTH)]
    assert_eq(validation_reason(with_schedule(at_bound)), "valid")
    mut over = schedule_one()
    over.allowed_clock_sources = [repeated_a(MAX_IDENTIFIER_LENGTH + 1)]
    assert_eq(validation_reason(with_schedule(over)), "invalid_continuity_identifier")


def test_duplicate_clock_source_is_rejected() -> None:
    mut duplicated = schedule_one()
    duplicated.allowed_clock_sources = [HOST_CLOCK, HOST_CLOCK]
    assert_eq(validation_reason(with_schedule(duplicated)), "duplicate_clock_source")


def test_schedule_for_an_undeclared_goal_is_rejected() -> None:
    mut orphan = schedule_one()
    orphan.goal_id = goal_id("other_goal")
    assert_eq(validation_reason(with_schedule(orphan)), "schedule_goal_unknown")


def test_goal_without_a_schedule_is_rejected() -> None:
    mut package = continuity_package()
    mut unscheduled = goal_one()
    unscheduled.goal_id = goal_id("goal_two")
    package.goals = [goal_one(), unscheduled]
    assert_eq(validation_reason(rewitnessed(package)), "goal_schedule_missing")


def test_empty_schedule_declarations_are_rejected() -> None:
    mut zero_target = schedule_one()
    zero_target.total_target_seconds = 0
    assert_eq(validation_reason(with_schedule(zero_target)), "schedule_declaration_empty")
    mut no_clock_sources = schedule_one()
    no_clock_sources.allowed_clock_sources = []
    assert_eq(validation_reason(with_schedule(no_clock_sources)), "schedule_declaration_empty")
    assert_eq(validation_reason(with_phases([])), "schedule_declaration_empty")


def test_duplicate_phase_is_rejected() -> None:
    assert_eq(validation_reason(with_phases([phase_one(), phase_two(), phase_two()])), "duplicate_phase_id")


def test_inconsistent_phase_budgets_are_rejected() -> None:
    mut negative_minimum = phase_one()
    negative_minimum.minimum_seconds = -1
    assert_eq(validation_reason(with_first_phase(negative_minimum)), "invalid_phase_budget")
    mut target_below_minimum = phase_one()
    target_below_minimum.target_seconds = PHASE_ONE_MINIMUM - 1
    assert_eq(validation_reason(with_first_phase(target_below_minimum)), "invalid_phase_budget")
    mut maximum_below_target = phase_one()
    maximum_below_target.maximum_seconds = PHASE_ONE_TARGET - 1
    assert_eq(validation_reason(with_first_phase(maximum_below_target)), "invalid_phase_budget")


def test_phase_with_equal_minimum_target_and_maximum_is_valid() -> None:
    mut fixed = phase_one()
    fixed.minimum_seconds = PHASE_ONE_TARGET
    fixed.maximum_seconds = PHASE_ONE_TARGET
    assert_eq(validation_reason(with_first_phase(fixed)), "valid")


def test_phase_without_actions_is_rejected() -> None:
