    looping.next_phase_ids = [phase_id("phase_one")]
    assert_eq(validation_reason(with_first_phase(looping)), "phase_self_cycle")


def test_phase_linking_to_an_undeclared_phase_is_rejected() -> None:
    mut dangling = phase_one()
    dangling.next_phase_ids = [phase_id("phase_unknown")]
    assert_eq(validation_reason(with_first_phase(dangling)), "unknown_next_phase")


def test_phase_graph_must_be_declared_in_topological_order() -> None:
    mut backward = phase_two()
    backward.next_phase_ids = [phase_id("phase_one")]
    assert_eq(validation_reason(with_phases([phase_one(), backward])), "phase_graph_not_topological")


