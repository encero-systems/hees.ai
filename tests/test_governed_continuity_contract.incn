    mut no_completion = goal_one()
    no_completion.completion_phase_ids = []
    assert_eq(validation_reason(with_goal(no_completion)), "goal_declaration_empty")
    mut no_actions = goal_one()
    no_actions.allowed_action_ids = []
    assert_eq(validation_reason(with_goal(no_actions)), "goal_declaration_empty")


def test_goal_naming_undeclared_phases_is_rejected() -> None:
    mut unknown_entry = goal_one()
    unknown_entry.entry_phase_id = phase_id("phase_unknown")
    assert_eq(validation_reason(with_goal(unknown_entry)), "goal_entry_phase_unknown")
    mut unknown_completion = goal_one()
    unknown_completion.completion_phase_ids = [phase_id("phase_unknown")]
    assert_eq(validation_reason(with_goal(unknown_completion)), "goal_completion_phase_unknown")


def test_total_target_at_the_longest_reachable_maximum_is_valid() -> None:
    mut at_limit = schedule_one()
    at_limit.total_target_seconds = PHASE_ONE_MAXIMUM + PHASE_TWO_MAXIMUM
    assert_eq(validation_reason(with_schedule(at_limit)), "valid")


def test_total_target_beyond_the_longest_reachable_maximum_is_rejected() -> None:
    mut unreachable = schedule_one()
    unreachable.total_target_seconds = PHASE_ONE_MAXIMUM + PHASE_TWO_MAXIMUM + 1
    package = with_schedule(unreachable)
    assert_eq(validation_reason(package), "schedule_target_unreachable")
    assert_eq(rejection(package, start_proposal()), "invalid_continuity_package")


def test_completion_phase_unreachable_from_entry_is_rejected() -> None:
    mut reversed_goal = goal_one()
    reversed_goal.entry_phase_id = phase_id("phase_two")
    reversed_goal.completion_phase_ids = [phase_id("phase_one")]
    assert_eq(validation_reason(with_goal(reversed_goal)), "schedule_target_unreachable")


def test_an_earlier_state_still_verifies_so_the_host_owns_freshness() -> None:
    """Hees.ai holds no store: a state from before an admitted Close stays valid input, as RFC 013 Drawbacks states."""

    package = continuity_package()
    started = admitted_state(evaluate(package, start_proposal()), "declared_goal_started")
    first = proposal(ContinuityOperationKind.Continue, Some(started), "phase_one", SESSION_START + 1, 1)
    admitted_state(evaluate(package, first), "continue_current_phase")
    replayed = proposal(ContinuityOperationKind.Continue, Some(started), "phase_one", SESSION_START + 2, 1)
    admitted_state(evaluate(package, replayed), "continue_current_phase")
