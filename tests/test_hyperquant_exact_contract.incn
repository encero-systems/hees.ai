"""Contract tests for the Hyperquant exact retrieval oracle."""

import std.math
from std.testing import assert_eq, assert_is_err, assert_is_ok
from crate.hyperquant import (
    HyperquantEntry,
    HyperquantErrorKind,
    HyperquantExactIndex,
    HyperquantNomination,
    MAX_HYPERQUANT_DIMENSIONS,
    exact_index,
    exact_query,
    hyperquant_entry,
)
from crate.identifiers import memory_id, memory_id_text


def entry(id: str, values: list[float]) -> HyperquantEntry:
    return assert_is_ok(hyperquant_entry(memory_id(id), values))


def index(entries: list[HyperquantEntry]) -> HyperquantExactIndex:
    return assert_is_ok(exact_index(entries))


def nomination_ids(nominations: list[HyperquantNomination]) -> list[str]:
    return [memory_id_text(nomination.memory_id) for nomination in nominations]


def test_exact_oracle_ranks_nearest_memory_with_dense_ranks() -> None:
    built = index([entry("axis_x", [1.0, 0.0]), entry("axis_y", [0.0, 1.0]), entry("opposite_x", [-1.0, 0.0])])
    result = assert_is_ok(exact_query(built, [1.0, 0.0], 3))

    assert_eq(nomination_ids(result.nominations), ["axis_x", "axis_y", "opposite_x"])
    assert_eq(result.nominations[0].rank, 0)
    assert_eq(result.nominations[1].rank, 1)
    assert_eq(result.nominations[2].rank, 2)
    assert_eq(result.nominations[0].relevance_bps, 10000)
    assert_eq(result.nominations[1].relevance_bps, 0)
    assert_eq(result.nominations[2].relevance_bps, 0)
    assert_eq(len(result.candidates), 3)


def test_exact_oracle_retains_only_the_bounded_top_k_trace() -> None:
    built = index([entry("axis_x", [1.0, 0.0]), entry("axis_y", [0.0, 1.0]), entry("opposite_x", [-1.0, 0.0])])
    result = assert_is_ok(exact_query(built, [1.0, 0.0], 1))

    assert_eq(nomination_ids(result.nominations), ["axis_x"])
    assert_eq(len(result.candidates), 1)


def test_exact_oracle_is_scale_invariant() -> None:
    built = index([entry("near", [2.0, 1.0]), entry("far", [0.0, 3.0])])
    unit_result = assert_is_ok(exact_query(built, [2.0, 1.0], 2))
    scaled_result = assert_is_ok(exact_query(built, [20.0, 10.0], 2))

    assert_eq(nomination_ids(unit_result.nominations), nomination_ids(scaled_result.nominations))
    assert_eq(unit_result.nominations[0].relevance_bps, scaled_result.nominations[0].relevance_bps)
    assert_eq(unit_result.nominations[1].relevance_bps, scaled_result.nominations[1].relevance_bps)


def test_vector_normalization_handles_extreme_finite_magnitudes() -> None:
    built = index([entry("huge_axis_x", [1.0e300, 0.0]), entry("tiny_axis_y", [0.0, 1.0e-300])])
    result = assert_is_ok(exact_query(built, [1.0e300, 0.0], 2))

    assert_eq(nomination_ids(result.nominations), ["huge_axis_x", "tiny_axis_y"])
    assert_eq(result.nominations[0].relevance_bps, 10000)


def test_exact_oracle_breaks_score_ties_by_canonical_memory_id() -> None:
    built = index([entry("zeta", [1.0, 0.0]), entry("alpha", [1.0, 0.0])])
    result = assert_is_ok(exact_query(built, [1.0, 0.0], 2))

    assert_eq(nomination_ids(result.nominations), ["alpha", "zeta"])


def test_exact_index_rejects_empty_and_duplicate_entries() -> None:
    empty = assert_is_err(exact_index([]))
    assert_eq(empty.kind(), HyperquantErrorKind.EmptyIndex)

    duplicate = assert_is_err(exact_index([entry("same", [1.0, 0.0]), entry("same", [0.0, 1.0])]))
    assert_eq(duplicate.kind(), HyperquantErrorKind.DuplicateMemoryId)


def test_vector_contract_rejects_empty_zero_nonfinite_and_oversized_vectors() -> None:
    assert_eq(assert_is_err(hyperquant_entry(memory_id("empty"), [])).kind(), HyperquantErrorKind.EmptyVector)
    assert_eq(assert_is_err(hyperquant_entry(memory_id("zero"), [0.0, 0.0])).kind(), HyperquantErrorKind.ZeroVector)
    assert_eq(
        assert_is_err(hyperquant_entry(memory_id("nan"), [math.NAN, 1.0])).kind(),
        HyperquantErrorKind.NonFiniteValue,
    )
    assert_eq(
        assert_is_err(hyperquant_entry(memory_id("oversized"), [1.0 for _index in range(MAX_HYPERQUANT_DIMENSIONS + 1)])).kind(),
        HyperquantErrorKind.VectorTooLarge,
    )


def test_exact_query_rejects_invalid_query_shapes_and_limits() -> None:
    built = index([entry("memory", [1.0, 0.0])])

    assert_eq(assert_is_err(exact_query(built, [], 1)).kind(), HyperquantErrorKind.EmptyVector)
    assert_eq(assert_is_err(exact_query(built, [0.0, 0.0], 1)).kind(), HyperquantErrorKind.ZeroVector)
    assert_eq(assert_is_err(exact_query(built, [1.0], 1)).kind(), HyperquantErrorKind.DimensionMismatch)
    assert_eq(assert_is_err(exact_query(built, [1.0, 0.0], 0)).kind(), HyperquantErrorKind.InvalidTopK)
    assert_eq(assert_is_err(exact_query(built, [1.0, 0.0], 2)).kind(), HyperquantErrorKind.InvalidTopK)


def test_exact_query_does_not_mutate_caller_values() -> None:
    source_values = [3.0, 4.0]
    query_values = [4.0, 3.0]
    built = index([entry("memory", source_values)])
    _result = assert_is_ok(exact_query(built, query_values, 1))

    assert_eq(source_values, [3.0, 4.0])
    assert_eq(query_values, [4.0, 3.0])
