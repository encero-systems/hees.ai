def test_evidence_text_bounds() -> None:
    mut claim = first_evidence()
    claim.claim = repeated("c", MAX_PACKAGE_TEXT_LENGTH)
    assert_eq(acceptance(with_first_evidence(claim.clone())), "ok")
    claim.claim = repeated("c", MAX_PACKAGE_TEXT_LENGTH + 1)
    assert_eq(rejection(with_first_evidence(claim)), "invalid_evidence_claim")
    mut guidance = first_evidence()
    guidance.guidance = repeated("g", MAX_PACKAGE_TEXT_LENGTH)
    assert_eq(acceptance(with_first_evidence(guidance.clone())), "ok")
    guidance.guidance = repeated("g", MAX_PACKAGE_TEXT_LENGTH + 1)
    assert_eq(rejection(with_first_evidence(guidance)), "invalid_evidence_guidance")
    mut source = first_evidence()
    source.source_ref = repeated("s", MAX_SOURCE_REF_LENGTH)
    assert_eq(acceptance(with_first_evidence(source.clone())), "ok")
    source.source_ref = repeated("s", MAX_SOURCE_REF_LENGTH + 1)
    assert_eq(rejection(with_first_evidence(source)), "invalid_evidence_source")
    mut kind = first_evidence()
    kind.source_kind = repeated("k", MAX_PACKAGE_LABEL_LENGTH)
    assert_eq(acceptance(with_first_evidence(kind.clone())), "ok")
    kind.source_kind = repeated("k", MAX_PACKAGE_LABEL_LENGTH + 1)
    assert_eq(rejection(with_first_evidence(kind)), "invalid_evidence_source")
    mut authority = first_evidence()
    authority.authority_class = repeated("a", MAX_PACKAGE_LABEL_LENGTH)
    assert_eq(acceptance(with_first_evidence(authority.clone())), "ok")
    authority.authority_class = repeated("a", MAX_PACKAGE_LABEL_LENGTH + 1)
    assert_eq(rejection(with_first_evidence(authority)), "invalid_evidence_authority")
    mut evidence_kind = first_evidence()
    evidence_kind.evidence_kind = repeated("e", MAX_PACKAGE_LABEL_LENGTH)
    assert_eq(acceptance(with_first_evidence(evidence_kind.clone())), "ok")
    evidence_kind.evidence_kind = repeated("e", MAX_PACKAGE_LABEL_LENGTH + 1)
    assert_eq(rejection(with_first_evidence(evidence_kind)), "invalid_evidence_kind")
    mut language = first_evidence()
    language.language = repeated("l", MAX_LANGUAGE_LENGTH)
    assert_eq(acceptance(with_first_evidence(language.clone())), "ok")
    language.language = repeated("l", MAX_LANGUAGE_LENGTH + 1)
    assert_eq(rejection(with_first_evidence(language.clone())), "invalid_evidence_language")
    language.language = f"l"
    assert_eq(rejection(with_first_evidence(language)), "invalid_evidence_language")


def test_source_references_agree_with_the_structural_kernel() -> None:
    for unsafe_ref in ["https://example.org/lantern", "fictional:/lantern", "../lantern", "/lantern", "a\\b", "file://lantern"]:
        mut record = first_evidence()
        record.source_ref = unsafe_ref
        assert_eq(rejection(with_first_evidence(record)), "invalid_evidence_source")
    mut safe_record = first_evidence()
    safe_record.source_ref = f"fictional_lantern_handbook:pages/1-2"
    package = rewitnessed(with_first_evidence(safe_record))
    assert_eq(validate_governed_profile_package(package).reason, "ok")
    bound = request("Which card first?")
    proposal = answer_proposal(package, bound)
    result = evaluate_with_committee(package, bound, proposal)
    assert_eq(result.spectrum.decision, "deliver")
    assert_eq(result.spectrum.structural_reason, Some("admitted"))


def test_evidence_identity_and_admission_are_validated() -> None:
    mut bad_id = first_evidence()
    bad_id.evidence_id = EvidenceId(SymbolicIdType(IdType(f"Evidence With Spaces")))
    assert_eq(rejection(with_first_evidence(bad_id)), "invalid_evidence_id")
    mut fingerprint = first_evidence()
    fingerprint.source_fingerprint = DigestIdType(IdType(f"not-a-digest"))
    assert_eq(rejection(with_first_evidence(fingerprint)), "invalid_source_fingerprint")
    mut pending = first_evidence()
    pending.review_state = f"pending"
    assert_eq(rejection(with_first_evidence(pending)), "evidence_not_admitted")
    mut blocked = first_evidence()
    blocked.rights_state = f"blocked"
    assert_eq(rejection(with_first_evidence(blocked)), "evidence_not_admitted")


def test_memory_atoms_are_validated() -> None:
    mut bad_id = first_atom()
    bad_id.memory_id = MemoryId(SymbolicIdType(IdType(f"Memory With Spaces")))
    assert_eq(rejection(with_first_atom(bad_id)), "invalid_memory_id")
    mut concept = first_atom()
    concept.concept = repeated("c", MAX_PACKAGE_TEXT_LENGTH)
    assert_eq(acceptance(with_first_atom(concept.clone())), "ok")
    concept.concept = repeated("c", MAX_PACKAGE_TEXT_LENGTH + 1)
    assert_eq(rejection(with_first_atom(concept)), "invalid_memory_concept")
    mut duplicate = first_atom()
    duplicate.evidence_ids = [evidence_id("lantern_evidence_card_order"), evidence_id("lantern_evidence_card_order")]
    assert_eq(rejection(with_first_atom(duplicate)), "duplicate_memory_evidence")
    mut unknown = first_atom()
    unknown.evidence_ids = [evidence_id("lantern_evidence_unknown")]
    assert_eq(rejection(with_first_atom(unknown)), "unknown_memory_evidence")
    mut pending = first_atom()
    pending.review_state = f"pending"
    assert_eq(rejection(with_first_atom(pending)), "memory_not_admitted")
    mut provenance = lantern_package()
    mut atom = provenance.memory[0]
    atom.provenance_digest = DigestIdType(IdType(f"not-a-digest"))
    provenance.memory[0] = atom
    result = validate_governed_profile_package(provenance)
    assert_eq(result.reason, "invalid_package")
    assert_eq(result.errors[0], "invalid_memory_provenance")


def test_guided_material_identity_and_relationships_are_validated() -> None:
    mut bad_id = guide()
    bad_id.guided_material_id = GuidedMaterialId(SymbolicIdType(IdType(f"Guide With Spaces")))
    assert_eq(rejection(with_guide(bad_id)), "invalid_guided_material_identity")
    mut language = guide()
    language.language = f"E"
    assert_eq(rejection(with_guide(language)), "invalid_guided_material_language")
    mut pending = guide()
    pending.review_state = f"pending"
    assert_eq(rejection(with_guide(pending)), "guided_material_not_admitted")
    mut duplicate_memory = guide()
    duplicate_memory.memory_ids = [memory_id("lantern_atom_card_order"), memory_id("lantern_atom_card_order")]
    assert_eq(rejection(with_guide(duplicate_memory)), "duplicate_guided_memory")
    mut duplicate_evidence = guide()
    duplicate_evidence.evidence_ids = [evidence_id("lantern_evidence_card_order"), evidence_id(
        "lantern_evidence_card_order",
    )]
    assert_eq(rejection(with_guide(duplicate_evidence)), "duplicate_guided_evidence")
    mut unknown_memory = guide()
    unknown_memory.memory_ids = [memory_id("lantern_atom_unknown")]
    assert_eq(rejection(with_guide(unknown_memory)), "unknown_guided_memory")
    mut unknown_evidence = guide()
    unknown_evidence.evidence_ids = [evidence_id("lantern_evidence_unknown")]
    assert_eq(rejection(with_guide(unknown_evidence)), "unknown_guided_evidence")
    mut mismatch = guide()
    mismatch.evidence_ids = [evidence_id("lantern_evidence_card_order")]
    assert_eq(rejection(with_guide(mismatch)), "guided_memory_evidence_mismatch")


def test_guided_material_actions_and_steps_are_validated() -> None:
    mut unknown_presentation = guide()
    unknown_presentation.presentation_action_id = action_id("present_unknown")
    assert_eq(rejection(with_guide(unknown_presentation)), "unknown_guided_presentation_action")
    mut wrong_presentation = guide()
    wrong_presentation.presentation_action_id = action_id("answer_from_package")
    assert_eq(rejection(with_guide(wrong_presentation)), "invalid_guided_presentation_action")
    mut unknown_navigation = guide()
    unknown_navigation.navigation_action_id = action_id("navigate_unknown")
    assert_eq(rejection(with_guide(unknown_navigation)), "unknown_guided_navigation_action")
    mut wrong_navigation = guide()
    wrong_navigation.navigation_action_id = action_id("present_guided_card")
    assert_eq(rejection(with_guide(wrong_navigation)), "invalid_guided_navigation_action")
    mut duplicate_step = guide()
    duplicate_step.steps = [guided_step_id("choose_starting_card"), guided_step_id("choose_starting_card")]
    duplicate_step.transitions = []
    assert_eq(rejection(with_guide(duplicate_step)), "duplicate_guided_step")
    mut unknown_step = guide()
    unknown_step.transitions = [GuidedTransition(
        current_step_id=guided_step_id("choose_starting_card"),
        next_step_id=guided_step_id("choose_unknown"),
    )]
    assert_eq(rejection(with_guide(unknown_step)), "unknown_guided_transition_step")
    mut self_loop = guide()
    self_loop.transitions = [GuidedTransition(
        current_step_id=guided_step_id("choose_pacing"),
        next_step_id=guided_step_id("choose_pacing"),
    )]
    assert_eq(rejection(with_guide(self_loop)), "self_guided_transition")
    mut repeated_edge = guide()
    repeated_edge.transitions = [guide().transitions[0], guide().transitions[0]]
    assert_eq(rejection(with_guide(repeated_edge)), "duplicate_guided_transition")


def test_committee_policy_is_validated() -> None:
    mut duplicate = unwitnessed_package().policy
    duplicate.required_roles = [committee_role_id("scope"), committee_role_id("scope")]
    assert_eq(rejection(with_policy(duplicate)), "duplicate_committee_role")
    mut invalid = unwitnessed_package().policy
    invalid.required_roles = [CommitteeRoleId(SymbolicIdType(IdType(f"Role With Spaces")))]
    assert_eq(rejection(with_policy(invalid)), "invalid_committee_role")
    mut lenient = unwitnessed_package().policy
    lenient.require_all_passed = false
    assert_eq(rejection(with_policy(lenient)), "unsupported_committee_policy")
# Memory context handoff


const RETRIEVAL_FINGERPRINT: str = "1111111111111111111111111111111111111111111111111111111111111111"


def retrieval_binding() -> MemoryProviderBinding:
    """Return the provider binding the fictional retrieval declaration approves."""

    return MemoryProviderBinding(
        provider_id="lantern_retriever",
        provider_contract_version="0.1",
        adapter_version="1.0.0",
        configuration_fingerprint=f"{RETRIEVAL_FINGERPRINT}",
        index_fingerprint=f"{RETRIEVAL_FINGERPRINT}",
        corpus_fingerprint=f"{RETRIEVAL_FINGERPRINT}",
    )


def retrieval_atom(identifier: str) -> GovernedMemoryAtom:
    """Return an eligible retrieval atom whose identifier matches a profile memory atom."""

    return GovernedMemoryAtom(
        id=identifier,
        corpus_version="1.0",
        corpus_fingerprint=f"{RETRIEVAL_FINGERPRINT}",
        claim="A reviewed Lantern Path statement.",
        guidance="Use the reviewed Lantern Path statement.",
        applicability="Applies to Lantern Path questions.",
        source_ref="lantern-path/handbook",
        source_fingerprint=f"{RETRIEVAL_FINGERPRINT}",
        review_status=MemoryReviewStatus.Approved,
        runtime_rights=MemoryRuntimeRights.Allowed,
        authority_class_id="reviewed_lesson",
        risk_class_id="low",
        sensitivity_class_id="public",
        validity=MemoryValidity(mode=MemoryValidityMode.Indefinite, valid_from_ms=0, valid_until_ms=None),
        labels=[],
    )


def retrieval_package(package_name: str) -> AdmittedMemoryPackage:
    """Admit a retrieval declaration named ``package_name`` that covers the profile fixture's memory identifiers."""

    declaration = GovernedMemoryDeclaration(
        package_id=package_name,
        domain_id="fictional_lesson_support",
        package_revision="1.0",
        provider_bindings=[retrieval_binding()],
        authority_class_ids=["reviewed_lesson"],
        risk_class_ids=["low"],
        sensitivity_class_ids=["public"],
        atoms=[retrieval_atom("lantern_atom_card_order"), retrieval_atom("lantern_atom_pacing"), retrieval_atom(
            "lantern_atom_reflection",
        )],
    )
    return assert_is_ok(admit_memory_declaration(declaration))


def retrieval_record(package_name: str, state: str, reason: str, memory_ids: list[str]) -> MemoryAdmissionRecord:
    """Return the admission record for a provider result that nominates ``memory_ids``."""

    admitted = retrieval_package(package_name)
    identity = admitted.identity
    mut nominations: list[MemoryNomination] = []
    for index, memory_name in enumerate(memory_ids):
        nominations.append(MemoryNomination(memory_id=memory_name, rank=index, relevance_bps=9000))
    retrieval_request = MemoryRequest(
        contract_version="0.1",
        request_id="request_lantern",
        package_id=identity.package_id,
        domain_id=identity.domain_id,
        package_revision=identity.package_revision,
        package_semantic_identity=identity.package_semantic_identity.text(),
        package_admission_binding=identity.package_admission_binding.text(),
        query_text="Which card first?",
        evaluation_time_ms=1000,
    )
    result = MemoryProviderResult(
        contract_version="0.1",
        request_id="request_lantern",
        result_id="result_lantern",
        state=state,
        reason=reason,
        binding=retrieval_binding(),
        nominations=nominations,
    )
    return admit_memory_result(Some(admitted), retrieval_request, result)


def evaluate_in_context(record: MemoryAdmissionRecord) -> CompleteGovernedEvaluation:
    """Evaluate the two-atom answer proposal with a passing committee against ``record``."""

    package = lantern_package()
    bound = request("Which card first?")
    proposal = answer_proposal(package, bound)
    return evaluate_governed_profile_in_memory_context(
        package,
        bound,
        proposal,
        passed_committee(package, bound, proposal),
        record,
    )


def test_proposal_citing_only_accepted_context_memory_is_delivered() -> None:
    record = retrieval_record(
        "lantern_path_lessons",
        "complete",
        "completed",
        ["lantern_atom_pacing", "lantern_atom_card_order", "lantern_atom_reflection"],
    )
    assert_eq(record.reason, "accepted_complete")
    result = evaluate_in_context(record)
    assert_eq(result.spectrum.admitted, true)
    assert_eq(result.spectrum.decision, "deliver")
    assert_eq(len(result.selected_memory), 2)


def test_proposal_citing_memory_outside_the_accepted_context_is_rejected() -> None:
    record = retrieval_record("lantern_path_lessons", "complete", "completed", ["lantern_atom_card_order"])
    assert_rejected_with_receipt(evaluate_in_context(record), "memory_not_in_accepted_context")

    unavailable = retrieval_record("lantern_path_lessons", "unavailable", "index_unavailable", [])
    assert_eq(unavailable.reason, "accepted_unavailable")
    assert_rejected_with_receipt(evaluate_in_context(unavailable), "memory_not_in_accepted_context")


def test_rejected_retrieval_record_supplies_no_context() -> None:
    rejected = retrieval_record("lantern_path_lessons", "complete", "completed", ["lantern_atom_missing"])
    assert_eq(rejected.reason, "unknown_memory_id")
    assert_rejected_with_receipt(evaluate_in_context(rejected), "memory_context_not_accepted")

    without_package = retrieval_record("lantern_path_lessons", "degraded", "completed", [])
    assert_eq(without_package.reason, "unsupported_provider_state")
    assert_rejected_with_receipt(evaluate_in_context(without_package), "memory_context_not_accepted")


def test_context_for_another_package_is_rejected() -> None:
    record = retrieval_record(
        "other_lessons",
        "complete",
        "completed",
        ["lantern_atom_card_order", "lantern_atom_pacing"],
    )
    assert_eq(record.reason, "accepted_complete")
    assert_rejected_with_receipt(evaluate_in_context(record), "memory_context_package_mismatch")


def test_refusal_needs_no_memory_from_an_accepted_context() -> None:
    package = lantern_package()
    bound = request("Give me an apple pie recipe.")
    proposal = terminal_proposal(package, bound, "refuse_unsupported")
    unavailable = retrieval_record("lantern_path_lessons", "unavailable", "index_unavailable", [])
    result = evaluate_governed_profile_in_memory_context(package, bound, proposal, [], unavailable)
    assert_eq(result.spectrum.decision, "refuse")


def test_invalid_package_still_rejects_before_the_memory_context_rule() -> None:
    record = retrieval_record("lantern_path_lessons", "complete", "completed", ["lantern_atom_card_order"])
    mut package = lantern_package()
    package.mission = "A mutated mission."
    bound = request("Which card first?")
    proposal = answer_proposal(lantern_package(), bound)
    result = evaluate_governed_profile_in_memory_context(package, bound, proposal, [], record)
    assert_rejected_without_receipt(result, "invalid_package")


def library_package() -> GovernedProfilePackage:
    """Return the fictional package extended with ``LIBRARY_RECORDS`` evidence records and as many memory atoms."""

    mut library = unwitnessed_package()
    mut records = library.evidence.clone()
    for extra in extra_evidence("lantern_library_evidence", LIBRARY_RECORDS):
        records.append(extra)
    library.evidence = records
    mut atoms = library.memory.clone()
    for extra in extra_atoms("lantern_library_atom", LIBRARY_RECORDS):
        atoms.append(extra)
    library.memory = atoms
    return rewitnessed(library)


def test_admission_validates_the_package_and_exposes_its_verified_digest() -> None:
    package = lantern_package()
    admitted = assert_is_ok(admit_governed_profile_package(package.clone()))
    assert_eq(admitted.profile_package_digest, package.profile_package_digest)
    assert_eq(admitted.evidence_count, len(package.evidence))
    assert_eq(admitted.memory_count, len(package.memory))


def test_admission_rejects_what_package_validation_rejects() -> None:
    mut mutated = lantern_package()
    mutated.mission = "A mutated mission."
    match admit_governed_profile_package(mutated):
        Ok(_) => assert_eq("admitted", "rejected")
        Err(validation) =>
            assert_eq(validation.reason, "invalid_package")
            assert_eq(validation.errors[0], "profile_package_digest_mismatch")


def test_an_admitted_profile_gives_the_results_of_the_package_it_was_admitted_from() -> None:
    package = lantern_package()
    admitted = assert_is_ok(admit_governed_profile_package(package.clone()))
    bound = request("Which card first?")
    answer = answer_proposal(package, bound)
    committee = passed_committee(package, bound, answer)
    delivered = admitted.evaluate(bound, answer, committee.clone())
    assert_eq(delivered.spectrum.decision, "deliver")
    assert_eq(
        delivered.to_json(),
        evaluate_governed_profile_with_artifacts(package.clone(), bound, answer, committee).to_json(),
    )
    refusal_request = request("Give me an apple pie recipe.")
    refusal = terminal_proposal(package, refusal_request, "refuse_unsupported")
    refused = admitted.evaluate(refusal_request, refusal, [])
    assert_eq(refused.spectrum.decision, "refuse")
    assert_eq(
        refused.to_json(),
        evaluate_governed_profile_with_artifacts(package.clone(), refusal_request, refusal, []).to_json(),
    )
    mut unknown = answer_proposal(package, bound)
    unknown.evidence_ids = [evidence_id("lantern_unknown_evidence")]
    rejected = admitted.evaluate(bound, unknown, [])
    assert_eq(rejected.spectrum.decision, "reject")
    assert_eq(
        rejected.to_json(),
        evaluate_governed_profile_with_artifacts(package.clone(), bound, unknown, []).to_json(),
    )
    presentation = guide_proposal(package, bound, "present_guided_card", no_guided_step(), no_guided_step())
    guide_committee = passed_committee(package, bound, presentation)
    assert_eq(
        admitted.evaluate(bound, presentation, guide_committee.clone()).to_json(),
        evaluate_governed_profile_with_artifacts(package, bound, presentation, guide_committee).to_json(),
    )


def test_an_admitted_profile_applies_the_memory_context_rule() -> None:
    package = lantern_package()
    admitted = assert_is_ok(admit_governed_profile_package(package.clone()))
    bound = request("Which card first?")
    proposal = answer_proposal(package, bound)
    committee = passed_committee(package, bound, proposal)
    inside = retrieval_record(
        "lantern_path_lessons",
        "complete",
        "completed",
        ["lantern_atom_pacing", "lantern_atom_card_order", "lantern_atom_reflection"],
    )
    assert_eq(
        admitted.evaluate_in_memory_context(bound, proposal, committee.clone(), inside.clone()).to_json(),
        evaluate_governed_profile_in_memory_context(package.clone(), bound, proposal, committee.clone(), inside).to_json(),
    )
    outside = retrieval_record("lantern_path_lessons", "complete", "completed", ["lantern_atom_pacing"])
    rejected = admitted.evaluate_in_memory_context(bound, proposal, committee.clone(), outside.clone())
    assert_rejected_with_receipt(rejected, "memory_not_in_accepted_context")
    assert_eq(
        rejected.to_json(),
        evaluate_governed_profile_in_memory_context(package, bound, proposal, committee, outside).to_json(),
    )


def test_a_library_is_admitted_once_and_each_proposal_is_evaluated_against_it() -> None:
    package = library_package()
    admitted = assert_is_ok(admit_governed_profile_package(package.clone()))
    assert_eq(admitted.evidence_count, len(unwitnessed_package().evidence) + LIBRARY_RECORDS)
    assert_eq(admitted.memory_count, len(unwitnessed_package().memory) + LIBRARY_RECORDS)
    bound = request("Which card first?")
    proposal = answer_proposal(package, bound)
    committee = passed_committee(package, bound, proposal)
    for _round in range(25):
        assert_eq(admitted.evaluate(bound, proposal, committee.clone()).spectrum.decision, "deliver")
    delivered = admitted.evaluate(bound, proposal, committee.clone())
    assert_eq(
        delivered.to_json(),
        evaluate_governed_profile_with_artifacts(package, bound, proposal, committee).to_json(),
    )


def test_the_proposal_reference_limit_holds_for_an_admitted_profile() -> None:
    package = lantern_package()
    admitted = assert_is_ok(admit_governed_profile_package(package.clone()))
    bound = request("Which card first?")
    mut over = answer_proposal(package, bound)
    over.evidence_ids = [evidence_id("lantern_evidence_card_order") for _index in range(MAX_PROPOSAL_EVIDENCE + 1)]
    assert_rejected_without_receipt(admitted.evaluate(bound, over, []), "proposal_reference_limit_exceeded")


def test_an_admitted_profile_binds_proposals_and_observations_like_the_package_does() -> None:
    package = lantern_package()
    admitted = assert_is_ok(admit_governed_profile_package(package.clone()))
    bound = request("Which card first?")
    from_package = answer_proposal(package, bound)
    from_admitted = admitted.propose(
        bound,
        from_package.proposal_id,
        from_package.action_id,
        from_package.visible_output,
        from_package.evidence_ids,
        from_package.memory_ids,
        no_guided_material(),
        no_guided_step(),
        no_guided_step(),
    )
    assert_eq(from_admitted.to_json(), from_package.to_json())
    role = required_role_names()[0]
    observed = observation(package, bound, from_package, role, CommitteeVerdict.Pass)
    rebound = admitted.observe(
        bound,
        from_admitted,
        observed.observation_id,
        observed.role,
        CommitteeVerdict.Pass,
        observed.evaluator_fingerprint,
    )
    assert_eq(rebound.to_json(), observed.to_json())


def test_memory_provenance_from_the_identity_fields_equals_provenance_from_the_package() -> None:
    package = lantern_package()
    for atom in package.memory:
        assert_eq(
            digest_governed_memory_provenance_for(
                package.package_id,
                package.domain_id,
                package.package_revision,
                package.profile_package_digest,
                atom.clone(),
            ),
            digest_governed_memory_provenance(package.clone(), atom),
        )
