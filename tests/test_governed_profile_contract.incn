        package,
        bound,
        "present_guided_card",
        Some(guided_step_id("choose_starting_card")),
        no_guided_step(),
    )
    assert_eq(proposal_error(package, bound, presenting_with_step), "unexpected_guided_transition")
    without_current = guide_proposal(
        package,
        bound,
        "navigate_guided_card",
        no_guided_step(),
        Some(guided_step_id("choose_pacing")),
    )
    assert_eq(proposal_error(package, bound, without_current), "current_step_required")
    without_next = guide_proposal(
        package,
        bound,
        "navigate_guided_card",
        Some(guided_step_id("choose_starting_card")),
        no_guided_step(),
    )
    assert_eq(proposal_error(package, bound, without_next), "next_step_required")
    undeclared = guide_proposal(
        package,
        bound,
        "navigate_guided_card",
        Some(guided_step_id("choose_starting_card")),
        Some(guided_step_id("choose_reflection")),
    )
    assert_eq(proposal_error(package, bound, undeclared), "transition_not_declared")
    assert_rejected_with_receipt(
        evaluate_governed_profile_with_artifacts(package, bound, undeclared, []),
        "invalid_guided_transition",
    )


