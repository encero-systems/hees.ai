const PACKAGE_DIGEST: str = "sha256:aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa"
const SOURCE_DIGEST: str = "sha256:bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb"
const PROVENANCE_DIGEST: str = "sha256:cccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccccc"
const CARD_DIGEST: str = "sha256:dddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddddd"
const EVALUATOR_DIGEST: str = "sha256:eeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeeee"
const OTHER_DIGEST: str = "sha256:ffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffffff"
const GUIDE_ID: str = "lantern_guide_practice_0_1"
# Extra records for a package far larger than any per-proposal bound; a library is not bounded by a number.
const LIBRARY_RECORDS: int = 2000
const AUDIENCE: str = "general_audience"
const HASHED_DECISION_ID_LENGTH: int = 73
const REFUSAL_TEXT: str = "The reviewed Lantern Path package does not cover that request."
const ESCALATION_TEXT: str = "That request needs a person; the Lantern Path package cannot answer it."


def repeated(text: str, count: int) -> str:
    """Return ``text`` repeated ``count`` times."""

    mut result = ""
    for _index in range(count):
        result = result + text
    return result


def no_guided_material() -> Option[GuidedMaterialId]:
    """Return a typed absent guided material nomination."""

    return None


def no_guided_step() -> Option[GuidedStepId]:
    """Return a typed absent guided step nomination."""

    return None


def no_boundary_text() -> Option[str]:
    """Return a typed absent boundary text."""

    return None


def boundary_text_for(kind: GovernedOutcomeKind) -> Option[str]:
    """Return the fixture's package-declared text for a refusal or escalation kind, and none for any other kind."""

    if kind == GovernedOutcomeKind.Refusal:
        return Some(REFUSAL_TEXT)
    if kind == GovernedOutcomeKind.Escalation:
        return Some(ESCALATION_TEXT)
    return no_boundary_text()


def action(id: str, kind: GovernedOutcomeKind, evidence_required: bool, committee_required: bool) -> GovernedAction:
    """Build one package action, declaring the fixture boundary text exactly when ``kind`` refuses or escalates."""

    return GovernedAction(
        action_id=action_id(id),
        outcome_kind=kind,
        evidence_required=evidence_required,
        committee_required=committee_required,
        boundary_text=boundary_text_for(kind),
    )


def evidence(id: str, source_ref: str) -> GovernedEvidence:
    """Build one approved, rights-allowed fictional evidence record."""

    return GovernedEvidence(
        evidence_id=evidence_id(id),
        claim=f"Reviewed fictional claim for {id}.",
        guidance=f"Reviewed fictional guidance for {id}.",
        source_ref=source_ref,
        source_kind="fictional_handbook",
        source_fingerprint=digest_id_type(SOURCE_DIGEST),
        language="en",
        review_state="approved",
        review_revision=revision("1.0.0"),
        rights_state="allowed",
        authority_class="reviewed_package",
        evidence_kind="bounded_paraphrase",
    )


def memory_atom(id: str, evidence_values: list[str]) -> GovernedMemory:
    """Build one approved memory atom with a placeholder provenance digest that ``rewitnessed`` replaces."""

    return GovernedMemory(
        memory_id=memory_id(id),
        concept=f"Reviewed fictional concept for {id}.",
        evidence_ids=[evidence_id(value) for value in evidence_values],
        review_state="approved",
        review_revision=revision("1.0.0"),
        rights_state="allowed",
        provenance_digest=digest_id_type(PROVENANCE_DIGEST),
    )


def full_evidence_ids() -> list[EvidenceId]:
    """Return every base evidence identifier in package order."""

    return [evidence_id("lantern_evidence_card_order"), evidence_id("lantern_evidence_pacing"), evidence_id(
        "lantern_evidence_reflection",
    )]


def full_memory_ids() -> list[MemoryId]:
    """Return every base memory identifier in package order."""

    return [memory_id("lantern_atom_card_order"), memory_id("lantern_atom_pacing"), memory_id("lantern_atom_reflection")]


def guide() -> GuidedMaterial:
    """Build the fictional practice guide over all three base memory atoms."""

    return GuidedMaterial(
        guided_material_id=guided_material_id(GUIDE_ID),
        artifact_revision=artifact_revision("0.1.0"),
        artifact_digest=digest_id_type(CARD_DIGEST),
        language="en",
        audience=audience_id(AUDIENCE),
        evidence_ids=full_evidence_ids(),
        memory_ids=full_memory_ids(),
        presentation_action_id=action_id("present_guided_card"),
        navigation_action_id=action_id("navigate_guided_card"),
        steps=[guided_step_id("choose_starting_card"), guided_step_id("choose_pacing"), guided_step_id(
            "choose_reflection",
        )],
        transitions=[GuidedTransition(
            current_step_id=guided_step_id("choose_starting_card"),
            next_step_id=guided_step_id("choose_pacing"),
        ), GuidedTransition(
            current_step_id=guided_step_id("choose_pacing"),
            next_step_id=guided_step_id("choose_reflection"),
        )],
        review_state="approved",
        review_revision=revision("1.0.0"),
        rights_state="allowed",
    )


def required_role_names() -> list[str]:
    """Return the fixture's six package-wide committee roles."""

    return ["evidence_support", "scope", "safety_boundary", "question_fit", "language_clarity", "contextual_tone"]


def unwitnessed_package() -> GovernedProfilePackage:
    """Build the fictional package with placeholder package and provenance digests."""

    return GovernedProfilePackage(
        contract_version=contract_id("governed_profile_package_0_1"),
        profile_id=profile_id("governed_profile_0_1"),
        package_id=package_id("lantern_path_lessons"),
        domain_id=domain_id("fictional_lesson_support"),
        package_revision=artifact_revision("0.1.0-candidate.1"),
        profile_package_digest=digest_id_type(PACKAGE_DIGEST),
        mission="Provide bounded lesson support for the fictional Lantern Path cards from reviewed package material.",
        actions=[action("answer_from_package", GovernedOutcomeKind.Answer, true, true), action(
            "present_guided_card",
            GovernedOutcomeKind.GuidedMaterial,
            true,
            true,
        ), action("navigate_guided_card", GovernedOutcomeKind.GuidedNavigation, true, true), action(
            "refuse_unsupported",
            GovernedOutcomeKind.Refusal,
            false,
            false,
        ), action("escalate_out_of_scope", GovernedOutcomeKind.Escalation, false, false)],
        evidence=[evidence("lantern_evidence_card_order", "fictional_lantern_handbook:1-2"), evidence(
            "lantern_evidence_pacing",
            "fictional_lantern_handbook:3-4",
        ), evidence("lantern_evidence_reflection", "fictional_lantern_workbook:5-6")],
        memory=[memory_atom("lantern_atom_card_order", ["lantern_evidence_card_order"]), memory_atom(
            "lantern_atom_pacing",
            ["lantern_evidence_pacing"],
        ), memory_atom("lantern_atom_reflection", ["lantern_evidence_reflection"])],
        guided_material=[guide()],
        policy=GovernedPolicy(
            constraint_plan_id=constraint_plan_id("lantern_committee_policy"),
            constraint_plan_revision=revision("1.0.0"),
            required_roles=[committee_role_id(role) for role in required_role_names()],
            require_all_passed=true,
        ),
    )


def with_package_digest(unwitnessed: GovernedProfilePackage) -> GovernedProfilePackage:
    """Restamp only the package digest, leaving each memory atom's provenance digest as given."""

    mut package = unwitnessed.clone()
    package.profile_package_digest = digest_governed_profile_package(unwitnessed)
    return package


def rewitnessed(unwitnessed: GovernedProfilePackage) -> GovernedProfilePackage:
    """
    Restamp the package digest, then every memory provenance digest against the restamped package.

    Negative tests mutate a valid package and call this so the mutation reaches its target check instead of being
    rejected earlier as ``profile_package_digest_mismatch`` or ``memory_provenance_mismatch``.
    """

    mut package = with_package_digest(unwitnessed)
    mut witnessed_atoms: list[GovernedMemory] = []
    for atom in package.memory:
        mut witnessed_atom = atom.clone()
        witnessed_atom.provenance_digest = digest_governed_memory_provenance(package, atom)
        witnessed_atoms.append(witnessed_atom)
    package.memory = witnessed_atoms
    return package


def lantern_package() -> GovernedProfilePackage:
    """Return the valid, fully witnessed fictional package."""

    return rewitnessed(unwitnessed_package())


def rejection(package: GovernedProfilePackage) -> str:
    """Rewitness a mutated package, assert it is rejected as ``invalid_package``, and return its diagnostic."""

    result = validate_governed_profile_package(rewitnessed(package))
    assert_eq(result.reason, "invalid_package")
    return result.errors[0]


def acceptance(package: GovernedProfilePackage) -> str:
    """Rewitness a mutated package and return its validation reason, ``ok`` when valid."""

    return validate_governed_profile_package(rewitnessed(package)).reason


def extra_evidence(prefix: str, count: int) -> list[GovernedEvidence]:
    """Build ``count`` additional fictional evidence records."""

    return [evidence(f"{prefix}_{index}", f"fictional_lantern_appendix:{index}") for index in range(count)]


def extra_atoms(prefix: str, count: int) -> list[GovernedMemory]:
    """Build ``count`` additional memory atoms that each cite the first base evidence record."""

    return [memory_atom(f"{prefix}_{index}", ["lantern_evidence_card_order"]) for index in range(count)]


def first_evidence() -> GovernedEvidence:
    """Return a copy of the first base evidence record for mutation."""

    return unwitnessed_package().evidence[0]


def with_first_evidence(record: GovernedEvidence) -> GovernedProfilePackage:
    """Return the base package with its first evidence record replaced."""

    mut package = unwitnessed_package()
    package.evidence[0] = record
    return package


def first_atom() -> GovernedMemory:
    """Return a copy of the first base memory atom for mutation."""

    return unwitnessed_package().memory[0]


def with_first_atom(atom: GovernedMemory) -> GovernedProfilePackage:
    """Return the base package with its first memory atom replaced."""

    mut package = unwitnessed_package()
    package.memory[0] = atom
    return package


def with_guide(material: GuidedMaterial) -> GovernedProfilePackage:
    """Return the base package with its only guided material replaced."""

    mut package = unwitnessed_package()
    package.guided_material = [material]
    return package


def with_policy(policy: GovernedPolicy) -> GovernedProfilePackage:
    """Return the base package with its committee policy replaced."""

    mut package = unwitnessed_package()
    package.policy = policy
    return package


def request(question: str) -> GovernedRequest:
    """Bind one fictional request in English for the fixture audience."""

    return bind_governed_request(request_id("request_lantern"), question, "en", audience_id(AUDIENCE))


def proposal_for(
    package: GovernedProfilePackage,
    bound: GovernedRequest,
    action_name: str,
    evidence_ids: list[EvidenceId],
    memory_ids: list[MemoryId],
    guided: Option[GuidedMaterialId],
    current: Option[GuidedStepId],
    next: Option[GuidedStepId],
) -> GovernedProposal:
    """Build one proposal with a fixed identifier and visible output for the named action."""

    return governed_proposal(
        package,
        bound,
        proposal_id(f"proposal_{action_name}"),
        action_id(action_name),
        "A bounded fictional answer drawn from the reviewed package.",
        evidence_ids,
        memory_ids,
        guided,
        current,
        next,
    )


def answer_proposal(package: GovernedProfilePackage, bound: GovernedRequest) -> GovernedProposal:
    """Build the supported two-atom answer proposal."""

    return governed_proposal(
        package,
        bound,
        proposal_id("proposal_lantern_answer"),
        action_id("answer_from_package"),
        "Start with the first Lantern Path card and keep a steady pace, as the reviewed handbook suggests.",
        [evidence_id("lantern_evidence_card_order"), evidence_id("lantern_evidence_pacing")],
        [memory_id("lantern_atom_card_order"), memory_id("lantern_atom_pacing")],
        no_guided_material(),
        no_guided_step(),
        no_guided_step(),
    )


def guide_proposal(
    package: GovernedProfilePackage,
    bound: GovernedRequest,
    action_name: str,
    current: Option[GuidedStepId],
    next: Option[GuidedStepId],
) -> GovernedProposal:
    """Build a guided proposal over the full guide support for the named action."""

    return proposal_for(
        package,
        bound,
        action_name,
        full_evidence_ids(),
        full_memory_ids(),
        Some(guided_material_id(GUIDE_ID)),
        current,
        next,
    )


def terminal_proposal(package: GovernedProfilePackage, bound: GovernedRequest, action_name: str) -> GovernedProposal:
    """Build an unsupported refusal or escalation proposal with no visible output of its own."""

    return governed_proposal(
        package,
        bound,
        proposal_id(f"proposal_{action_name}"),
        action_id(action_name),
        "",
        [],
        [],
        no_guided_material(),
        no_guided_step(),
        no_guided_step(),
    )


def observation(
    package: GovernedProfilePackage,
    bound: GovernedRequest,
    proposal: GovernedProposal,
    role: str,
    verdict: CommitteeVerdict,
) -> CommitteeObservation:
    """Build one observation for ``role`` bound to the exact candidate."""

    return committee_observation(
        package,
        bound,
        proposal,
        observation_id(f"observation_{role}"),
        committee_role_id(role),
        verdict,
        digest_id_type(EVALUATOR_DIGEST),
    )


def passed_committee(
    package: GovernedProfilePackage,
    bound: GovernedRequest,
    proposal: GovernedProposal,
) -> list[CommitteeObservation]:
    """Build one passing observation for every required role."""

    return [observation(package, bound, proposal, role, CommitteeVerdict.Pass) for role in required_role_names()]


def evaluate_with_committee(
    package: GovernedProfilePackage,
    bound: GovernedRequest,
    proposal: GovernedProposal,
) -> CompleteGovernedEvaluation:
    """Evaluate a proposal with a full passing committee."""

    return evaluate_governed_profile_with_artifacts(package, bound, proposal, passed_committee(package, bound, proposal))


def proposal_error(package: GovernedProfilePackage, bound: GovernedRequest, proposal: GovernedProposal) -> str:
    """Return the specific diagnostic ``validate_governed_proposal`` reports."""

    return validate_governed_proposal(package, bound, proposal).errors[0]


def assert_rejected_without_receipt(result: CompleteGovernedEvaluation, reason: str) -> None:
    """Assert a rejection that happened before proposal identity was established."""

    assert_eq(result.spectrum.admitted, false)
    assert_eq(result.spectrum.decision, "reject")
    assert_eq(result.spectrum.reason, reason)
    assert_is_none(result.admitted_visible_output)
    assert_is_none(result.content_dna_json)
    assert_is_none(result.receipt_json)


def assert_rejected_with_receipt(result: CompleteGovernedEvaluation, reason: str) -> None:
    """Assert a rejection recorded in a receipt with no deliverable projection."""

    assert_eq(result.spectrum.admitted, false)
    assert_eq(result.spectrum.decision, "reject")
    assert_eq(result.spectrum.reason, reason)
    assert_is_none(result.admitted_visible_output)
    assert_is_none(result.admitted_guided_material)
    assert_eq(len(result.selected_memory), 0)
    assert_is_none(result.content_dna_json)
    assert_is_some(result.receipt_json)


def test_supported_answer_binds_committee_memory_content_dna_and_receipt() -> None:
    package = lantern_package()
    bound = request("Which Lantern Path card should I start with, and how fast should I go?")
    proposal = answer_proposal(package, bound)
    result = evaluate_with_committee(package, bound, proposal)
    assert_eq(result.spectrum.admitted, true)
    assert_eq(result.spectrum.decision, "deliver")
    assert_eq(result.spectrum.reason, "supported_by_package")
    assert_eq(result.spectrum.reason_namespace, "governed_profile_admission_0_1")
    assert_eq(result.spectrum.decision_id.text(), "decision_lantern_answer")
    assert_eq(len(result.findings), 6)
    assert_eq(result.findings[0].classification, CommitteeVerdict.Pass)
    assert_eq(len(result.selected_memory), 2)
    assert_eq(result.admitted_visible_output, Some(proposal.visible_output))
    assert_is_none(result.admitted_guided_material)
    content_dna = assert_is_ok(GovernedContentDna.from_json(assert_is_some(result.content_dna_json)))
    receipt = assert_is_ok(GovernedReceipt.from_json(assert_is_some(result.receipt_json)))
    assert_eq(content_dna.body.state, "admitted_delivery")
    assert_eq(len(content_dna.body.entries), 2)
    assert_eq(content_dna.body.entries[0].memory_id.text(), "lantern_atom_card_order")
    assert_eq(content_dna.body.entries[1].memory_id.text(), "lantern_atom_pacing")
    assert_eq(receipt.body.content_dna_id, Some(content_dna.content_dna_id))
    assert_eq(receipt.body.decision, "deliver")


def test_guided_material_is_admitted_only_as_an_exact_package_owned_identity() -> None:
    package = lantern_package()
    bound = request("Help me practice the Lantern Path cards.")
    proposal = guide_proposal(package, bound, "present_guided_card", no_guided_step(), no_guided_step())
    result = evaluate_with_committee(package, bound, proposal)
    admitted = assert_is_some(result.admitted_guided_material)
    assert_eq(result.spectrum.decision, "deliver")
    assert_eq(result.spectrum.reason, "supported_by_package")
    assert_eq(admitted.guided_material_id.text(), GUIDE_ID)
    assert_eq(admitted.artifact_revision, artifact_revision("0.1.0"))
    assert_eq(admitted.artifact_digest, digest_id_type(CARD_DIGEST))
    assert_eq(assert_is_some(result.content_dna_json).contains(GUIDE_ID), true)
    assert_eq(assert_is_some(result.receipt_json).contains(GUIDE_ID), true)


def test_declared_guided_navigation_is_admitted() -> None:
    package = lantern_package()
    bound = request("Take me to the next practice step.")
    proposal = guide_proposal(
        package,
        bound,
        "navigate_guided_card",
        Some(guided_step_id("choose_starting_card")),
        Some(guided_step_id("choose_pacing")),
    )
    result = evaluate_with_committee(package, bound, proposal)
    assert_eq(result.spectrum.admitted, true)
    assert_eq(result.spectrum.decision, "deliver")
    assert_eq(result.spectrum.reason, "supported_by_package")
    admitted = assert_is_some(result.admitted_guided_material)
    assert_eq(admitted.guided_material_id.text(), GUIDE_ID)
    assert_is_some(result.content_dna_json)
    assert_is_some(result.receipt_json)


def test_package_declared_refusal_and_escalation_are_safe_terminal_outcomes() -> None:
    package = lantern_package()
    bound = request("Give me an apple pie recipe.")
    refused = evaluate_governed_profile_with_artifacts(
        package,
        bound,
        terminal_proposal(package, bound, "refuse_unsupported"),
        [],
    )
    assert_eq(refused.spectrum.admitted, true)
    assert_eq(refused.spectrum.decision, "refuse")
    assert_eq(refused.spectrum.reason, "unsupported_by_package")
    assert_eq(refused.admitted_visible_output, Some(REFUSAL_TEXT))
    assert_eq(len(refused.selected_memory), 0)
    assert_is_none(refused.content_dna_json)
    assert_is_some(refused.receipt_json)

    escalated = evaluate_governed_profile_with_artifacts(
        package,
        bound,
        terminal_proposal(package, bound, "escalate_out_of_scope"),
        [],
    )
    assert_eq(escalated.spectrum.admitted, true)
    assert_eq(escalated.spectrum.decision, "escalate")
    assert_eq(escalated.spectrum.reason, "escalation_declared_by_package")
    assert_eq(escalated.admitted_visible_output, Some(ESCALATION_TEXT))
    assert_eq(len(escalated.selected_memory), 0)
    assert_is_none(escalated.content_dna_json)
    assert_is_some(escalated.receipt_json)


def assert_boundary_receipt(action_name: str, text: str) -> None:
    """Assert an admitted boundary outcome delivers ``text`` and its receipt names the package as the source."""

    package = lantern_package()
    bound = request("Give me an apple pie recipe.")
    result = evaluate_governed_profile_with_artifacts(package, bound, terminal_proposal(package, bound, action_name), [])
    assert_eq(result.admitted_visible_output, Some(text))
    receipt_json = assert_is_some(result.receipt_json)
    receipt = assert_is_ok(GovernedReceipt.from_json(receipt_json))
    assert_eq(receipt.body.visible_output_source, Some(GovernedVisibleOutputSource.PackageBoundaryText))
    assert_eq(receipt.body.visible_output_digest, Some(digest_governed_answer(text)))
    assert_eq(receipt_json.contains("package_boundary_text"), true)


def test_boundary_receipt_records_the_package_text_it_delivered() -> None:
    assert_boundary_receipt("refuse_unsupported", REFUSAL_TEXT)
    assert_boundary_receipt("escalate_out_of_scope", ESCALATION_TEXT)


def test_deliver_receipt_records_the_admitted_proposal_text() -> None:
    package = lantern_package()
    bound = request("Which card first?")
    proposal = answer_proposal(package, bound)
    result = evaluate_with_committee(package, bound, proposal)
    receipt = assert_is_ok(GovernedReceipt.from_json(assert_is_some(result.receipt_json)))
    content_dna = assert_is_ok(GovernedContentDna.from_json(assert_is_some(result.content_dna_json)))
    assert_eq(receipt.body.visible_output_source, Some(GovernedVisibleOutputSource.AdmittedProposal))
    assert_eq(receipt.body.visible_output_digest, Some(digest_governed_answer(proposal.visible_output)))
    assert_eq(content_dna.body.answer_digest, digest_governed_answer(proposal.visible_output))


def test_rejected_receipt_records_no_visible_output() -> None:
    package = lantern_package()
    bound = request("Which card first?")
    result = evaluate_governed_profile_with_artifacts(package, bound, answer_proposal(package, bound), [])
    assert_eq(result.spectrum.admitted, false)
    receipt = assert_is_ok(GovernedReceipt.from_json(assert_is_some(result.receipt_json)))
    assert_is_none(receipt.body.visible_output_source)
    assert_is_none(receipt.body.visible_output_digest)


def test_boundary_proposal_with_model_prose_is_rejected_with_receipt() -> None:
    package = lantern_package()
    bound = request("Give me an apple pie recipe.")
    for action_name in ["refuse_unsupported", "escalate_out_of_scope"]:
        mut prose = terminal_proposal(package, bound, action_name)
        prose.visible_output = f"Here is an apple pie recipe the package never reviewed."
        result = evaluate_governed_profile_with_artifacts(package, bound, prose, [])
        assert_rejected_with_receipt(result, "boundary_output_not_allowed")
        assert_eq(assert_is_some(result.receipt_json).contains("apple pie"), false)
        mut blank = terminal_proposal(package, bound, action_name)
        blank.visible_output = f"   "
        assert_rejected_with_receipt(
            evaluate_governed_profile_with_artifacts(package, bound, blank, []),
            "boundary_output_not_allowed",
        )


def test_boundary_text_is_required_exactly_for_refusal_and_escalation() -> None:
    for index in [3, 4]:
        mut missing = unwitnessed_package()
        mut boundary = missing.actions[index]
        boundary.boundary_text = no_boundary_text()
        missing.actions[index] = boundary
        assert_eq(rejection(missing), "boundary_text_missing")
        mut blank = unwitnessed_package()
        mut blank_action = blank.actions[index]
        blank_action.boundary_text = Some(f"   ")
        blank.actions[index] = blank_action
        assert_eq(rejection(blank), "boundary_text_invalid")
        mut at_limit = unwitnessed_package()
        mut limit_action = at_limit.actions[index]
        limit_action.boundary_text = Some(repeated("b", MAX_VISIBLE_OUTPUT_LENGTH))
        at_limit.actions[index] = limit_action
        assert_eq(acceptance(at_limit), "ok")
        mut over = unwitnessed_package()
        mut over_action = over.actions[index]
        over_action.boundary_text = Some(repeated("b", MAX_VISIBLE_OUTPUT_LENGTH + 1))
        over.actions[index] = over_action
        assert_eq(rejection(over), "boundary_text_invalid")
    for index in [0, 1, 2]:
        mut deliverable = unwitnessed_package()
        mut deliverable_action = deliverable.actions[index]
        deliverable_action.boundary_text = Some(REFUSAL_TEXT)
        deliverable.actions[index] = deliverable_action
        assert_eq(rejection(deliverable), "boundary_text_not_allowed")


def test_boundary_text_is_covered_by_the_package_digest() -> None:
    mut mutated = lantern_package()
    mut refusal = mutated.actions[3]
    refusal.boundary_text = Some(f"A different refusal the package never reviewed.")
    mutated.actions[3] = refusal
    result = validate_governed_profile_package(mutated)
    assert_eq(result.reason, "invalid_package")
    assert_eq(result.errors[0], "profile_package_digest_mismatch")


def test_identity_digests_hash_a_distinct_type_tag() -> None:
    tags = [GOVERNED_PACKAGE_TYPE_TAG, GOVERNED_MEMORY_PROVENANCE_TYPE_TAG, GOVERNED_REQUEST_TYPE_TAG, GOVERNED_PROPOSAL_TYPE_TAG, GOVERNED_ANSWER_TYPE_TAG, GOVERNED_CONTENT_DNA_TYPE_TAG, GOVERNED_RECEIPT_TYPE_TAG]
    shared_json = GovernedAnswerProjection(visible_output="Identical projection text.").to_json()
    mut seen: list[DigestIdType] = []
    for tag in tags:
        assert_eq(tag.startswith("hees.ai/"), true)
        assert_eq(tag.endswith("/v0"), true)
        digest = assert_is_ok(digest_tagged_json(tag, shared_json))
        assert_eq(seen.contains(digest), false)
        seen.append(digest)
    assert_eq(seen.contains(assert_is_ok(digest_canonical_json(shared_json))), false)
    assert_eq(digest_governed_answer("Identical projection text."), seen[4])


def test_request_proposal_and_artifact_identities_use_their_own_type_tags() -> None:
    package = lantern_package()
    bound = request("Which card first?")
    proposal = answer_proposal(package, bound)
    request_json = GovernedRequestDigestProjection(
        request_id=bound.request_id,
        question=bound.question,
        language=bound.language,
        audience=bound.audience,
    ).to_json()
    assert_eq(bound.request_digest, assert_is_ok(digest_tagged_json(GOVERNED_REQUEST_TYPE_TAG, request_json)))
    assert_eq(
        digest_governed_proposal(proposal),
        assert_is_ok(digest_tagged_json(GOVERNED_PROPOSAL_TYPE_TAG, proposal.to_json())),
    )
    result = evaluate_with_committee(package, bound, proposal)
    content_dna = assert_is_ok(GovernedContentDna.from_json(assert_is_some(result.content_dna_json)))
    receipt = assert_is_ok(GovernedReceipt.from_json(assert_is_some(result.receipt_json)))
    assert_eq(
        content_dna.content_dna_id,
        ContentDnaId(assert_is_ok(digest_tagged_json(GOVERNED_CONTENT_DNA_TYPE_TAG, content_dna.body.to_json()))),
    )
    assert_eq(
        receipt.receipt_id,
        ReceiptId(assert_is_ok(digest_tagged_json(GOVERNED_RECEIPT_TYPE_TAG, receipt.body.to_json()))),
    )


