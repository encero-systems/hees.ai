def test_long_observation_ids_derive_bounded_finding_ids() -> None:
    package = lantern_package()
    bound = request("Which card first?")
    proposal = answer_proposal(package, bound)
    mut observations: list[CommitteeObservation] = []
    for role in required_role_names():
        padding = repeated("z", 128 - len(role))
        observations.append(
            committee_observation(
                package,
                bound,
                proposal,
                observation_id(f"{role}{padding}"),
                committee_role_id(role),
                CommitteeVerdict.Pass,
                digest_id_type(EVALUATOR_DIGEST),
            ),
        )
    result = evaluate_governed_profile_with_artifacts(package, bound, proposal, observations)
    assert_eq(result.spectrum.decision, "deliver")
    for finding in result.findings:
        finding_text = finding.finding_id.text()
        assert_eq(finding_text.startswith("finding_"), true)
        assert_eq(len(finding_text) <= 128, true)


def test_non_canonical_observation_fields_are_rejected() -> None:
    package = lantern_package()
