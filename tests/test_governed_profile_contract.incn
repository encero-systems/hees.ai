def test_observations_bound_to_another_identity_are_rejected() -> None:
    package = lantern_package()
    bound = request("Which card first?")
    proposal = answer_proposal(package, bound)
    mut other_candidate = proposal.clone()
    other_candidate.visible_output = f"A different candidate answer."
    assert_rejected_with_receipt(
        evaluate_governed_profile_with_artifacts(
            package,
            bound,
            proposal,
            passed_committee(package, bound, other_candidate),
        ),
        "committee_identity_mismatch",
    )
    other_request = request("A different question.")
    assert_rejected_with_receipt(
        evaluate_governed_profile_with_artifacts(
            package,
            bound,
            proposal,
            passed_committee(package, other_request, proposal),
        ),
        "committee_identity_mismatch",
    )
    mut foreign_package = passed_committee(package, bound, proposal)
    mut first = foreign_package[0]
    first.package_id = package_id("other_package")
    foreign_package[0] = first
    assert_rejected_with_receipt(
        evaluate_governed_profile_with_artifacts(package, bound, proposal, foreign_package),
        "committee_identity_mismatch",
    )
    mut stale_digest = passed_committee(package, bound, proposal)
    mut second = stale_digest[1]
    second.profile_package_digest = digest_id_type(OTHER_DIGEST)
    stale_digest[1] = second
    assert_rejected_with_receipt(
        evaluate_governed_profile_with_artifacts(package, bound, proposal, stale_digest),
        "committee_identity_mismatch",
    )
    mut other_profile = passed_committee(package, bound, proposal)
    mut third = other_profile[2]
    third.profile_id = profile_id("other_profile_0_1")
    other_profile[2] = third
    assert_rejected_with_receipt(
        evaluate_governed_profile_with_artifacts(package, bound, proposal, other_profile),
        "committee_identity_mismatch",
    )


