def test_guided_evidence_count_boundary() -> None:
    atom_count = MAX_GUIDED_MEMORY
    assert_eq(2 * atom_count, MAX_GUIDED_EVIDENCE)
    mut package = unwitnessed_package()
    mut records = package.evidence.clone()
    for extra in extra_evidence("lantern_pair_source", MAX_GUIDED_EVIDENCE):
        records.append(extra)
    package.evidence = records
    mut atoms = package.memory.clone()
    mut guide_memory: list[MemoryId] = []
    mut guide_evidence: list[EvidenceId] = []
    for index in range(atom_count):
        first_source = f"lantern_pair_source_{2 * index}"
        second_source = f"lantern_pair_source_{2 * index + 1}"
        atoms.append(memory_atom(f"lantern_pair_atom_{index}", [first_source, second_source]))
        guide_memory.append(memory_id(f"lantern_pair_atom_{index}"))
        guide_evidence.append(evidence_id(first_source))
        guide_evidence.append(evidence_id(second_source))
    package.memory = atoms
    mut material = guide()
    material.memory_ids = guide_memory
    material.evidence_ids = guide_evidence.clone()
    package.guided_material = [material.clone()]
    assert_eq(acceptance(package), "ok")
    guide_evidence.append(evidence_id("lantern_evidence_card_order"))
    mut over = guide()
    over.evidence_ids = guide_evidence
    assert_eq(rejection(with_guide(over)), "invalid_guided_evidence_count")
    mut empty = guide()
    empty.evidence_ids = []
    assert_eq(rejection(with_guide(empty)), "invalid_guided_evidence_count")


def test_guided_step_and_transition_boundaries() -> None:
    mut at_limit = guide()
    at_limit.steps = step_ids(MAX_GUIDED_STEPS)
    at_limit.transitions = every_transition(step_ids(MAX_GUIDED_STEPS))
    assert_eq(len(at_limit.transitions), MAX_GUIDED_TRANSITIONS)
    assert_eq(acceptance(with_guide(at_limit.clone())), "ok")
    mut too_many_steps = guide()
    too_many_steps.steps = step_ids(MAX_GUIDED_STEPS + 1)
    too_many_steps.transitions = []
    assert_eq(rejection(with_guide(too_many_steps)), "invalid_guided_steps")
    mut no_steps = guide()
    no_steps.steps = []
    no_steps.transitions = []
    assert_eq(rejection(with_guide(no_steps)), "invalid_guided_steps")
    mut too_many_transitions = at_limit.clone()
    mut transitions = at_limit.transitions.clone()
    transitions.append(at_limit.transitions[0].clone())
    too_many_transitions.transitions = transitions
    assert_eq(rejection(with_guide(too_many_transitions)), "invalid_guided_transition_count")


