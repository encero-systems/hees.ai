def step_ids(count: int) -> list[GuidedStepId]:
    """Build ``count`` distinct guided step identifiers."""

    return [guided_step_id(f"step_{index}") for index in range(count)]


def every_transition(steps: list[GuidedStepId]) -> list[GuidedTransition]:
    """Build every distinct non-self transition between the given steps."""

    mut result: list[GuidedTransition] = []
    for current in steps:
        for next in steps:
            if current != next:
                result.append(GuidedTransition(current_step_id=current, next_step_id=next))
    return result


def refusal_actions(count: int) -> list[GovernedAction]:
    """Build ``count`` additional refusal actions."""

    return [action(f"refuse_extra_{index}", GovernedOutcomeKind.Refusal, false, false) for index in range(count)]


def test_package_header_is_validated() -> None:
    mut contract = unwitnessed_package()
    contract.contract_version = contract_id("other_package_contract_0_1")
    assert_eq(rejection(contract), "unsupported_package_contract")
    mut profile = unwitnessed_package()
    profile.profile_id = profile_id("other_profile_0_1")
    assert_eq(rejection(profile), "unsupported_profile")
    mut bad_package_id = unwitnessed_package()
    bad_package_id.package_id = PackageId(SymbolicIdType(IdType(f"Package With Spaces")))
    assert_eq(rejection(bad_package_id), "invalid_package_id")
    mut bad_domain_id = unwitnessed_package()
    bad_domain_id.domain_id = DomainId(SymbolicIdType(IdType(f"Domain With Spaces")))
    assert_eq(rejection(bad_domain_id), "invalid_domain_id")
    mut bad_revision = unwitnessed_package()
    bad_revision.package_revision = ArtifactRevisionType(IdType(f"v1"))
    assert_eq(rejection(bad_revision), "invalid_package_revision")
    mut bad_digest = lantern_package()
    bad_digest.profile_package_digest = DigestIdType(IdType(f"not-a-digest"))
    result = validate_governed_profile_package(bad_digest)
    assert_eq(result.reason, "invalid_package")
    assert_eq(result.errors[0], "invalid_profile_package_digest")


