def test_guided_support_and_action_must_match_the_declared_material() -> None:
    package = lantern_package()
    bound = request("Help me practice.")
    partial_support = proposal_for(
        package,
        bound,
        "present_guided_card",
        [evidence_id("lantern_evidence_card_order")],
        [memory_id("lantern_atom_card_order")],
        Some(guided_material_id(GUIDE_ID)),
        no_guided_step(),
        no_guided_step(),
    )
    assert_rejected_with_receipt(
        evaluate_governed_profile_with_artifacts(package, bound, partial_support, []),
        "guided_material_memory_mismatch",
    )

    mut alternate = unwitnessed_package()
    mut actions = alternate.actions.clone()
    actions.append(action("present_alternate_card", GovernedOutcomeKind.GuidedMaterial, true, true))
    actions.append(action("navigate_alternate_card", GovernedOutcomeKind.GuidedNavigation, true, true))
    alternate.actions = actions
    witnessed = rewitnessed(alternate)
    present_alternate = guide_proposal(witnessed, bound, "present_alternate_card", no_guided_step(), no_guided_step())
    assert_rejected_with_receipt(
        evaluate_governed_profile_with_artifacts(witnessed, bound, present_alternate, []),
        "guided_material_action_mismatch",
    )
    navigate_alternate = guide_proposal(
        witnessed,
        bound,
        "navigate_alternate_card",
        Some(guided_step_id("choose_starting_card")),
        Some(guided_step_id("choose_pacing")),
    )
    assert_eq(proposal_error(witnessed, bound, navigate_alternate), "guided_material_action_mismatch")


