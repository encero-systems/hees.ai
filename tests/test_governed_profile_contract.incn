    for index in range(extra_count):
        atoms.append(memory_atom(f"lantern_guided_atom_{index}", [f"lantern_guided_source_{index}"]))
        guide_memory.append(memory_id(f"lantern_guided_atom_{index}"))
        guide_evidence.append(evidence_id(f"lantern_guided_source_{index}"))
    package.memory = atoms
    material.memory_ids = guide_memory.clone()
    material.evidence_ids = guide_evidence
    package.guided_material = [material.clone()]
