    mut bad_fingerprint = passed_committee(package, bound, proposal)
    mut second = bad_fingerprint[1]
    second.evaluator_fingerprint = DigestIdType(IdType(f"not-a-digest"))
    bad_fingerprint[1] = second
    assert_rejected_with_receipt(
        evaluate_governed_profile_with_artifacts(package, bound, proposal, bad_fingerprint),
        "invalid_committee_observation",
    )


