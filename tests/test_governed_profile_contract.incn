    blank.mission = f"   "
    assert_eq(rejection(blank), "invalid_mission")


def test_action_count_boundary() -> None:
    base_count = len(unwitnessed_package().actions)
    mut at_limit = unwitnessed_package()
    mut actions = at_limit.actions.clone()
    for extra in refusal_actions(MAX_GOVERNED_ACTIONS - base_count):
        actions.append(extra)
    at_limit.actions = actions.clone()
    assert_eq(acceptance(at_limit), "ok")
    actions.append(action("refuse_one_too_many", GovernedOutcomeKind.Refusal, false, false))
    mut over = unwitnessed_package()
    over.actions = actions
    assert_eq(rejection(over), "invalid_action_count")
    mut empty = unwitnessed_package()
    empty.actions = []
    assert_eq(rejection(empty), "invalid_action_count")


