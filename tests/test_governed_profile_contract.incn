def test_committee_coverage_must_be_exact() -> None:
    package = lantern_package()
    bound = request("Which card first?")
    proposal = answer_proposal(package, bound)
    mut missing: list[CommitteeObservation] = []
    for role in required_role_names():
        if role != "contextual_tone":
            missing.append(observation(package, bound, proposal, role, CommitteeVerdict.Pass))
    assert_rejected_with_receipt(
        evaluate_governed_profile_with_artifacts(package, bound, proposal, missing),
        "committee_coverage_invalid",
    )
    mut extra = passed_committee(package, bound, proposal)
    extra.append(observation(package, bound, proposal, "unrequired_role", CommitteeVerdict.Pass))
    assert_rejected_with_receipt(
        evaluate_governed_profile_with_artifacts(package, bound, proposal, extra),
        "committee_coverage_invalid",
    )
    mut duplicate_role = passed_committee(package, bound, proposal)
    duplicate_role[5] = observation(package, bound, proposal, "evidence_support", CommitteeVerdict.Pass)
    assert_rejected_with_receipt(
        evaluate_governed_profile_with_artifacts(package, bound, proposal, duplicate_role),
        "committee_coverage_invalid",
    )
    mut duplicate_observation = passed_committee(package, bound, proposal)
    mut last = duplicate_observation[5]
    last.observation_id = observation_id("observation_evidence_support")
    duplicate_observation[5] = last
    assert_rejected_with_receipt(
        evaluate_governed_profile_with_artifacts(package, bound, proposal, duplicate_observation),
        "committee_coverage_invalid",
    )


