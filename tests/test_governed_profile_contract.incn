def test_request_fields_are_validated_with_specific_diagnostics() -> None:
    assert_eq(validate_governed_request(request("Which card first?")).reason, "ok")
    assert_eq(validate_governed_request(request(repeated("q", MAX_QUESTION_LENGTH))).reason, "ok")
    over = validate_governed_request(request(repeated("q", MAX_QUESTION_LENGTH + 1)))
    assert_eq(over.reason, "invalid_request")
    assert_eq(over.errors[0], "invalid_question")
    assert_eq(validate_governed_request(request("   ")).errors[0], "invalid_question")
    bad_language = bind_governed_request(request_id("request_lantern"), "Which card first?", "E", audience_id(AUDIENCE))
    assert_eq(validate_governed_request(bad_language).errors[0], "invalid_request_language")
    bad_id = bind_governed_request(
        RequestId(SymbolicIdType(IdType(f"Request With Spaces"))),
        "Which card first?",
        "en",
        audience_id(AUDIENCE),
    )
    assert_eq(validate_governed_request(bad_id).errors[0], "invalid_request_id")
    bad_audience = bind_governed_request(
        request_id("request_lantern"),
        "Which card first?",
        "en",
        AudienceId(SymbolicIdType(IdType(f"Audience With Spaces"))),
    )
    assert_eq(validate_governed_request(bad_audience).errors[0], "invalid_request_audience")
    mut stale = request("Which card first?")
    stale.request_digest = digest_id_type(OTHER_DIGEST)
    stale_result = validate_governed_request(stale)
    assert_eq(stale_result.reason, "request_digest_mismatch")
    assert_eq(stale_result.errors[0], "request_digest_mismatch")


def identity_rejection(proposal: GovernedProposal) -> CompleteGovernedEvaluation:
    """Evaluate a mutated answer proposal against the fixture package and request."""

    package = lantern_package()
    bound = request("Which card first?")
    return evaluate_governed_profile_with_artifacts(package, bound, proposal, [])


def base_answer() -> GovernedProposal:
    """Return the supported answer proposal for the fixture package and request."""

    return answer_proposal(lantern_package(), request("Which card first?"))


def test_proposal_identity_mismatches_are_rejected_without_receipt() -> None:
    mut contract = base_answer()
    contract.contract_version = contract_id("other_proposal_contract_0_1")
    assert_rejected_without_receipt(identity_rejection(contract), "unsupported_proposal_contract")

    mut profile = base_answer()
    profile.profile_id = profile_id("other_profile_0_1")
    assert_rejected_without_receipt(identity_rejection(profile), "profile_id_mismatch")

    mut foreign_package = base_answer()
    foreign_package.package_id = package_id("other_package")
    assert_rejected_without_receipt(identity_rejection(foreign_package), "package_id_mismatch")

    mut foreign_domain = base_answer()
    foreign_domain.domain_id = domain_id("other_domain")
    assert_rejected_without_receipt(identity_rejection(foreign_domain), "domain_id_mismatch")

    mut stale_revision = base_answer()
    stale_revision.package_revision = artifact_revision("9.9.9")
    assert_rejected_without_receipt(identity_rejection(stale_revision), "package_revision_mismatch")

    mut stale_digest = base_answer()
    stale_digest.profile_package_digest = digest_id_type(OTHER_DIGEST)
    assert_rejected_without_receipt(identity_rejection(stale_digest), "profile_package_digest_mismatch")

    mut foreign_request = base_answer()
    foreign_request.request_id = request_id("request_other")
    assert_rejected_without_receipt(identity_rejection(foreign_request), "request_id_mismatch")

    mut stale_request = base_answer()
    stale_request.request_digest = digest_id_type(OTHER_DIGEST)
    assert_rejected_without_receipt(identity_rejection(stale_request), "request_digest_mismatch")


def test_visible_output_length_boundary() -> None:
    package = lantern_package()
    bound = request("Which card first?")
    mut at_limit = answer_proposal(package, bound)
    at_limit.visible_output = repeated("v", MAX_VISIBLE_OUTPUT_LENGTH)
    assert_eq(validate_governed_proposal_identity(package, bound, at_limit).reason, "ok")
    mut over = answer_proposal(package, bound)
    over.visible_output = repeated("v", MAX_VISIBLE_OUTPUT_LENGTH + 1)
    assert_rejected_without_receipt(identity_rejection(over), "missing_visible_output")
    mut blank = answer_proposal(package, bound)
    blank.visible_output = f"   "
    assert_eq(validate_governed_proposal_identity(package, bound, blank).reason, "ok")
    assert_rejected_with_receipt(identity_rejection(blank), "missing_visible_output")
    mut empty = answer_proposal(package, bound)
    empty.visible_output = f""
    assert_rejected_with_receipt(identity_rejection(empty), "missing_visible_output")
    mut boundary_over = terminal_proposal(package, bound, "refuse_unsupported")
    boundary_over.visible_output = repeated("v", MAX_VISIBLE_OUTPUT_LENGTH + 1)
    assert_rejected_without_receipt(identity_rejection(boundary_over), "missing_visible_output")


def test_proposal_reference_counts_are_bounded_before_duplicate_scans() -> None:
    package = lantern_package()
    bound = request("Which card first?")
    mut at_limit = answer_proposal(package, bound)
    at_limit.evidence_ids = [evidence_id(f"lantern_unknown_{index}") for index in range(MAX_PROPOSAL_EVIDENCE)]
    assert_rejected_with_receipt(identity_rejection(at_limit), "unknown_evidence")
    mut over_evidence = answer_proposal(package, bound)
    over_evidence.evidence_ids = [evidence_id("lantern_evidence_card_order") for _index in range(
        MAX_PROPOSAL_EVIDENCE + 1,
    )]
    assert_rejected_without_receipt(identity_rejection(over_evidence), "proposal_reference_limit_exceeded")
    mut over_memory = answer_proposal(package, bound)
    over_memory.memory_ids = [memory_id("lantern_atom_card_order") for _index in range(MAX_PROPOSAL_MEMORY + 1)]
    assert_rejected_without_receipt(identity_rejection(over_memory), "proposal_reference_limit_exceeded")


