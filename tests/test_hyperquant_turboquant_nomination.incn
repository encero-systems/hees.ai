"""Contract tests for bounded TurboQuant nomination with exact reranking."""

import std.math
from std.testing import assert_eq, assert_is_err, assert_is_ok
from crate.hyperquant import (
    HyperquantEntry,
    HyperquantErrorKind,
    HyperquantNomination,
    HyperquantProfile,
    TurboquantConfiguration,
    TurboquantIndex,
    exact_index,
    exact_query,
    hyperquant_entry,
    turboquant_index,
    turboquant_query,
)
from crate.identifiers import memory_id

const DIMENSIONS: int = 8
const ENTRY_COUNT: int = 12


def synthetic_vector(dimensions: int, phase: int) -> list[float]:
    """Return one deterministic, non-degenerate vector."""

    mut values: list[float] = []
    for index in range(dimensions):
        values.append(float(((index * 7 + phase * 13) % 23) - 11) + float(phase % 5) * 0.25)
    return values


def entry(id: str, values: list[float]) -> HyperquantEntry:
    return assert_is_ok(hyperquant_entry(memory_id(id), values))


def synthetic_entries(dimensions: int, count: int) -> list[HyperquantEntry]:
    mut entries: list[HyperquantEntry] = []
    for position in range(count):
        entries.append(entry(f"atom_{position}", synthetic_vector(dimensions, position + 1)))
    return entries


def mse_configuration(dimensions: int) -> TurboquantConfiguration:
    return assert_is_ok(
        TurboquantConfiguration.create(
            HyperquantProfile.TurboquantMse01,
            dimensions,
            2,
            20261001,
            [-0.53, -0.16, 0.16, 0.53],
        ),
    )


def product_configuration(dimensions: int) -> TurboquantConfiguration:
    return assert_is_ok(
        TurboquantConfiguration.create(
            HyperquantProfile.TurboquantProduct01,
            dimensions,
            3,
            20261001,
            [-0.53, -0.16, 0.16, 0.53],
        ),
    )


def nomination_ids(nominations: list[HyperquantNomination]) -> list[str]:
    return [nomination.memory_id.text() for nomination in nominations]


def assert_matches_exact_oracle(configuration: TurboquantConfiguration) -> None:
    entries = synthetic_entries(DIMENSIONS, ENTRY_COUNT)
    compressed = assert_is_ok(turboquant_index(configuration, entries))
    oracle = assert_is_ok(exact_index(entries))
    for phase in [3, 17, 40]:
        query = synthetic_vector(DIMENSIONS, phase)
        result = assert_is_ok(turboquant_query(compressed, query, 4, ENTRY_COUNT))
        exact = assert_is_ok(exact_query(oracle, query, 4))
        assert_eq(nomination_ids(result.nominations), nomination_ids(exact.nominations))
        for position in range(4):
            assert_eq(result.nominations[position].rank, position)
            assert_eq(result.nominations[position].relevance_bps, exact.nominations[position].relevance_bps)


def test_full_candidate_rerank_reproduces_the_exact_oracle_for_the_mse_profile() -> None:
    assert_matches_exact_oracle(mse_configuration(DIMENSIONS))


def test_full_candidate_rerank_reproduces_the_exact_oracle_for_the_product_profile() -> None:
    assert_matches_exact_oracle(product_configuration(DIMENSIONS))


def test_transform_space_estimate_matches_the_reference_estimate() -> None:
    for configuration in [mse_configuration(DIMENSIONS), product_configuration(DIMENSIONS)]:
        query = assert_is_ok(hyperquant_entry(memory_id("query"), synthetic_vector(DIMENSIONS, 9)))
        normalized = [query.coordinate(dimension) for dimension in range(DIMENSIONS)]
        rotated = configuration.rotated_query(normalized)
        projected = configuration.projected_query(normalized)
        for phase in range(1, 6):
            code = assert_is_ok(configuration.encode(synthetic_vector(DIMENSIONS, phase)))
            reference = assert_is_ok(configuration.estimate(normalized, code))
            transformed = configuration.estimate_transformed(rotated, projected, code)
            assert_eq(math.abs(reference - transformed) < 0.000000001, true)


def test_candidate_count_bounds_the_approximate_stage_and_orders_the_trace() -> None:
    compressed = assert_is_ok(
        turboquant_index(product_configuration(DIMENSIONS), synthetic_entries(DIMENSIONS, ENTRY_COUNT)),
    )
    query = synthetic_vector(DIMENSIONS, 21)
    result = assert_is_ok(turboquant_query(compressed, query, 2, 5))
    assert_eq(len(result.candidates), 5)
    assert_eq(len(result.nominations), 2)
    for position in range(4):
        assert_eq(
            result.candidates[position].cosine_similarity >= result.candidates[position + 1].cosine_similarity,
            true,
        )
    assert_eq(result.nominations[0].memory_id.text(), result.candidates[0].memory_id.text())
    assert_eq(result.nominations[1].memory_id.text(), result.candidates[1].memory_id.text())

    repeated = assert_is_ok(turboquant_query(compressed, query, 2, 5))
    assert_eq(nomination_ids(repeated.nominations), nomination_ids(result.nominations))
    assert_eq(repeated.index_fingerprint, result.index_fingerprint)


def test_identical_vectors_are_ordered_by_canonical_memory_identifier() -> None:
    shared = synthetic_vector(DIMENSIONS, 4)
    entries = [entry("zulu", shared), entry("alpha", shared), entry("mike", shared), entry(
        "far",
        synthetic_vector(DIMENSIONS, 11),
    )]
    compressed = assert_is_ok(turboquant_index(mse_configuration(DIMENSIONS), entries))
    result = assert_is_ok(turboquant_query(compressed, shared, 3, 4))
    assert_eq(nomination_ids(result.nominations), ["alpha", "mike", "zulu"])
    assert_eq(result.nominations[0].relevance_bps, 10000)


def test_index_fingerprint_binds_configuration_identifiers_and_order() -> None:
    entries = synthetic_entries(DIMENSIONS, 4)
    first = assert_is_ok(turboquant_index(mse_configuration(DIMENSIONS), entries))
    again = assert_is_ok(turboquant_index(mse_configuration(DIMENSIONS), synthetic_entries(DIMENSIONS, 4)))
    assert_eq(first.index_fingerprint(), again.index_fingerprint())
    assert_eq(first.index_fingerprint().startswith("sha256:"), true)
    assert_eq(first.entry_count(), 4)
    assert_eq(first.dimensions(), DIMENSIONS)
    assert_eq(first.profile(), HyperquantProfile.TurboquantMse01)

    other_profile = assert_is_ok(turboquant_index(product_configuration(DIMENSIONS), synthetic_entries(DIMENSIONS, 4)))
    assert_eq(first.index_fingerprint() == other_profile.index_fingerprint(), false)

    renamed = [entry("renamed", synthetic_vector(DIMENSIONS, 1)), entry("atom_1", synthetic_vector(DIMENSIONS, 2))]
    original = [entry("atom_0", synthetic_vector(DIMENSIONS, 1)), entry("atom_1", synthetic_vector(DIMENSIONS, 2))]
    reordered = [entry("atom_1", synthetic_vector(DIMENSIONS, 2)), entry("atom_0", synthetic_vector(DIMENSIONS, 1))]
    original_index = assert_is_ok(turboquant_index(mse_configuration(DIMENSIONS), original))
    renamed_index = assert_is_ok(turboquant_index(mse_configuration(DIMENSIONS), renamed))
    reordered_index = assert_is_ok(turboquant_index(mse_configuration(DIMENSIONS), reordered))
    assert_eq(original_index.index_fingerprint() == renamed_index.index_fingerprint(), false)
    assert_eq(original_index.index_fingerprint() == reordered_index.index_fingerprint(), false)


def test_index_construction_fails_closed() -> None:
    assert_eq(assert_is_err(turboquant_index(mse_configuration(DIMENSIONS), [])).kind(), HyperquantErrorKind.EmptyIndex)

    duplicate = [entry("same", synthetic_vector(DIMENSIONS, 1)), entry("same", synthetic_vector(DIMENSIONS, 2))]
    assert_eq(
        assert_is_err(turboquant_index(mse_configuration(DIMENSIONS), duplicate)).kind(),
        HyperquantErrorKind.DuplicateMemoryId,
    )

    wrong_dimension = [entry("short", synthetic_vector(DIMENSIONS - 1, 1))]
    assert_eq(
        assert_is_err(turboquant_index(mse_configuration(DIMENSIONS), wrong_dimension)).kind(),
        HyperquantErrorKind.DimensionMismatch,
    )


def test_query_bounds_fail_closed() -> None:
    compressed = assert_is_ok(turboquant_index(mse_configuration(DIMENSIONS), synthetic_entries(DIMENSIONS, 6)))
    query = synthetic_vector(DIMENSIONS, 2)

    assert_eq(assert_is_err(turboquant_query(compressed, query, 0, 3)).kind(), HyperquantErrorKind.InvalidTopK)
    assert_eq(assert_is_err(turboquant_query(compressed, query, 7, 7)).kind(), HyperquantErrorKind.InvalidTopK)
    assert_eq(assert_is_err(turboquant_query(compressed, query, 65, 65)).kind(), HyperquantErrorKind.InvalidTopK)
    assert_eq(assert_is_err(turboquant_query(compressed, query, 3, 2)).kind(), HyperquantErrorKind.InvalidTopK)
    assert_eq(assert_is_err(turboquant_query(compressed, query, 3, 7)).kind(), HyperquantErrorKind.InvalidTopK)
    assert_eq(
        assert_is_err(turboquant_query(compressed, synthetic_vector(DIMENSIONS + 1, 2), 3, 3)).kind(),
        HyperquantErrorKind.DimensionMismatch,
    )
    assert_eq(
        assert_is_err(turboquant_query(compressed, [0.0 for _index in range(DIMENSIONS)], 3, 3)).kind(),
        HyperquantErrorKind.ZeroVector,
    )
    assert_eq(assert_is_err(turboquant_query(compressed, [], 3, 3)).kind(), HyperquantErrorKind.EmptyVector)


def test_dense_reference_accepts_dimensions_above_the_first_slice_bound() -> None:
    dimensions = 320
    compressed = assert_is_ok(turboquant_index(mse_configuration(dimensions), synthetic_entries(dimensions, 5)))
    oracle = assert_is_ok(exact_index(synthetic_entries(dimensions, 5)))
    query = synthetic_vector(dimensions, 3)
    result = assert_is_ok(turboquant_query(compressed, query, 3, 5))
    exact = assert_is_ok(exact_query(oracle, query, 3))
    assert_eq(nomination_ids(result.nominations), nomination_ids(exact.nominations))


def test_a_compressed_index_holds_more_entries_than_any_fixed_number() -> None:
    entries = synthetic_entries(DIMENSIONS, 70000)
    compressed = assert_is_ok(turboquant_index(mse_configuration(DIMENSIONS), entries))
    result = assert_is_ok(turboquant_query(compressed, synthetic_vector(DIMENSIONS, 7), 4, 64))
    assert_eq(compressed.entry_count(), 70000)
    assert_eq(len(result.nominations), 4)
    assert_eq(result.nominations[0].rank, 0)
    assert_eq(result.nominations[0].relevance_bps >= result.nominations[3].relevance_bps, true)
