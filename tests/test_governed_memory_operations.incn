# Supersede and revoke rules


def test_supersede_rejections_follow_rfc_order() -> None:
    mut missing_record = subject_supersede()
    missing_record.existing_record = None
    assert_rejected(evaluate(missing_record), "memory_record_required")

    mut trace = proposal(
        "supersede_memory",
        MemoryOperationKind.Supersede,
        TRACE_CLASS,
        Some(record(TRACE_CLASS, false, Some(2000))),
        true,
    )
    trace.replacement_memory_id = Some(memory_id("memory_two"))
    assert_rejected(evaluate(trace), "memory_supersede_not_allowed")

    mut no_replacement = subject_supersede()
    no_replacement.replacement_memory_id = None
    assert_rejected(evaluate(no_replacement), "replacement_memory_required")

    mut same_replacement = subject_supersede()
    same_replacement.replacement_memory_id = Some(memory_id("memory_one"))
    assert_rejected(evaluate(same_replacement), "replacement_memory_must_differ")

    mut no_consent = subject_supersede()
    no_consent.consent_present = false
    assert_rejected(evaluate(no_consent), "explicit_consent_required")

    mut bad_key = subject_supersede()
    bad_key.memory_key = Some("favorite_color")
    assert_rejected(evaluate(bad_key), "memory_key_not_allowed")

    mut no_provenance = subject_supersede()
    no_provenance.provenance_fields = []
    assert_rejected(evaluate(no_provenance), "memory_provenance_incomplete")


