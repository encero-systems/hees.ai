def test_runtime_record_binds_to_its_session_only_when_it_carries_one() -> None:
    mut unbound = record(TRACE_CLASS, false, Some(2000))
    unbound.session_id = None
    mut from_other_session = inspect_record(TRACE_CLASS, witnessed(unbound))
    from_other_session.session_id = Some(session_id("session_two"))
    assert_admitted(evaluate(from_other_session), "declared_memory_inspection", "inspect_memory")

    mut bound = inspect_record(TRACE_CLASS, record(TRACE_CLASS, false, Some(2000)))
    bound.session_id = Some(session_id("session_two"))
    assert_rejected(evaluate(bound), "memory_record_identity_mismatch")


def test_sessionless_runtime_write_is_admitted() -> None:
    mut trace = proposal("write_memory", MemoryOperationKind.Write, TRACE_CLASS, None, false)
    trace.session_id = None
    trace.memory_key = None
    trace.provenance_fields = ["terminal_receipt_id"]
    admitted = evaluate(trace)
    assert_admitted(admitted, "declared_memory_write", "write_memory")
    written = assert_is_some(admitted.resulting_record)
    assert_is_none(written.session_id.clone())
    assert_is_none(written.memory_key.clone())
    assert_eq(assert_is_some(written.expires_at_seconds.clone()), NOW + TRACE_MAXIMUM_AGE)
    assert_eq(written.provenance_fields, ["terminal_receipt_id"])

    mut from_other_session = inspect_record(TRACE_CLASS, written)
    from_other_session.session_id = Some(session_id("session_two"))
    assert_admitted(evaluate(from_other_session), "declared_memory_inspection", "inspect_memory")


def test_runtime_write_in_a_session_binds_the_record_to_it() -> None:
    mut trace = proposal("write_memory", MemoryOperationKind.Write, TRACE_CLASS, None, false)
    trace.memory_key = None
    trace.provenance_fields = ["terminal_receipt_id"]
    written = resulting_record(trace)
    assert_eq(assert_is_some(written.session_id.clone()), session_id("session_one"))
    assert_admitted(
        evaluate(inspect_record(TRACE_CLASS, written.clone())),
        "declared_memory_inspection",
        "inspect_memory",
    )
    mut from_other_session = inspect_record(TRACE_CLASS, written)
    from_other_session.session_id = Some(session_id("session_two"))
    assert_rejected(evaluate(from_other_session), "memory_record_identity_mismatch")
