    mut no_operations = unwitnessed_memory_policy()
    no_operations.operations = []
    assert_eq(validate_governed_memory_policy(rewitnessed(no_operations)).reason, "memory_policy_empty")


def test_a_memory_class_may_allow_any_number_of_keys() -> None:
