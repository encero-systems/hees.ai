def test_write_over_a_revoked_or_superseded_record_the_host_supplies_is_rejected() -> None:
    mut over_revoked = subject_write()
    over_revoked.existing_record = Some(record(SUBJECT_CLASS, true, Some(2000)))
    assert_rejected(evaluate(over_revoked), "memory_already_exists")

    mut superseded = hand_assembled_record(SUBJECT_CLASS, false, Some(2000))
    superseded.superseded_by = Some(memory_id("memory_two"))
    mut over_superseded = subject_write()
    over_superseded.existing_record = Some(witnessed(superseded))
    assert_rejected(evaluate(over_superseded), "memory_already_exists")
