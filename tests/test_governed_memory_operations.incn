# Policy validation


def test_genuine_memory_policy_is_valid() -> None:
    assert_eq(validate_governed_memory_policy(memory_policy()).reason, "valid")


def test_stale_memory_policy_digest_after_class_change_is_rejected() -> None:
    mut mutated = memory_policy()
    mut first_class = mutated.classes[0]
    first_class.prompt_eligible = not first_class.prompt_eligible
    mutated.classes[0] = first_class
    assert_eq(validate_governed_memory_policy(mutated).reason, "memory_policy_digest_mismatch")


def test_stale_memory_policy_digest_after_operation_change_is_rejected() -> None:
    mut mutated = memory_policy()
    mut first_operation = mutated.operations[0]
    first_operation.allowed_class_ids = [memory_class_id(TRACE_CLASS)]
    mutated.operations[0] = first_operation
    assert_eq(validate_governed_memory_policy(mutated).reason, "memory_policy_digest_mismatch")


def test_memory_policy_digest_hashes_the_policy_type_tag() -> None:
    policy = unwitnessed_memory_policy()
    source = PolicyDigestMirror(
        profile_id=policy.profile_id,
        package_id=policy.package_id,
        domain_id=policy.domain_id,
        package_revision=policy.package_revision,
        classes=policy.classes,
        operations=policy.operations,
    ).to_json()
    digest_value = digest_governed_memory_policy(policy)
    assert_eq(digest_value, assert_is_ok(digest_tagged_json(POLICY_TYPE_TAG, source)))
    assert_eq(digest_value == assert_is_ok(digest_canonical_json(source)), false)
    assert_eq(digest_value == assert_is_ok(digest_tagged_json(RECORD_TYPE_TAG, source)), false)


def test_empty_memory_policy_is_rejected() -> None:
