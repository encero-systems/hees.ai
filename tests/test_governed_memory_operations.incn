def test_operation_rules_and_required_provenance_stay_bounded() -> None:
    # One rule per operation kind, and a class may not require more provenance than one request can carry.
    mut extra_operation = unwitnessed_memory_policy()
    extra_operation.operations = extra_operation.operations + [fixture_operation(0)]
    assert_eq(validate_governed_memory_policy(rewitnessed(extra_operation)).reason, "memory_policy_too_large")

    mut provenance_at_bound = fixture_class(2)
    provenance_at_bound.required_provenance = [f"field_{index}" for index in range(16)]
    assert_eq(validate_governed_memory_policy(with_class(2, provenance_at_bound)).reason, "valid")

    mut provenance_over_bound = fixture_class(2)
    provenance_over_bound.required_provenance = [f"field_{index}" for index in range(17)]
    assert_eq(validate_governed_memory_policy(with_class(2, provenance_over_bound)).reason, "memory_policy_too_large")


