def test_sessionless_write_into_a_session_class_is_rejected() -> None:
    mut session_class = fixture_class(1)
    session_class.owner = MemoryOwner.Session
    mut unwitnessed = unwitnessed_memory_policy()
    unwitnessed.classes[1] = session_class
    policy = rewitnessed(unwitnessed)
    mut write = subject_write()
    write.memory_policy_digest = digest_governed_memory_policy(unwitnessed)
    written = assert_is_some(evaluate_memory_operation(policy, write, host_key()).resulting_record)
    assert_eq(assert_is_some(written.session_id), session_id("session_one"))
    write.session_id = None
    assert_rejected(evaluate_memory_operation(policy, write, host_key()), "memory_session_required")


