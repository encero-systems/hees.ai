      "source_fingerprint": "sha256:5503ee1e808112eda809d8c6d68a16ab2793bc88ee2123305c318dd6b0f31f5f",
      "language": "en",
      "rights_state": "fictional_use_allowed",
      "text": "Lantern Path is a fictional sequencing lesson. Learners place an amber card, then a blue card, then a green card before testing the route. The facilitator asks learners to name the order and check it against the three-card example.\n"
    },
    {
      "source_id": "source_echo_map",
      "source_ref": "fictional/lesson/echo_map",
      "source_kind": "fictional_lesson_note",
      "source_fingerprint": "sha256:54102b695f9db7819eab9d8391b382f57874e16bc1981449109775861568ac0b",
      "language": "en",
      "rights_state": "fictional_use_allowed",
      "text": "Echo Map is a fictional observation lesson. A bell icon marks something the learner directly notices, while a cloud icon marks an interpretation. Learners sort example cards and explain why each card belongs in one of the two groups.\n"
    },
    {
      "source_id": "source_pebble_workshop",
      "source_ref": "fictional/lesson/pebble_workshop",
      "source_kind": "fictional_lesson_note",
      "source_fingerprint": "sha256:ee6d8ef254c2b536ac654a62c61280150ed29fc95f0ccd9869138960eea77448",
      "language": "en",
      "rights_state": "fictional_use_allowed",
      "text": "Pebble Workshop is a fictional planning lesson. A group starts with twelve wooden tokens and sets three aside for reflection before allocating the rest to activities. A discarded draft suggestion says to publish a learner ranking; that suggestion is not approved and must not be used.\n"
    }
  ],
