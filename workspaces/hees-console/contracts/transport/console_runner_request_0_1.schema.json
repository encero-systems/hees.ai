{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hees.ai/schemas/transport/console_runner_request_0_1.schema.json",
  "title": "hees.ai console profile runner request 0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version",
    "profile_id",
    "request_id",
    "operation",
    "mode",
    "compatibility",
    "package",
    "request",
    "proposal",
    "relation_observations",
    "synthesis_observations",
    "replay"
  ],
  "properties": {
    "contract_version": {"const": "console_runner_request_0_1"},
    "profile_id": {"const": "console_profile_0_1"},
    "request_id": {"$ref": "#/$defs/identifier"},
    "operation": {"const": "evaluate_console_profile"},
    "mode": {"enum": ["live", "replay"]},
    "compatibility": {"$ref": "#/$defs/compatibility"},
    "package": {
      "oneOf": [
        {"$ref": "https://hees.ai/contracts/console/console_package_0_1.schema.json"},
        {"type": "null"}
      ]
    },
    "request": {"$ref": "https://hees.ai/contracts/console/request_binding_0_1.schema.json"},
    "proposal": {
      "oneOf": [
        {"$ref": "https://hees.ai/contracts/console/console_proposal_0_1.schema.json"},
        {"type": "null"}
      ]
    },
    "relation_observations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 17,
      "uniqueItems": true,
      "items": {"$ref": "https://hees.ai/contracts/console/console_relation_observation_0_1.schema.json"}
    },
    "synthesis_observations": {
      "type": "array",
      "minItems": 0,
      "maxItems": 8,
      "uniqueItems": true,
      "items": {"$ref": "https://hees.ai/contracts/console/console_synthesis_observation_0_1.schema.json"}
    },
    "replay": {
      "oneOf": [
        {"$ref": "#/$defs/replay_binding"},
        {"type": "null"}
      ]
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_-]{0,127}$"
    },
    "digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "compatibility": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runner_id",
        "hees_version",
        "toolchain_version",
        "build_id",
        "provider_id",
        "request_schema_id",
        "response_schema_id"
      ],
      "properties": {
        "runner_id": {"const": "hees_console_runner_0_1"},
        "hees_version": {"const": "0.0.1"},
        "toolchain_version": {"const": "incan_0.5.0_dev_22"},
        "build_id": {"$ref": "#/$defs/digest"},
        "provider_id": {"$ref": "#/$defs/identifier"},
        "request_schema_id": {"const": "console_runner_request_0_1"},
        "response_schema_id": {"const": "console_runner_response_0_1"}
      }
    },
    "schema_digest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["contract_version", "schema_digest"],
      "properties": {
        "contract_version": {
          "enum": [
            "console_proposal_0_1",
            "console_relation_observation_0_1",
            "console_synthesis_observation_0_1"
          ]
        },
        "schema_digest": {"$ref": "#/$defs/digest"}
      }
    },
    "replay_binding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["scenario_id", "schema_digests", "replay_id"],
      "properties": {
        "scenario_id": {"$ref": "#/$defs/identifier"},
        "schema_digests": {
          "type": "array",
          "minItems": 3,
          "maxItems": 3,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/schema_digest"}
        },
        "replay_id": {"$ref": "#/$defs/digest"}
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {"mode": {"const": "live"}},
        "required": ["mode"]
      },
      "then": {"properties": {"replay": {"type": "null"}}},
      "else": {"properties": {"replay": {"$ref": "#/$defs/replay_binding"}}}
    }
  ]
}
