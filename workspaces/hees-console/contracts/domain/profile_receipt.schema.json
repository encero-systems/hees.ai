{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hees.ai/contracts/console/console_profile_receipt_0_1.schema.json",
  "title": "hees.ai console Build Week initial-profile receipt envelope",
  "type": "object",
