    MAX_LIVE_COMMITTEE_CALLS,
    MAX_LIVE_PROVIDER_CALLS,
    MAX_PROVIDER_REQUEST_BYTES,
    MAX_RELATION_CALLS,
    MAX_SYNTHESIS_CALLS,
