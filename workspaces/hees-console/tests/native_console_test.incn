def test_interaction_workspace_prioritizes_navigation_authority_and_readable_receipts() -> None:
    """Render the selected hees.ai console design without falling back to raw JSON."""

    mut runs: list[ConsoleRun] = []
    for slug in ["valid", "undeclared-action", "unknown-evidence", "unknown-memory", "non-admitted-memory"]:
        runs.append(assert_is_ok(evaluate_offline_scenario(slug)))
    states = [true, false, false, false, false]
    mut state = initial_state()
    state = apply_command(state, "show-interactions", states)
    state = apply_command(state, "next-scenario", states)
    screen = render_screen_for_size(state, runs, 160, 44)
    assert_eq(screen.contains("hees.ai console"), true)
    assert_eq(screen.contains("[5 INTERACTIONS]"), true)
    assert_eq(screen.contains("UNTRUSTED PROPOSAL  MODEL"), true)
    assert_eq(screen.contains("HEES DECISION"), true)
    assert_eq(screen.contains("unknown_action"), true)
    assert_eq(screen.contains("CONTEXT  EVIDENCE  MEMORY  DNA  [RECEIPT]"), true)
    plain_screen = strip_terminal_styles(screen)
    assert_eq(plain_screen.contains("[←→] context"), true)
    assert_eq(plain_screen.contains("[1–7] destinations"), true)
    assert_eq(screen.contains("SHIFT+TAB"), false)
    assert_eq(screen.contains("direct scenario"), false)
    assert_eq(screen.contains("{\"body\""), false)


def test_wide_interaction_wraps_the_complete_visible_response() -> None:
