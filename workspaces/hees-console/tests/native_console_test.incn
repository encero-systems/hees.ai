from terminal import command_for_byte, command_for_escape_sequence, search_command_for_byte, status_command_for_byte


@derive(json)
model ControlPayload:
    """JSON-decoded control sequence used to exercise terminal sanitization."""

    value: str


@derive(json)
model ProviderFixtureContent:
    """One structured-output text item returned by an injected provider transport."""

    type_ as "type": str
    text: str


@derive(json)
model ProviderFixtureOutput:
    """One injected Responses message containing structured output text."""

    type_ as "type": str
    content: list[ProviderFixtureContent]


@derive(json)
model ProviderFixtureResponse:
    """Minimal Responses envelope consumed by the native provider decoder."""

    status: str
    model_name as "model": str
    output: list[ProviderFixtureOutput]


def read_fixture(path: str) -> Result[str, str]:
    """Read one checked fictional fixture relative to the Console project root."""

    return Path(path).read_text("utf-8", "strict").map_err((error) => error.message())


def canonical_json(source: str) -> Result[str, str]:
    """Canonicalize one JSON source before comparing embedded and checked fixtures."""

    value = JsonValue.parse(source).map_err((_error) => f"invalid_json")?
    return value.to_json().map_err((_error) => f"json_serialization_failed")


def required(value: JsonValue, key: str) -> JsonValue:
    """Require one JSON object field in a deterministic transport fixture."""

    return assert_is_ok(value.require(key))


def required_str(value: JsonValue, key: str) -> str:
    """Require one JSON string field in a deterministic transport fixture."""

    return assert_is_ok(required(value, key).expect_str())


def provider_payload(request_body: str) -> JsonValue:
    """Decode the exact user payload from one prepared Responses request."""

    request = assert_is_ok(JsonValue.parse(request_body))
    inputs = assert_is_ok(required(request, "input").expect_array())
    content = assert_is_ok(required(inputs[0], "content").expect_array())
    return assert_is_ok(JsonValue.parse(required_str(content[0], "text")))


def provider_response(output_text: str) -> str:
    """Wrap structured output in the fixed live-provider response envelope."""

    response = ProviderFixtureResponse(
        status="completed",
        model_name=GPT56_MODEL,
        output=[ProviderFixtureOutput(
            type_="message",
            content=[ProviderFixtureContent(type_="output_text", text=output_text)],
        )],
    )
    return response.to_json()


def proposal_transport_from(relative: str, request_body: str) -> Result[str, ProviderFailure]:
    """Bind one proposal fixture to the exact live request supplied by Hees."""

    context = provider_payload(request_body)
    request = required(context, "request")
    mut proposal = assert_is_ok(JsonValue.parse(assert_is_ok(read_fixture(relative))))
    assert_is_ok(proposal.set("request_id", JsonValue.str(required_str(request, "request_id"))))
    assert_is_ok(proposal.set("request_digest", JsonValue.str(required_str(request, "request_digest"))))
    return Ok(provider_response(assert_is_ok(proposal.to_json())))


def valid_live_proposal_transport(request_body: str) -> Result[str, ProviderFailure]:
    """Return a request-bound valid proposal without environment or network access."""

    return proposal_transport_from("fixtures/fictional_lesson_support/proposals/valid_lantern.json", request_body)


def undeclared_live_proposal_transport(request_body: str) -> Result[str, ProviderFailure]:
    """Return a schema-valid undeclared action without environment or network access."""

    return proposal_transport_from("fixtures/fictional_lesson_support/proposals/undeclared_action.json", request_body)


def committee_transport(request_body: str) -> Result[str, ProviderFailure]:
    """Return bound high-support scores for each exact Hees-authored committee target."""

    payload = provider_payload(request_body)
    request = required(payload, "request")
    target = required(payload, "target")
    target_digest = required_str(target, "target_digest")
    body = required(target, "body")
    evaluator_role = required_str(body, "evaluator_role")
    mut observation = {"contract_version": JsonValue.str("console_relation_observation_0_1"), "profile_id": JsonValue.str(
        required_str(payload, "profile_id"),
    ), "observation_id": JsonValue.str(required_str(payload, "observation_id")), "package_id": JsonValue.str(
        required_str(payload, "package_id"),
    ), "domain_id": JsonValue.str(required_str(payload, "domain_id")), "package_revision": JsonValue.str(
        required_str(payload, "package_revision"),
    ), "artifact_digest": JsonValue.str(required_str(payload, "artifact_digest")), "request_id": JsonValue.str(
        required_str(request, "request_id"),
    ), "request_digest": JsonValue.str(required_str(request, "request_digest")), "candidate_digest": JsonValue.str(
        required_str(body, "candidate_digest"),
    ), "target_id": JsonValue.str(required_str(body, "target_id")), "target_digest": JsonValue.str(target_digest), "evaluator_role": JsonValue.str(
        evaluator_role,
    ), "target_role": JsonValue.str(required_str(body, "target_role"))}
    if evaluator_role == "synthesis_coverage":
        observation["contract_version"] = JsonValue.str("console_synthesis_observation_0_1")
        observation["covered_bps"] = JsonValue.int(9_000)
        observation["gap_bps"] = JsonValue.int(500)
        observation["unresolved_bps"] = JsonValue.int(500)
    else:
        observation["support_bps"] = JsonValue.int(9_000)
        observation["contradiction_bps"] = JsonValue.int(500)
        observation["unresolved_bps"] = JsonValue.int(500)
    return Ok(provider_response(assert_is_ok(JsonValue.object(observation).to_json())))


def assert_fixture_parity(embedded: str, path: str) -> None:
    """Assert one embedded replay or package is canonically identical to its fixture."""

    fixture = assert_is_ok(read_fixture(path))
    assert_eq(assert_is_ok(canonical_json(embedded)), assert_is_ok(canonical_json(fixture)))


def assert_decision(slug: str, admitted: bool, reason: str) -> ConsoleRun:
    """Evaluate one scenario and assert the exact Hees Spectrum outcome."""

    run = assert_is_ok(evaluate_offline_scenario(slug))
    assert_eq(run.result.spectrum.admitted, admitted)
    assert_eq(run.result.spectrum.reason, reason)
    return run


def option_has_value(value: Option[str]) -> bool:
    """Return whether one optional terminal artifact is present."""

    match value:
        Some(_) => return true
        None => return false


def strip_terminal_styles(value: str) -> str:
    """Remove only application-authored SGR colour sequences for visible-width assertions."""

    match Regex("\\x1B\\[[0-9;]*m"):
        Err(_) => return value
        Ok(pattern) => return pattern.replace_all(value, "")


def screen_has_exact_geometry(screen: str, columns: int, rows: int) -> bool:
    """Require every ANSI-stripped frame row to fit the declared terminal exactly."""

    lines = screen.split("\n")
    if len(lines) != rows:
        return false
    for line in lines:
        if terminal_cell_width(strip_terminal_styles(line)) != columns:
            return false
    return true


def test_embedded_package_and_replays_match_checked_fixtures() -> None:
    """Prevent embedded replay data from drifting away from the reviewed fixture set."""

    assert_fixture_parity(package_json(), "fixtures/fictional_lesson_support/package/package.json")
    assert_eq(GPT56_MODEL, "gpt-5.6-sol")
    assert_fixture_parity(valid_replay_json(), "fixtures/fictional_lesson_support/replays/valid_lantern.json")
    assert_fixture_parity(
        undeclared_action_replay_json(),
        "fixtures/fictional_lesson_support/replays/undeclared_action.json",
    )
    assert_fixture_parity(
        unknown_evidence_replay_json(),
        "fixtures/fictional_lesson_support/replays/unknown_evidence.json",
    )
    assert_fixture_parity(unknown_memory_replay_json(), "fixtures/fictional_lesson_support/replays/unknown_memory.json")
    assert_fixture_parity(
        non_admitted_memory_replay_json(),
        "fixtures/fictional_lesson_support/replays/non_admitted_memory.json",
    )


def test_embedded_replays_are_non_terminal_and_keep_reviewed_ids() -> None:
    """Bind each non-terminal replay to the reviewed integrity identifier."""

    assert_eq(embedded_inputs_are_non_terminal(), true)
    assert_eq(
        assert_is_ok(load_offline_scenario("valid")).replay_id,
        "sha256:edf7ec8fbbaccddd523af0cecb2f9973ed755558b15b10cbbd5e354127ef9aba",
    )
    assert_eq(
        assert_is_ok(load_offline_scenario("undeclared-action")).replay_id,
        "sha256:a9dcd4301d4ebb69ab98716ce2dbb4426e3827a6bcf51270918667aaba056db5",
    )
    assert_eq(
        assert_is_ok(load_offline_scenario("unknown-evidence")).replay_id,
        "sha256:8975cb465c3f20f8c968a04ebd5a2af3fba81f54810e8b150af12f6ea56376aa",
    )
    assert_eq(
        assert_is_ok(load_offline_scenario("unknown-memory")).replay_id,
        "sha256:ee7c96d1db577798fc61650e3663dd82dda70f638c64a555983a6bb712f4aee0",
    )
    assert_eq(
        assert_is_ok(load_offline_scenario("non-admitted-memory")).replay_id,
        "sha256:25ff2f5b59fe40bb0dd6f4b034491b3c48c1bcf896a35f01d2564b2369adec04",
    )


def test_real_hees_evaluation_returns_all_five_terminal_outcomes() -> None:
    """Exercise the public Hees profile for the admitted and four rejection paths."""

    valid = assert_decision("valid", true, "admitted")
    assert_eq(option_has_value(valid.result.content_dna_json), true)
    assert_eq(option_has_value(valid.result.receipt_json), true)
    assert_eq(len(valid.result.selected_memory), 1)
    assert_decision("undeclared-action", false, "unknown_action")
    assert_decision("unknown-evidence", false, "unknown_evidence")
    assert_decision("unknown-memory", false, "unknown_memory")
    assert_decision("non-admitted-memory", false, "memory_not_admitted")


def test_headless_output_exposes_stable_sections_and_reasons() -> None:
    """Keep judge-facing automation output stable across every replay outcome."""

    valid = render_headless(assert_decision("valid", true, "admitted"))
    assert_eq(valid.contains("BUILD WEEK 2026 IMPLEMENTATION PROFILE — console_profile_0_1"), true)
    assert_eq(valid.contains("MODE REPLAY"), true)
    assert_eq(valid.contains("FIXED PROFILE PACKAGE"), true)
    assert_eq(valid.contains("FIXED PROFILE SOURCES"), true)
    assert_eq(valid.contains("OPTIONAL ATOM COMPARISON"), true)
    assert_eq(valid.contains("UNTRUSTED PROPOSAL"), true)
    assert_eq(valid.contains("DECLARED SUPPORT"), true)
    assert_eq(valid.contains("HEES-DERIVED VERIFIER MANIFEST"), true)
    assert_eq(valid.contains("HEES-CLASSIFIED NON-AUTHORITATIVE FINDINGS"), true)
    assert_eq(valid.contains("SPECTRUM ADMITTED"), true)
    assert_eq(valid.contains("CONTENT DNA present"), true)
    assert_eq(valid.contains("RECEIPT present"), true)
    assert_eq(valid.contains("NON-AUTHORITATIVE EXECUTION TRACE"), true)
    assert_eq(valid.contains("replay_integrity=verified"), true)
    assert_eq(valid.contains("What order should I use"), false)
    assert_eq(valid.contains("Lantern Path is a fictional"), false)
    escape = assert_is_ok(ControlPayload.from_json("{\"value\":\"\\u001b\"}"))
    assert_eq(valid.contains(escape.value), false)
    for slug, reason in [("undeclared-action", "unknown_action"), ("unknown-evidence", "unknown_evidence"), ("unknown-memory", "unknown_memory"), ("non-admitted-memory", "memory_not_admitted")]:
        output = render_headless(assert_decision(slug, false, reason))
        assert_eq(output.contains("SPECTRUM REJECTED"), true)
        assert_eq(output.contains(f"reason={reason}"), true)


def test_state_transitions_wrap_and_select_scenarios_and_inspectors() -> None:
    """Exercise deterministic state commands without terminal I/O."""

    states = [true, false, false, false, false]
    mut state = initial_state()
    assert_eq(selected_scenario_slug(state), "valid")
    assert_eq(selected_inspector_name(state), "PACKAGE")
    assert_eq(state.surface, "profiles")
    state = apply_command(state, "previous-scenario", states)
    assert_eq(selected_scenario_slug(state), "non-admitted-memory")
    state = apply_command(state, "next-scenario", states)
    assert_eq(selected_scenario_slug(state), "valid")
    state = apply_command(state, "scenario-3", states)
    assert_eq(selected_scenario_slug(state), "unknown-evidence")
    state = apply_command(state, "scenario-5", states)
    assert_eq(selected_scenario_slug(state), "non-admitted-memory")
    state = apply_command(state, "previous-inspector", states)
    assert_eq(state.surface, "decisions")
    assert_eq(selected_inspector_name(state), "TRACE")
    state = apply_command(state, "next-inspector", states)
    assert_eq(selected_inspector_name(state), "PACKAGE")
    state = apply_command(state, "toggle-sidebar", states)
    assert_eq(state.sidebar_collapsed, true)
    state = apply_command(state, "quit", states)
    assert_eq(state.running, false)


def test_interaction_filters_compose_status_free_text_and_tags() -> None:
    """Keep filtering presentation-only while composing every control deterministically."""

    states = [true, false, false, false, false]
    mut state = initial_state()
    state = apply_command(state, "show-interactions", states)
    state = apply_command(state, "open-status", states)
    state = apply_command(state, "toggle-option", states)
    assert_eq(visible_scenario_indexes(state, states), [1, 2, 3, 4])
    state = apply_command(state, "close-control", states)
    state = apply_command(state, "open-search", states)
    for character in ["text:m", "text:e", "text:m", "text:o", "text:r", "text:y"]:
        state = apply_command(state, character, states)
    assert_eq(visible_scenario_indexes(state, states), [3, 4])
    state = apply_command(state, "backspace", states)
    state = apply_command(state, "clear-search", states)
    state = apply_command(state, "next-option", states)
    state = apply_command(state, "toggle-option", states)
    assert_eq(state.selected_tags, ["adversarial"])
    assert_eq(visible_scenario_indexes(state, states), [1, 2, 3, 4])

    mut empty = initial_state()
    empty = apply_command(empty, "show-interactions", states)
    empty = apply_command(empty, "open-status", states)
    empty = apply_command(empty, "toggle-option", states)
    empty = apply_command(empty, "next-option", states)
    empty = apply_command(empty, "toggle-option", states)
    empty = apply_command(empty, "close-control", states)
    no_visible_scenarios: list[int] = []
    assert_eq(visible_scenario_indexes(empty, states), no_visible_scenarios)
    empty = apply_command(empty, "next-inspector", states)
    assert_eq(empty.surface, "interactions")


def test_default_demo_probes_missing_lantern_evidence_without_replacing_active_authority() -> None:
    """Unstage Lantern evidence, probe the exact rejection, and preserve shipped authority."""

    states = [true, false, false, false, false]
    mut state = initial_state()
    assert_eq(state.surface, "profiles")
    assert_eq(state.active_profile_id, "console_profile_0_1")
    assert_eq(len(state.candidate_evidence_ids), 4)
    assert_eq(len(state.candidate_memory_ids), 4)

    state = apply_command(state, "show-evidence", states)
    assert_eq(state.evidence_index, 0)
    state = apply_command(state, "toggle-staged", states)
    assert_eq(state.candidate_evidence_ids.contains("evidence_lantern_path"), false)
    assert_eq(state.candidate_probe_state, "not_checked")

    state = apply_command(state, "show-memory", states)
    assert_eq(len(state.candidate_memory_ids), 4)
    state = apply_command(state, "probe-candidate", states)
    assert_eq(state.candidate_probe_state, "probe_rejected")
    assert_eq(state.candidate_probe_reason, "invalid_package")
    assert_eq(state.candidate_probe_diagnostic, "invalid_package_atoms")
    assert_eq(state.candidate_identity_valid, true)
    assert_eq(state.candidate_artifact_digest.starts_with("sha256:"), true)
    probe = assert_is_ok(probe_candidate_scenario(state.candidate_evidence_ids, state.candidate_memory_ids))
    assert_eq(probe.baseline_artifact_digest == probe.candidate_artifact_digest, false)
    assert_eq(probe.candidate_identity_valid, true)
    assert_eq(probe.diagnostic, "invalid_package_atoms")
    assert_eq(
        render_screen_for_size(state, [assert_is_ok(evaluate_offline_scenario("valid"))], 160, 44).contains(
            "invalid_package_atoms",
        ),
        true,
    )
    assert_eq(state.active_profile_id, "console_profile_0_1")

    state = apply_command(state, "attempt-activate", states)
    assert_eq(state.candidate_activation_state, "blocked_requires_authority_api")
    assert_eq(state.active_profile_id, "console_profile_0_1")

    state = apply_command(state, "reset-candidate", states)
    assert_eq(len(state.candidate_evidence_ids), 4)
    assert_eq(len(state.candidate_memory_ids), 4)
    state = apply_command(state, "probe-candidate", states)
    assert_eq(state.candidate_probe_state, "probe_admitted")
    assert_eq(state.candidate_probe_reason, "admitted")
    assert_eq(
        render_screen_for_size(state, [assert_is_ok(evaluate_offline_scenario("valid"))], 160, 44).contains(
            "✓ PROBE ADMITTED",
        ),
        true,
    )


def test_probe_infrastructure_error_is_not_presented_as_a_hees_result() -> None:
    """Reserve probe admission or rejection for decoded Hees results and label failures separately."""

    states = [true, false, false, false, false]
    mut state = initial_state()
    state.candidate_evidence_ids = ["evidence_outside_fixed_profile"]
    state = apply_command(state, "probe-candidate", states)
    assert_eq(state.candidate_probe_state, "probe_error")
    assert_eq(state.candidate_probe_reason, "candidate_probe_input_invalid")
    screen = render_screen_for_size(state, [assert_is_ok(evaluate_offline_scenario("valid"))], 160, 44)
    assert_eq(screen.contains("! PROBE ERROR"), true)
    assert_eq(screen.contains("PROBE REJECTED"), false)


def test_closed_profile_catalogs_exactly_match_the_embedded_package() -> None:
    """Fail on drift between bounded session state and the package-owned atom identities."""

    run = assert_is_ok(evaluate_offline_scenario("valid"))
    package_evidence_ids = [atom.evidence_id for atom in run.scenario.package.atoms]
    package_memory_ids = [atom.memory_id for atom in run.scenario.package.atoms]
    assert_eq(candidate_evidence_catalog(), package_evidence_ids)
    assert_eq(candidate_memory_catalog(), package_memory_ids)


def test_product_destinations_and_profile_controls_have_direct_keys() -> None:
    """Expose the evidence-first product workflow as real deterministic navigation."""

    states = [true, false, false, false, false]
    mut state = initial_state()
    for command, surface in [("show-profiles", "profiles"), ("show-evidence", "evidence"), ("show-memory", "memory"), ("show-committee", "committee"), ("show-interactions", "interactions"), ("show-decisions", "decisions"), ("show-help", "help")]:
        state = apply_command(state, command, states)
        assert_eq(state.surface, surface)
    assert_eq(command_for_byte(49), "show-profiles")
    assert_eq(command_for_byte(50), "show-evidence")
    assert_eq(command_for_byte(51), "show-memory")
    assert_eq(command_for_byte(52), "show-committee")
    assert_eq(command_for_byte(53), "show-interactions")
    assert_eq(command_for_byte(54), "show-decisions")
    assert_eq(command_for_byte(55), "show-help")
    assert_eq(command_for_byte(32), "toggle-staged")
    assert_eq(command_for_byte(118), "probe-candidate")
    assert_eq(command_for_byte(114), "reset-candidate")
    assert_eq(command_for_byte(97), "attempt-activate")


