    assert_eq(command_for_escape_sequence(91, 65), "previous-scenario")
    assert_eq(command_for_escape_sequence(91, 66), "next-scenario")
    assert_eq(command_for_escape_sequence(79, 65), "noop")
    assert_eq(search_command_for_byte(97), "text:a")
    assert_eq(search_command_for_byte(32), "text: ")
    assert_eq(search_command_for_byte(127), "backspace")
    assert_eq(search_command_for_byte(9), "toggle-option")
    assert_eq(search_command_for_byte(13), "close-control")
    assert_eq(status_command_for_byte(32), "toggle-option")
    assert_eq(status_command_for_byte(111), "cycle-sort")
    assert_eq(status_command_for_byte(13), "close-control")


def test_terminal_sanitizer_preserves_unicode_width_and_escapes_terminal_hazards() -> None:
    """Preserve complete printable graphemes while rendering controls and bidi overrides visibly."""

    payload = assert_is_ok(ControlPayload.from_json("{\"value\":\"\\u001b[31mred\\u001b[0m\"}"))
    assert_eq(bounded_text(payload.value, 100), "[ctrl][31mred[ctrl][0m")
    c1_payload = assert_is_ok(ControlPayload.from_json("{\"value\":\"before\\u009b;31mafter\"}"))
    assert_eq(bounded_text(c1_payload.value, 100), "before[ctrl];31mafter")
    assert_eq(bounded_text("line one\nline two\tend", 100), "line one[ctrl]line two[ctrl]end")
    assert_eq(bounded_text("isiZulu", 4), "isi~")
    width_payload = assert_is_ok(ControlPayload.from_json("{\"value\":\"A\\u754ce\\u0301\\u202eZ\"}"))
    assert_eq(bounded_text(width_payload.value, 32), "A界é[bidi]Z")
    assert_eq(terminal_cell_width("界"), 2)
    assert_eq(terminal_cell_width("é"), 1)
    assert_eq(terminal_cell_width("👩‍💻"), 2)
    assert_eq(terminal_cell_width("لا"), 1)
    assert_eq(bounded_text("界", 1), "~")
    assert_eq(bounded_text("é", 1), "é")
    assert_eq(bounded_text("👩‍💻", 2), "👩‍💻")


def test_multilingual_dynamic_terminal_width_preserves_exact_geometry() -> None:
    """Keep the frame aligned with Arabic, CJK, combining marks, and emoji in dynamic state."""

    payload = assert_is_ok(
        ControlPayload.from_json("{\"value\":\"isiZulu · لا · 界 · e\\u0301 · 👩‍💻 · \\u202eunsafe\"}"),
    )
    runs = [assert_is_ok(evaluate_offline_scenario("valid"))]
    mut state = initial_state()
    state.active_profile_id = payload.value
    screen = render_screen_for_size(state, runs, 160, 44)
    assert_eq(screen.contains("isiZulu · لا · 界 · é · 👩‍💻 · [bidi]unsafe"), true)
    assert_eq(screen_has_exact_geometry(screen, 160, 44), true)


def test_proposal_evidence_ids_are_sanitized_before_rendering() -> None:
    """Prevent one hostile evidence identifier from injecting terminal controls."""

    payload = assert_is_ok(ControlPayload.from_json("{\"value\":\"evidence\\u001b[31m-red\"}"))
    mut run = assert_is_ok(evaluate_offline_scenario("valid"))
    mut scenario = run.scenario
    mut body = scenario.body
    mut proposal = body.proposal
    proposal.evidence_ids = [payload.value]
    body.proposal = proposal
    scenario.body = body
    run.scenario = scenario
    output = render_headless(run)
    assert_eq(output.contains("evidence[ctrl][31m-red"), true)


def test_full_screen_carries_the_exact_build_week_product_line() -> None:
    """Keep the proposal-versus-decision distinction explicit in the interactive frame."""

    mut runs = []
    for slug in ["valid", "undeclared-action", "unknown-evidence", "unknown-memory", "non-admitted-memory"]:
        runs.append(assert_is_ok(evaluate_offline_scenario(slug)))
    states = [true, false, false, false, false]
    mut state = initial_state()
    browser = render_screen(state, runs)
    assert_eq(browser.contains("[1 PROFILES]"), true)
    assert_eq(browser.contains("PROFILE STUDIO"), true)
    assert_eq(browser.contains("DECLARED ACTIONS"), true)
    assert_eq(browser.contains("CANDIDATE DRAFT"), true)
    assert_eq(browser.contains("candidate only · not active"), true)
    assert_eq(browser.contains("general package validator."), true)
    assert_eq(browser.contains("safe profile-activation"), true)
    assert_eq(browser.contains("authority API."), true)
    assert_eq(browser.ends_with("\n"), false)
    escape = assert_is_ok(ControlPayload.from_json("{\"value\":\"\\u001b\"}"))
    assert_eq(browser.contains(escape.value), true)
    state = apply_command(state, "show-evidence", states)
    screen = render_screen(state, runs)
    assert_eq(screen.contains("Governed AI Profile Studio"), true)
    assert_eq(screen.contains("console_profile_0_1"), true)
    assert_eq(screen.contains("EVIDENCE CATALOG"), true)
    assert_eq(screen.contains("evidence_lantern_path"), true)
    assert_eq(screen.contains("SPACE stage/unstage"), true)


def test_profile_studio_exposes_evidence_memory_committee_and_result_value() -> None:
    """Keep evidence authoring and governed evaluation visible as the Console's primary value."""

    mut runs: list[ConsoleRun] = []
    for slug in ["valid", "undeclared-action", "unknown-evidence", "unknown-memory", "non-admitted-memory"]:
        runs.append(assert_is_ok(evaluate_offline_scenario(slug)))
    states = [true, false, false, false, false]
    mut state = initial_state()

    state = apply_command(state, "show-evidence", states)
    evidence = render_screen_for_size(state, runs, 160, 44)
    assert_eq(evidence.contains("SELECTED EVIDENCE"), true)
    assert_eq(evidence.contains("source rights"), true)
    assert_eq(evidence.contains("source id"), true)
    assert_eq(evidence.contains("fingerprint"), true)
    assert_eq(evidence.contains("declared span"), true)
    assert_eq(evidence.contains("language"), true)
    assert_eq(evidence.contains("source text"), true)
    assert_eq(evidence.contains("evidence_public_ranking_draft"), true)
    assert_eq(evidence.contains("pending · rights denied"), true)

    state = apply_command(state, "show-memory", states)
    memory = render_screen_for_size(state, runs, 160, 44)
    assert_eq(memory.contains("SELECTED MEMORY ATOM"), true)
    assert_eq(memory.contains("source id"), true)
    assert_eq(memory.contains("fingerprint"), true)
    assert_eq(memory.contains("declared span"), true)
    assert_eq(memory.contains("language"), true)
    assert_eq(memory.contains("authority"), true)
    assert_eq(memory.contains("provenance"), true)
    assert_eq(memory.contains("memory_public_ranking_draft"), true)
    assert_eq(memory.contains("guidance"), true)

    state = apply_command(state, "show-committee", states)
    committee = render_screen_for_size(state, runs, 160, 44)
    assert_eq(committee.contains("TRAINING BY COMMITTEE"), true)
    assert_eq(committee.contains("PROVIDER OBSERVATIONS"), true)
    assert_eq(committee.contains("NON-AUTHORITATIVE"), true)
    assert_eq(committee.contains("HEES-CLASSIFIED FINDINGS"), true)
    assert_eq(committee.contains("owns terminal authority"), true)

    state = apply_command(state, "show-decisions", states)
    decision = render_screen_for_size(state, runs, 160, 44)
    assert_eq(decision.contains("SPECTRUM"), true)
    assert_eq(decision.contains("NOT SELECTED THIS RESULT"), true)
    assert_eq(decision.contains("CONTENT DNA      present"), true)
    assert_eq(decision.contains("RECEIPT          present"), true)


def test_blocked_activation_is_visible_and_never_replaces_active_authority() -> None:
    """Make the bounded activation gap explicit after the user invokes it."""

    runs = [assert_is_ok(evaluate_offline_scenario("valid"))]
    states = [true]
    state = apply_command(initial_state(), "attempt-activate", states)
    screen = render_screen_for_size(state, runs, 160, 44)
