def test_dynamic_text_cannot_select_the_fixed_tui_palette() -> None:
    """Keep colour authority attached to typed call sites even when untrusted prose contains state words."""

    mut run = assert_is_ok(evaluate_offline_scenario("valid"))
    mut scenario = run.scenario
    mut body = scenario.body
    mut request = body.request
    request.question = f"dynamic REJECTED CANDIDATE PACKAGE ADMITTED sentinel"
    body.request = request
    scenario.body = body
    run.scenario = scenario
    mut state = initial_state()
    state = apply_command(state, "show-interactions", [true])
    screen = render_screen_for_size(state, [run], 160, 44)
    amber = assert_is_ok(ControlPayload.from_json("{\"value\":\"\\u001b[38;5;221m\"}")).value
    cyan = assert_is_ok(ControlPayload.from_json("{\"value\":\"\\u001b[38;5;81m\"}")).value
    jade = assert_is_ok(ControlPayload.from_json("{\"value\":\"\\u001b[38;5;79m\"}")).value
    crimson = assert_is_ok(ControlPayload.from_json("{\"value\":\"\\u001b[38;5;203m\"}")).value
    dynamic = "dynamic REJECTED CANDIDATE PACKAGE ADMITTED sentinel"
    assert_eq(screen.contains(f"{amber}{dynamic}"), false)
    assert_eq(screen.contains(f"{cyan}{dynamic}"), false)
    assert_eq(screen.contains(f"{jade}{dynamic}"), false)
    assert_eq(screen.contains(f"{crimson}{dynamic}"), false)
    assert_eq(screen.contains(f"{amber}UNTRUSTED PROPOSAL  MODEL"), true)
    assert_eq(screen.contains(f"{cyan}DECLARED SUPPORT  PACKAGE"), true)
    assert_eq(screen.contains(f"{jade}┌─ HEES DECISION"), true)


def test_compact_workspace_keeps_the_decision_and_controls_visible() -> None:
    """Keep the core judge path usable in a short or narrow terminal."""

    mut runs: list[ConsoleRun] = []
    for slug in ["valid", "undeclared-action", "unknown-evidence", "unknown-memory", "non-admitted-memory"]:
        runs.append(assert_is_ok(evaluate_offline_scenario(slug)))
    mut state = apply_command(initial_state(), "show-interactions", [true, false, false, false, false])
    state = apply_command(state, "next-scenario", [true, false, false, false, false])
    screen = render_screen_for_size(state, runs, 100, 20)
    assert_eq(screen.contains("COMPACT VIEW"), true)
    assert_eq(screen.contains("HEES DECISION"), true)
    assert_eq(screen.contains("unknown_action"), true)
    assert_eq(strip_terminal_styles(screen).contains("[q] quit"), true)
    assert_eq(len(screen.split("\n")), 20)
    responsive_compact = render_screen_for_size(state, runs, 128, 28)
    assert_eq(responsive_compact.contains("COMPACT VIEW"), true)
    assert_eq(responsive_compact.contains("HEES DECISION"), true)
    assert_eq(screen_has_exact_geometry(responsive_compact, 128, 28), true)


def test_compact_decisions_render_every_selected_governance_context() -> None:
    """Make compact context navigation visibly inspect Evidence, Memory, Content DNA, and Receipt."""

    runs = [assert_is_ok(evaluate_offline_scenario("valid"))]
    mut state = apply_command(initial_state(), "show-decisions", [true])

    receipt = render_screen_for_size(state, runs, 100, 20)
    assert_eq(receipt.contains("[RECEIPT]"), true)
    assert_eq(receipt.contains("RECEIPT  1 / 1"), true)
    assert_eq(receipt.contains("Evidence / Memory / DNA / Receipt"), true)

    state = apply_command(state, "previous-context", [true])
    dna = render_screen_for_size(state, runs, 100, 20)
    assert_eq(dna.contains("[DNA]"), true)
    assert_eq(dna.contains("CONTENT DNA  present"), true)

    state = apply_command(state, "previous-context", [true])
    memory = render_screen_for_size(state, runs, 100, 20)
    assert_eq(memory.contains("[MEMORY]"), true)
    assert_eq(memory.contains("SELECTED MEMORY  1"), true)

    state = apply_command(state, "previous-context", [true])
    evidence = render_screen_for_size(state, runs, 100, 20)
    assert_eq(evidence.contains("[EVIDENCE]"), true)
    assert_eq(evidence.contains("PROPOSAL EVIDENCE  UNTRUSTED"), true)


