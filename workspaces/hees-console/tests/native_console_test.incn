    """Keep raw terminal decoding deterministic without crossterm event metadata."""

    assert_eq(command_for_byte(49), "show-profiles")
    assert_eq(command_for_byte(52), "show-committee")
    assert_eq(command_for_byte(53), "show-interactions")
    assert_eq(command_for_byte(54), "show-decisions")
    assert_eq(command_for_byte(55), "show-help")
    assert_eq(command_for_byte(98), "toggle-sidebar")
    assert_eq(command_for_byte(103), "show-interactions")
    assert_eq(command_for_byte(47), "open-search")
    assert_eq(command_for_byte(115), "open-status")
    assert_eq(command_for_byte(104), "previous-context")
    assert_eq(command_for_byte(108), "next-context")
    assert_eq(command_for_byte(107), "previous-scenario")
    assert_eq(command_for_byte(106), "next-scenario")
    assert_eq(command_for_byte(9), "next-context")
    assert_eq(command_for_byte(13), "open-inspector")
    assert_eq(command_for_byte(113), "quit")
    assert_eq(command_for_byte(0), "noop")
    assert_eq(command_for_escape_sequence(91, 68), "previous-context")
