def test_live_single_run_receipt_uses_the_actual_collection_total() -> None:
    """Render one evaluated live interaction as receipt 1 of 1 rather than a replay-suite constant."""

    run = assert_is_ok(
        evaluate_live_with_transports(
            "What order should I use for the Lantern Path cards?",
            valid_live_proposal_transport,
            committee_transport,
        ),
