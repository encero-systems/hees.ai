@derive(Clone, json)
model PackageSourceProjection:
    """JSON-value wrapper used to decode the embedded package through one typed envelope."""

    package: JsonValue


@derive(Clone, json)
model TypedPackageProjection:
    """Typed package decoded without invoking an external type's serde trait directly."""

    package: ConsolePackage


@derive(Clone, json)
model PartialPackageInspectionProjection:
    """Serde projection of only the package fields needed by the presentation layer."""

    contract_version: str
    profile_id: str
    package_id: str
    domain_id: str
    package_revision: str
    artifact_digest: str
    mission: str
