    actions: list[ActionInspectionProjection]
    requirements: list[RequirementInspectionProjection]
    atoms: list[MemoryAtomProjection]
    policy: PolicyInspectionProjection


@derive(Clone, json)
model PackageInspectionEnvelope:
    """Local wrapper used to project an external public package type safely."""

    package: PartialPackageInspectionProjection


@derive(Clone, json)
model ProviderProposalProjection:
    """Untrusted proposal envelope returned by the native provider module."""

    contract_version: str
    profile_id: str
    proposal: ConsoleProposal


def decode_authority_input(scenario: OfflineScenario) -> Result[HeesAuthorityInput, str]:
    """Decode the fixed package and replay values together without reconstructing either contract."""

    package = JsonValue.parse(scenario.package_source).map_err((_error) => f"invalid_package_input")?
    projection = AuthorityInputProjection(
        package=package,
        request=scenario.body.request,
        proposal=scenario.body.proposal,
        relation_observations=scenario.body.relation_observations,
        synthesis_observations=scenario.body.synthesis_observations,
    )
    return HeesAuthorityInput.from_json(projection.to_json()).map_err((_error) => f"invalid_authority_input")


def decode_embedded_package() -> Result[ConsolePackage, str]:
    """Decode the embedded fictional package through a local derived envelope."""

    value = JsonValue.parse(package_json()).map_err((_error) => f"live_package_invalid")?
    source = PackageSourceProjection(package=value).to_json()
    projection = TypedPackageProjection.from_json(source).map_err((_error) => f"live_package_invalid")?
    return Ok(projection.package)


def package_inspection(package: ConsolePackage) -> Result[PackageInspectionProjection, str]:
    """Create the local package inspector projection without reconstructing package authority."""

    source = TypedPackageProjection(package=package).to_json()
    envelope = PackageInspectionEnvelope.from_json(source).map_err((_error) => f"package_inspection_failed")?
    package_view = envelope.package
    return Ok(
        PackageInspectionProjection(
            contract_version=package_view.contract_version,
            profile_id=package_view.profile_id,
            package_id=package_view.package_id,
            domain_id=package_view.domain_id,
            package_revision=package_view.package_revision,
            artifact_digest=package_view.artifact_digest,
            mission=package_view.mission,
            sources=package_view.sources,
            actions=package_view.actions,
            requirements=package_view.requirements,
            atoms=package_view.atoms,
            policy=package_view.policy,
            action_count=len(package_view.actions),
            requirement_count=len(package_view.requirements),
            atom_count=len(package_view.atoms),
        ),
    )


pub def probe_candidate_scenario(evidence_ids: list[str], memory_ids: list[str]) -> Result[CandidateScenarioProbe, str]:
    """Run the shipped valid scenario with one session candidate through the real Hees path."""

    scenario = load_offline_scenario("valid")?
    inputs = decode_authority_input(scenario)?
    mut package = inputs.package
    baseline_artifact_digest = digest_id_type_text(package.artifact_digest)
    package_evidence_ids = [evidence_id_text(atom.evidence_id) for atom in package.atoms]
    package_memory_ids = [memory_id_text(atom.memory_id) for atom in package.atoms]
    for evidence_id in evidence_ids:
        if not package_evidence_ids.contains(evidence_id):
            return Err("candidate_probe_input_invalid")
    for memory_id in memory_ids:
        if not package_memory_ids.contains(memory_id):
            return Err("candidate_probe_input_invalid")
    package.atoms = [atom for atom in package.atoms if memory_ids.contains(memory_id_text(atom.memory_id)) and evidence_ids.contains(
        evidence_id_text(atom.evidence_id),
    )]
    retained_atom_count = len(package.atoms)
    package = compile_console_package_candidate(package)
    candidate_artifact_digest = digest_id_type_text(package.artifact_digest)
    candidate_identity_valid = console_package_artifact_identity_is_valid(package)
    if not candidate_identity_valid:
        return Err("candidate_identity_invalid")
    package_diagnostic = console_package_candidate_diagnostic(package)
    source = evaluate_console_profile_json(
        package,
        inputs.request,
        inputs.proposal,
        inputs.relation_observations,
        inputs.synthesis_observations,
    )
    result = CompleteProfileProjection.from_json(source).map_err((_error) => f"candidate_probe_projection_failed")?
    mut diagnostic = result.spectrum.reason
    if package_diagnostic != "ok":
        diagnostic = package_diagnostic
    return Ok(
        CandidateScenarioProbe(
            admitted=result.spectrum.admitted,
            reason=result.spectrum.reason,
            diagnostic=diagnostic,
            retained_atom_count=retained_atom_count,
            baseline_artifact_digest=baseline_artifact_digest,
            candidate_artifact_digest=candidate_artifact_digest,
            candidate_identity_valid=candidate_identity_valid,
        ),
    )


def decode_live_plan(source: str) -> Result[LiveQuestionPlan, str]:
    """Decode one private live plan and reject contract or profile drift."""

    plan = LiveQuestionPlan.from_json(source).map_err((_error) => f"live_plan_invalid")?
    if plan.contract_version != LIVE_PLAN_CONTRACT or plan.profile_id != CONSOLE_PROFILE:
        return Err("live_plan_invalid")
    return Ok(plan)


def decode_provider_proposal(source: str) -> Result[ProviderProposalProjection, str]:
    """Decode one untrusted provider proposal envelope and reject boundary drift."""

    projection = ProviderProposalProjection.from_json(source).map_err((_error) => f"live_proposal_invalid")?
    if projection.contract_version != PROPOSAL_RESULT_CONTRACT or projection.profile_id != CONSOLE_PROFILE:
        return Err("live_proposal_invalid")
    return Ok(projection)


def decode_provider_committee(source: str) -> Result[ProviderCommitteeProjection, str]:
    """Decode one non-authoritative committee envelope and reject boundary drift."""

    projection = ProviderCommitteeProjection.from_json(source).map_err((_error) => f"live_committee_invalid")?
    if projection.contract_version != COMMITTEE_RESULT_CONTRACT or projection.profile_id != CONSOLE_PROFILE:
        return Err("live_committee_invalid")
    return Ok(projection)


def unique_append(values: list[str], value: str) -> list[str]:
    """Append one trace identity only when it is not already present."""

    mut result = values
    if not result.contains(f"{value}"):
        result.append(value)
    return result


def trace_provider_id(mode: str) -> str:
    """Return the disclosed provider identity for the selected execution mode."""

    if mode == "LIVE":
        return "openai"
    return "fixture"


def trace_projection(interaction: ConsoleInteraction, result: CompleteProfileProjection) -> ConsoleTraceProjection:
    """Project bounded operator identities without creating or altering authority."""

    relation_ids = [observation.observation_id for observation in interaction.body.relation_observations]
    synthesis_ids = [observation.observation_id for observation in interaction.body.synthesis_observations]
    finding_ids = [finding.finding_id for finding in result.findings]
    mut model_fingerprints: list[str] = []
    mut prompt_fingerprints: list[str] = []
    mut configuration_fingerprints: list[str] = []
    for observation in interaction.body.relation_observations:
        model_fingerprints = unique_append(model_fingerprints, observation.model_fingerprint)
        prompt_fingerprints = unique_append(prompt_fingerprints, observation.prompt_fingerprint)
        configuration_fingerprints = unique_append(configuration_fingerprints, observation.configuration_fingerprint)
    for observation in interaction.body.synthesis_observations:
        model_fingerprints = unique_append(model_fingerprints, observation.model_fingerprint)
        prompt_fingerprints = unique_append(prompt_fingerprints, observation.prompt_fingerprint)
        configuration_fingerprints = unique_append(configuration_fingerprints, observation.configuration_fingerprint)
    return ConsoleTraceProjection(
        contract_version="console_trace_0_1",
        profile_id="console_profile_0_1",
        build_identity="hees_console_0_1_0",
        toolchain_identity=CONSOLE_TOOLCHAIN_IDENTITY,
        runner_identity="hees_0_0_1_console_profile_0_1",
        mode=interaction.mode,
        input_id=interaction.input_id,
        provider_id=trace_provider_id(f"{interaction.mode}"),
        proposal_id=interaction.body.proposal.proposal_id,
        schema_digests=interaction.body.schema_digests,
        relation_observation_ids=relation_ids,
        synthesis_observation_ids=synthesis_ids,
        finding_ids=finding_ids,
        model_fingerprints=model_fingerprints,
        prompt_fingerprints=prompt_fingerprints,
        configuration_fingerprints=configuration_fingerprints,
    )


def evaluate_inputs(interaction: ConsoleInteraction, inputs: HeesAuthorityInput) -> Result[ConsoleRun, str]:
    """Call the terminal Hees profile once and decode only its complete public projection."""

    source = evaluate_console_profile_json(
        inputs.package,
        inputs.request,
        inputs.proposal,
        inputs.relation_observations,
        inputs.synthesis_observations,
    )
    result = CompleteProfileProjection.from_json(source).map_err((_error) => f"evaluation_projection_failed")?
    trace = trace_projection(interaction, result)
    return Ok(ConsoleRun(scenario=interaction, result=result, trace=trace))


pub def evaluate_offline_scenario(slug: str) -> Result[ConsoleRun, str]:
    """Evaluate one embedded input through the real public Hees profile exactly once."""

    if not embedded_inputs_are_non_terminal():
        return Err("embedded_terminal_result")
    scenario = load_offline_scenario(slug)?
    inputs = decode_authority_input(scenario)?
    inspection = package_inspection(inputs.package)?
    replay_interaction = ConsoleInteraction(
        mode="OFFLINE",
        slug=scenario.slug,
        title=scenario.title,
        input_id=scenario.replay_id,
        package=inspection,
        body=scenario.body,
    )
    return evaluate_inputs(replay_interaction, inputs)


pub def evaluate_live_interaction(
    package: ConsolePackage,
    request: ConsoleRequestBinding,
    proposal: ConsoleProposal,
    relation_observations: list[RelationObservation],
    synthesis_observations: list[SynthesisObservation],
) -> Result[ConsoleRun, str]:
    """Evaluate live untrusted inputs while preserving the replay inspector's non-terminal shape."""

    projection = InteractionBodyProjection(
        contract_version="console_live_input_0_1",
        profile_id="console_profile_0_1",
        scenario_id="live_question",
        request=request,
        proposal=proposal,
        relation_observations=relation_observations,
        synthesis_observations=synthesis_observations,
        schema_digests=profile_schema_digests(),
    )
    body = ReplayBody.from_json(projection.to_json()).map_err((_error) => f"live_projection_failed")?
    inspection = package_inspection(package)?
    live_interaction = ConsoleInteraction(
        mode="LIVE",
        slug="live",
        title="Live GPT-5.6 proposal",
        input_id=proposal_id_text(proposal.proposal_id),
        package=inspection,
        body=body,
    )
    inputs = HeesAuthorityInput(
        package=package,
        request=request,
        proposal=proposal,
        relation_observations=relation_observations,
        synthesis_observations=synthesis_observations,
    )
    return evaluate_inputs(live_interaction, inputs)


pub def plan_live_question_json(question: str) -> Result[str, str]:
    """Bind one question and return only the inputs required by native live composition."""

    package = decode_embedded_package()?
    source = bind_console_request_json("request_live_console", question)
    plan = LiveRequestPlan.from_json(source).map_err((_error) => f"live_request_plan_invalid")?
    if not plan.plannable:
        return Err("live_request_not_plannable")
    match plan.request:
        None => return Err("live_request_not_plannable")
        Some(request) =>
            context_plan_json = plan_console_provider_context_json(package, request)
            return Ok(
                LiveQuestionPlan(
                    contract_version=LIVE_PLAN_CONTRACT,
                    profile_id=CONSOLE_PROFILE,
                    package=package,
                    request=request,
                    context_plan_json=context_plan_json,
                ).to_json(),
            )


pub def live_context_plan_json(live_plan_json: str) -> Result[str, str]:
    """Read the exact Hees-authored provider context from one private live plan."""

    plan = decode_live_plan(live_plan_json)?
    return Ok(plan.context_plan_json)


pub def plan_live_manifest_from_json(live_plan_json: str, proposal_json: str) -> Result[str, str]:
    """Plan verifier targets in Hees from typed live inputs and an untrusted proposal source."""

    plan = decode_live_plan(live_plan_json)?
    proposal = decode_provider_proposal(proposal_json)?
    return Ok(plan_console_manifest_json(plan.package, plan.request, proposal.proposal))


pub def evaluate_live_sources(live_plan_json: str, proposal_json: str, committee_json: str) -> Result[ConsoleRun, str]:
    """Decode untrusted provider sources and return their only terminal evaluation to Hees."""

    plan = decode_live_plan(live_plan_json)?
    proposal = decode_provider_proposal(proposal_json)?
    committee = decode_provider_committee(committee_json)?
    return evaluate_live_interaction(
        plan.package,
        plan.request,
        proposal.proposal,
        committee.relations,
        committee.syntheses,
    )
