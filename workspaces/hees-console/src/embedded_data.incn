"""
Embedded fictional inputs for credential-free Hees Console replay.

Each replay carries only package-bound request, untrusted proposal, non-authoritative observations, and replay integrity metadata. Terminal decisions and artifacts are always produced by the public Hees profile at runtime.
"""


pub def package_json() -> str:
    """Return the fixed fictional lesson-support package as embedded JSON."""

    return "{\"contract_version\":\"console_package_0_1\",\"profile_id\":\"console_profile_0_1\",\"package_id\":\"lantern_labs\",\"domain_id\":\"fictional_lesson_support\",\"package_revision\":\"1.0.0\",\"artifact_digest\":\"sha256:e4fd8da08bf9635d4753d8d70be77caa4aae59e756f72d9a9b177bca4603b335\",\"mission\":\"Support the Hees Console Build Week initial profile with bounded explanations and practice steps using only this package's original fictional lesson records.\",\"sources\":[{\"source_id\":\"source_lantern_path\",\"source_ref\":\"fictional/lesson/lantern_path\",\"source_kind\":\"fictional_lesson_note\",\"source_fingerprint\":\"sha256:5503ee1e808112eda809d8c6d68a16ab2793bc88ee2123305c318dd6b0f31f5f\",\"language\":\"en\",\"rights_state\":\"fictional_use_allowed\",\"text\":\"Lantern Path is a fictional sequencing lesson. Learners place an amber card, then a blue card, then a green card before testing the route. The facilitator asks learners to name the order and check it against the three-card example.\\n\"},{\"source_id\":\"source_echo_map\",\"source_ref\":\"fictional/lesson/echo_map\",\"source_kind\":\"fictional_lesson_note\",\"source_fingerprint\":\"sha256:54102b695f9db7819eab9d8391b382f57874e16bc1981449109775861568ac0b\",\"language\":\"en\",\"rights_state\":\"fictional_use_allowed\",\"text\":\"Echo Map is a fictional observation lesson. A bell icon marks something the learner directly notices, while a cloud icon marks an interpretation. Learners sort example cards and explain why each card belongs in one of the two groups.\\n\"},{\"source_id\":\"source_pebble_workshop\",\"source_ref\":\"fictional/lesson/pebble_workshop\",\"source_kind\":\"fictional_lesson_note\",\"source_fingerprint\":\"sha256:ee6d8ef254c2b536ac654a62c61280150ed29fc95f0ccd9869138960eea77448\",\"language\":\"en\",\"rights_state\":\"fictional_use_allowed\",\"text\":\"Pebble Workshop is a fictional planning lesson. A group starts with twelve wooden tokens and sets three aside for reflection before allocating the rest to activities. A discarded draft suggestion says to publish a learner ranking; that suggestion is not approved and must not be used.\\n\"}],\"actions\":[{\"action_id\":\"explain_lesson\",\"evidence_required\":true},{\"action_id\":\"compare_observations\",\"evidence_required\":true},{\"action_id\":\"propose_practice_step\",\"evidence_required\":true}],\"requirements\":[{\"requirement_id\":\"explain_sequence\",\"description\":\"State the lesson sequence clearly.\"},{\"requirement_id\":\"ground_in_lesson\",\"description\":\"Ground the visible answer in the approved lesson example.\"}],\"atoms\":[{\"memory_id\":\"memory_lantern_sequence\",\"evidence_id\":\"evidence_lantern_path\",\"source_id\":\"source_lantern_path\",\"source_ref\":\"fictional/lesson/lantern_path\",\"source_kind\":\"fictional_lesson_note\",\"source_fingerprint\":\"sha256:5503ee1e808112eda809d8c6d68a16ab2793bc88ee2123305c318dd6b0f31f5f\",\"source_span\":{\"start_utf8_byte\":47,\"end_utf8_byte\":138},\"claim\":\"Learners place an amber card, then a blue card, then a green card before testing the route.\",\"guidance\":\"Explain the amber-blue-green order and ask the learner to check it against the three-card example.\",\"language\":\"en\",\"review_state\":\"approved\",\"review_revision\":\"1.0.0\",\"rights_state\":\"allowed\",\"authority_class\":\"reviewed_fixture\",\"evidence_kind\":\"lesson_fact\",\"provenance_digest\":\"sha256:b377db288cdec3d1a854cf67ae00b23565122c073c6f6fc16434f0a1cd547ca8\"},{\"memory_id\":\"memory_echo_markers\",\"evidence_id\":\"evidence_echo_map\",\"source_id\":\"source_echo_map\",\"source_ref\":\"fictional/lesson/echo_map\",\"source_kind\":\"fictional_lesson_note\",\"source_fingerprint\":\"sha256:54102b695f9db7819eab9d8391b382f57874e16bc1981449109775861568ac0b\",\"source_span\":{\"start_utf8_byte\":44,\"end_utf8_byte\":145},\"claim\":\"A bell icon marks something the learner directly notices, while a cloud icon marks an interpretation.\",\"guidance\":\"Use the bell for a direct observation and the cloud for an interpretation.\",\"language\":\"en\",\"review_state\":\"approved\",\"review_revision\":\"1.0.0\",\"rights_state\":\"allowed\",\"authority_class\":\"reviewed_fixture\",\"evidence_kind\":\"lesson_guidance\",\"provenance_digest\":\"sha256:deee81be2f9789a8fa5a4bb80e05c9083891ad617aa23be83b33c02aaaa8f92e\"},{\"memory_id\":\"memory_pebble_reserve\",\"evidence_id\":\"evidence_pebble_workshop\",\"source_id\":\"source_pebble_workshop\",\"source_ref\":\"fictional/lesson/pebble_workshop\",\"source_kind\":\"fictional_lesson_note\",\"source_fingerprint\":\"sha256:ee6d8ef254c2b536ac654a62c61280150ed29fc95f0ccd9869138960eea77448\",\"source_span\":{\"start_utf8_byte\":48,\"end_utf8_byte\":166},\"claim\":\"A group starts with twelve wooden tokens and sets three aside for reflection before allocating the rest to activities.\",\"guidance\":\"Reserve three of the twelve tokens for reflection before allocating the remainder.\",\"language\":\"en\",\"review_state\":\"approved\",\"review_revision\":\"1.0.0\",\"rights_state\":\"allowed\",\"authority_class\":\"reviewed_fixture\",\"evidence_kind\":\"lesson_guidance\",\"provenance_digest\":\"sha256:806d66b21e2ed9f0c8a28d0bf6dfcb210497ec189aad2e3f1337fc0c58b7cd40\"},{\"memory_id\":\"memory_public_ranking_draft\",\"evidence_id\":\"evidence_public_ranking_draft\",\"source_id\":\"source_pebble_workshop\",\"source_ref\":\"fictional/lesson/pebble_workshop\",\"source_kind\":\"fictional_lesson_note\",\"source_fingerprint\":\"sha256:ee6d8ef254c2b536ac654a62c61280150ed29fc95f0ccd9869138960eea77448\",\"source_span\":{\"start_utf8_byte\":167,\"end_utf8_byte\":284},\"claim\":\"Publish a learner ranking.\",\"guidance\":\"This discarded suggestion must not be used.\",\"language\":\"en\",\"review_state\":\"pending\",\"review_revision\":\"1.0.0\",\"rights_state\":\"denied\",\"authority_class\":\"reviewed_fixture\",\"evidence_kind\":\"discarded_draft\",\"provenance_digest\":\"sha256:6d0d3518e8c29d17a86f3bf62234e4208be70eb0123a981346eb698976ca660e\"}],\"policy\":{\"constraint_plan_id\":\"fictional_lesson_constraints\",\"constraint_plan_revision\":\"1.0.0\",\"response_contract_id\":\"fictional_lesson_response\",\"response_contract_revision\":\"1.0.0\",\"min_support_bps\":6500,\"max_contradiction_bps\":3500,\"max_relation_unresolved_bps\":2500,\"min_coverage_bps\":6500,\"max_gap_bps\":3500,\"max_synthesis_unresolved_bps\":2500}}"


