"""
Raw-key terminal boundary for the native Incan Console.

Crossterm supplies only cross-platform raw-mode primitives. Incan owns byte-level key decoding, fixed terminal-control sequences, state transitions, scenario evaluation, rendering, and all application behavior.
"""

from rust::std::io import Read, Write, stdin, stdout
from rust::std::string import String as RustString
from rust::crossterm::terminal import disable_raw_mode, enable_raw_mode, size as terminal_size
from std.environ import get_optional
from evaluation import ConsoleRun, evaluate_offline_scenario
from rendering import render_screen_for_size, without_terminal_styles
from replays import scenario_slugs
from state import ConsoleState, apply_command, initial_inspector_state, initial_state, selected_scenario_slug


pub def command_for_byte(value: int) -> str:
    """Map one ASCII terminal byte to a pure Console state command."""

    if value == 113:
        return "quit"
    if value == 49:
        return "show-profiles"
    if value == 50:
        return "show-evidence"
    if value == 51:
        return "show-memory"
    if value == 52:
        return "show-committee"
    if value == 53:
        return "show-interactions"
    if value == 54:
        return "show-decisions"
    if value == 55:
        return "show-help"
    if value == 32:
        return "toggle-staged"
    if value == 118:
        return "probe-candidate"
    if value == 114:
        return "reset-candidate"
    if value == 97:
        return "attempt-activate"
    if value == 98:
        return "toggle-sidebar"
    if value == 103:
        return "show-interactions"
    if value == 47:
        return "open-search"
    if value == 115:
        return "open-status"
    if value == 104:
        return "previous-context"
    if value == 108:
        return "next-context"
    if value == 107:
        return "previous-scenario"
    if value == 106:
        return "next-scenario"
    if value == 9:
        return "next-context"
    if value == 10 or value == 13:
        return "open-inspector"
    return "noop"


def printable_ascii_character(value: int) -> str:
    """Decode the bounded text vocabulary without moving character policy into Rust."""

    lower = "abcdefghijklmnopqrstuvwxyz"
    upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
    digits = "0123456789"
    if value >= 97 and value <= 122:
        offset = value - 97
        return lower[offset:offset + 1]
    if value >= 65 and value <= 90:
        offset = value - 65
        return upper[offset:offset + 1]
    if value >= 48 and value <= 57:
        offset = value - 48
        return digits[offset:offset + 1]
    if value == 32:
        return " "
    if value == 45:
        return "-"
    if value == 46:
        return "."
    if value == 47:
        return "/"
    if value == 58:
        return ":"
    if value == 63:
        return "?"
    if value == 95:
        return "_"
    return ""


def text_command_for_byte(value: int) -> str:
    """Decode one printable ASCII byte into a bounded search-text command."""

    character = printable_ascii_character(value)
    if character == "":
        return "noop"
    return f"text:{character}"


pub def search_command_for_byte(value: int) -> str:
    """Map raw bytes while the integrated search-and-tags control owns focus."""

    if value == 10 or value == 13:
        return "close-control"
    if value == 8 or value == 127:
        return "backspace"
    if value == 9:
        return "toggle-option"
    if value == 21:
        return "clear-search"
    return text_command_for_byte(value)


pub def status_command_for_byte(value: int) -> str:
    """Map raw bytes while the Status table-column control owns focus."""

    if value == 10 or value == 13:
        return "close-control"
    if value == 9 or value == 32:
        return "toggle-option"
    if value == 111:
        return "cycle-sort"
    if value == 115:
        return "open-status"
    return "noop"


pub def command_for_escape_sequence(second: int, third: int) -> str:
    """Map one complete ANSI cursor-key sequence to a pure Console state command."""

    if second != 91:
        return "noop"
    if third == 68:
        return "previous-context"
    if third == 67:
        return "next-context"
    if third == 65:
        return "previous-scenario"
    if third == 66:
        return "next-scenario"
    return "noop"


def option_command_for_escape_sequence(second: int, third: int) -> str:
    """Map ANSI cursor keys while a bounded filter control owns focus."""

    if second != 91:
        return "noop"
    if third == 65:
        return "previous-option"
    if third == 66:
        return "next-option"
    return "noop"


def read_byte() -> Result[int, str]:
    """Read exactly one raw terminal byte through the portable standard-I/O trait boundary."""

    input = stdin()
    mut buffer: bytes = b""
    match input.take(1).read_to_end(buffer):
        Err(_) => return Err("terminal_read_failed")
        Ok(count) =>
            if count != 1 or len(buffer) != 1:
                return Err("terminal_input_closed")
            return Ok(int(buffer[0]))


def read_command(state: ConsoleState) -> Result[str, str]:
    """Wait for one raw key sequence and return a pure application command."""

    first = read_byte()?
    if first != 27:
        if state.focus == "search":
            return Ok(search_command_for_byte(first))
        if state.focus == "status":
            return Ok(status_command_for_byte(first))
        return Ok(command_for_byte(first))
    second = read_byte()?
    third = read_byte()?
    if state.focus == "search" or state.focus == "status":
        return Ok(option_command_for_escape_sequence(second, third))
    return Ok(command_for_escape_sequence(second, third))


def terminal_sequence(value: bytes) -> str:
    """Decode one fixed ANSI byte sequence at the terminal boundary."""

    match RustString.from_utf8(value):
        Err(_) => return ""
        Ok(value) => return value


def clear_and_home() -> str:
    """Return the fixed ANSI clear-and-home sequence."""

    return terminal_sequence(b"\x1b[2J\x1b[H")


def terminal_dimensions() -> Tuple[int, int]:
    """Read the current terminal viewport with a conservative wide fallback."""

    match terminal_size():
        Err(_) => return (160, 44)
        Ok(dimensions) =>
            columns, rows = dimensions
            return (int(columns), int(rows))


def write_terminal_sequence(value: str) -> Result[None, str]:
    """Write and flush one application-owned terminal sequence without adding a newline."""

    data = RustString.from(value).into_bytes()
    mut out = stdout()
    match out.write_all(data):
        Err(_) => return Err("terminal_write_failed")
        Ok(_) =>
            match out.flush():
                Err(_) => return Err("terminal_flush_failed")
                Ok(_) => return Ok(None)


def enter_terminal_screen() -> Result[None, str]:
    """Enter the alternate screen and hide the cursor with fixed ANSI controls."""

    return write_terminal_sequence(terminal_sequence(b"\x1b[?1049h\x1b[?25l"))


def leave_terminal_screen() -> Result[None, str]:
    """Restore the cursor and leave the alternate screen with fixed ANSI controls."""

    return write_terminal_sequence(terminal_sequence(b"\x1b[?25h\x1b[?1049l"))


def draw_frame(state: ConsoleState, runs: list[ConsoleRun]) -> Result[None, str]:
    """Replace the alternate-screen frame and report write or flush failure without a trailing newline."""

    columns, rows = terminal_dimensions()
    mut frame = render_screen_for_size(state, runs, columns, rows)
    match get_optional("NO_COLOR"):
        Some(_) =>
            frame = without_terminal_styles(frame)
        None => pass
    frame = frame.replace("\n", "\r\n")
    data = RustString.from(f"{clear_and_home()}{frame}").into_bytes()
    mut out = stdout()
    match out.write_all(data):
        Err(_) => return Err("terminal_write_failed")
        Ok(_) =>
            match out.flush():
                Err(_) => return Err("terminal_flush_failed")
                Ok(_) => return Ok(None)


def live_safe_command(command: str) -> str:
    """Suppress replay-only navigation while inspecting one already evaluated live interaction."""

    if command == "next-scenario" or command == "previous-scenario" or command.starts_with("scenario-"):
        return "noop"
    if command == "show-interactions" or command == "open-search" or command == "open-status":
        return "noop"
    return command


def admitted_states(runs: list[ConsoleRun]) -> list[bool]:
    """Project terminal Hees.ai states for presentation-only browser filtering."""

    return [run.result.spectrum.admitted for run in runs]


def run_screen(initial_state: ConsoleState, initial_runs: list[ConsoleRun], allow_scenarios: bool) -> Result[None, str]:
    """Run one full-screen inspector with optional replay scenario switching."""

    mut state = initial_state
    runs = initial_runs
    states = admitted_states(runs)
    enable_raw_mode().map_err((_error) => f"terminal_raw_mode_failed")?
    mut failure: Option[str] = None
    match enter_terminal_screen():
        Err(code) =>
            failure = Some(code)
            state.running = false
        Ok(_) => pass
    if state.running:
        match draw_frame(state, runs):
            Err(code) =>
                failure = Some(code)
                state.running = false
            Ok(_) => pass
    while state.running:
        match read_command(state):
            Err(code) =>
                failure = Some(code)
                state.running = false
            Ok(command) =>
                mut selected_command = command
                if not allow_scenarios:
                    selected_command = live_safe_command(selected_command)
                state = apply_command(state, selected_command, states)
                if state.running:
                    match draw_frame(state, runs):
                        Err(code) =>
                            failure = Some(code)
                            state.running = false
                        Ok(_) => pass
    match leave_terminal_screen():
        Err(code) =>
            match failure:
                Some(_) => pass
                None =>
                    failure = Some(code)
        Ok(_) => pass
    match disable_raw_mode():
        Err(_) =>
            match failure:
                Some(_) => pass
                None =>
                    failure = Some("terminal_restore_failed")
        Ok(_) => pass
    match failure:
        Some(code) => return Err(code)
        None => return Ok(None)


pub def run_interactive(initial_slug: str) -> Result[None, str]:
    """Run the offline raw-key Console from a selected replay until quit or I/O failure."""

    mut state = initial_state()
    slugs = scenario_slugs()
    for index, slug in enumerate(slugs):
        if slug == initial_slug:
            state.scenario_index = index
    mut runs: list[ConsoleRun] = []
    for slug in slugs:
        runs.append(evaluate_offline_scenario(slug)?)
    return run_screen(state, runs, true)


pub def run_evaluated_interactive(run: ConsoleRun) -> Result[None, str]:
    """Inspect one live evaluated interaction without exposing replay navigation."""

    return run_screen(initial_inspector_state(), [run], false)
