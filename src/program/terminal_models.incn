"""
Public contracts for terminal admission of package-declared guided-program operations.

`ProgramAuthorityPackage` carries the reviewed installed-package projection, including the program, source-safe
memory support, profile, and constraint-plan identity. `ProgramInteraction` carries the untrusted learner frame and
action. `ProgramTerminalResult` records the closed Hees decision, while `CompleteProgramEvaluation` is the only
projection an application may use to render an admitted card or inspect its selected memory, Content DNA, and receipt.
"""

from std.serde import json
from crate.identifiers import (
    ConstraintPlanId,
    ContentDnaId,
    ContractId,
    DecisionId,
    DigestIdType,
    DomainId,
    EvidenceId,
    GuidedCardId,
    InputId,
    MemoryId,
    PackageId,
    ProfileId,
    ProgramId,
    RevisionType,
)
from crate.program.models import (
    GuidedProgram,
    ProgramAction,
    ProgramActionKind,
    ProgramMemoryOperation,
    ProgramRuntimeFrame,
)
from crate.runtime import ReviewStatus, RightsStatus


@derive(Clone, Eq, json)
pub enum ProgramTerminalDecision(str):
    """Closed terminal outcome for one guided-program operation."""

    Admit = "admit"
    Reject = "reject"


@derive(Clone, json)
pub model ProgramSupportAtom:
    """Reviewed source-safe memory support that a program card may select."""

    pub memory_id: MemoryId
    pub evidence_id: EvidenceId
    pub source_ref: str
    pub source_kind: str
    pub source_fingerprint: DigestIdType
    pub provenance_digest: DigestIdType
    pub review_status: ReviewStatus
    pub review_revision: RevisionType
    pub rights_status: RightsStatus
    pub authority_class: str
    pub evidence_kind: str


@derive(Clone, json)
pub model ProgramAuthorityPolicy:
    """Package-declared constraint-plan identity for program terminal decisions."""

    pub constraint_plan_id: ConstraintPlanId
    pub constraint_plan_revision: RevisionType


@derive(Clone, json)
pub model ProgramAuthorityPackage:
    """Installed package projection evaluated by the guided-program terminal boundary."""

    pub contract_version: ContractId
    pub profile_id: ProfileId
    pub package_id: PackageId
    pub domain_id: DomainId
    pub package_revision: RevisionType
    pub artifact_digest: DigestIdType
    pub program: GuidedProgram
    pub support_atoms: list[ProgramSupportAtom]
    pub policy: ProgramAuthorityPolicy


@derive(Clone, json)
pub model ProgramInteraction:
    """Untrusted learner operation and context, bound to one caller-supplied input identity."""

    pub input_id: InputId
    pub frame: ProgramRuntimeFrame
    pub action: ProgramAction


@derive(Clone, json)
pub model AdmittedProgramCard:
    """Exact reviewed card projection that an application may render after terminal admission."""

    pub package_id: PackageId
    pub package_revision: RevisionType
    pub artifact_digest: DigestIdType
    pub program_id: ProgramId
    pub card_id: GuidedCardId
    pub language_id: str
    pub audience_id: str


@derive(Clone, json)
pub model ProgramTerminalResult:
    """Terminal Hees decision over original package, interaction, and derived support."""

    pub decision_id: DecisionId
    pub admitted: bool
    pub decision: ProgramTerminalDecision
    pub reason_namespace: str
    pub reason: str
    pub structural_reason: Option[str]
    pub action: ProgramActionKind
    pub current_card_id: Option[GuidedCardId]
    pub next_card_id: Option[GuidedCardId]
    pub memory_operation: ProgramMemoryOperation
    pub admitted_evidence_ids: list[EvidenceId]
    pub selected_memory_ids: list[MemoryId]


@derive(Clone, json)
pub model ProgramContentDnaBody:
    """Source-safe provenance body for an admitted guided-program operation."""

    pub contract_version: ContractId
    pub state: str
    pub profile_id: ProfileId
    pub package_id: PackageId
    pub domain_id: DomainId
    pub package_revision: RevisionType
    pub artifact_digest: DigestIdType
    pub program_id: ProgramId
    pub policy: ProgramAuthorityPolicy
    pub input_id: InputId
    pub action: ProgramAction
    pub frame: ProgramRuntimeFrame
    pub decision_id: DecisionId
    pub decision: ProgramTerminalDecision
    pub reason_namespace: str
    pub reason: str
    pub card: Option[AdmittedProgramCard]
    pub selected_memory: list[ProgramSupportAtom]


@derive(Clone, json)
pub model ProgramContentDna:
    """Sealed provenance envelope for an admitted guided-program operation."""

    pub body: ProgramContentDnaBody
    pub content_dna_id: ContentDnaId


@derive(Clone, json)
pub model ProgramReceiptBody:
    """Redacted terminal receipt body for an admitted or rejected program operation."""

    pub contract_version: ContractId
    pub profile_id: ProfileId
    pub package_id: PackageId
    pub domain_id: DomainId
    pub package_revision: RevisionType
    pub artifact_digest: DigestIdType
    pub program_id: ProgramId
    pub policy: ProgramAuthorityPolicy
    pub input_id: InputId
    pub action: ProgramAction
    pub terminal: ProgramTerminalResult
    pub admitted_card: Option[AdmittedProgramCard]
    pub content_dna_id: Option[ContentDnaId]


@derive(Clone, json)
pub model CompleteProgramEvaluation:
    """Atomic terminal decision and projections available to an application shell."""

    pub terminal: ProgramTerminalResult
    pub selected_memory: list[ProgramSupportAtom]
    pub admitted_card: Option[AdmittedProgramCard]
    pub content_dna_json: Option[str]
    pub receipt_json: Option[str]


@derive(Clone, json)
pub model ProgramAuthorityValidation:
    """Validation result for the installed package projection before terminal evaluation."""

    pub valid: bool
    pub errors: list[str]
