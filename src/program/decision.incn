"""
Direct guided-program eligibility result.

The serializable result explains one structural decision and its eligible operation, if any. It carries no reusable
authority. Later Hees.ai stages must evaluate the original admitted package, governed support and runtime state rather
than accepting a caller-constructed eligibility result as package admission or terminal authority.
"""

from std.serde import json
from crate.identifiers import GuidedCardId
from crate.program.models import (
    ProgramActionKind,
    ProgramDecisionTrace,
    ProgramMemoryOperation,
    ProgramOperationProjection,
)


@derive(Clone, json)
pub model ProgramEvaluation:
    """Inspectable eligibility result that cannot substitute for a later Hees.ai authority decision."""

    pub trace: ProgramDecisionTrace
    pub operation: Option[ProgramOperationProjection]

    @staticmethod
    def rejected(action: ProgramActionKind, reason: str, current_card_id: Option[GuidedCardId]) -> ProgramEvaluation:
        """Construct one internally consistent, non-authoritative rejection result."""

        return ProgramEvaluation(
            trace=ProgramDecisionTrace(
                eligible=false,
                reason=reason,
                action=action,
                current_card_id=current_card_id,
                next_card_id=None,
                session_key=None,
                session_value=None,
                memory_operation=ProgramMemoryOperation.None,
            ),
            operation=None,
        )

    @staticmethod
    def eligible(
        action: ProgramActionKind,
        current_card_id: Option[GuidedCardId],
        next_card_id: Option[GuidedCardId],
        session_key: Option[str],
        session_value: Option[str],
        memory_operation: ProgramMemoryOperation,
    ) -> ProgramEvaluation:
        """Construct one internally consistent, non-authoritative eligibility result."""

        return ProgramEvaluation(
            trace=ProgramDecisionTrace(
                eligible=true,
                reason="eligible",
                action=action,
                current_card_id=current_card_id,
                next_card_id=next_card_id,
                session_key=session_key,
                session_value=session_value,
                memory_operation=memory_operation,
            ),
            operation=Some(
                ProgramOperationProjection(action=action, next_card_id=next_card_id, memory_operation=memory_operation),
            ),
        )
