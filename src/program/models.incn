"""
Data contracts for package-declared guided programs.

These types describe package declarations and untrusted runtime input. They do not render content, select memory or
confer authority merely because their fields are well formed. The evaluator owns the direct eligibility capability
while this module keeps the serializable decision trace separately inspectable.
"""

from std.serde import json
from crate.identifiers import (
    ChoiceId,
    EvidenceId,
    GuidedCardId,
    Identified,
    MemoryId,
    PackageId,
    ProgramId,
    ProgressId,
    RevisionType,
)
from crate.runtime import ReviewStatus, RightsStatus


@derive(Clone, Eq, json)
pub enum ProgramActionKind(str):
    """Closed learner operations evaluated by the guided-program boundary."""

    Enter = "enter"
    Advance = "advance"
    Backtrack = "backtrack"
    SelectChoice = "select_choice"
    Complete = "complete"
    Resume = "resume"
    SaveProgress = "save_progress"
    DiscardProgress = "discard_progress"


@derive(Clone, Eq, json)
pub enum ProgramProgressPolicy(str):
    """Package-owned policy for durable progress operations."""

    SessionOnly = "session_only"
    ExplicitSave = "explicit_save"


@derive(Clone, Eq, json)
pub enum ProgramMemoryOperation(str):
    """Explicit persistence effect carried by an eligible program operation."""

    None = "none"
    SaveProgress = "save_progress"
    DiscardProgress = "discard_progress"


@derive(Clone, json)
pub model GuidedProgramChoice with Identified[ChoiceId]:
    """Package-declared session value with no inherent persistence authority."""

    pub choice_id: ChoiceId
    pub session_key: str
    pub session_value: str

    def identity(self) -> ChoiceId:
        """Return the identity this choice is declared under."""

        return self.choice_id


@derive(Clone, json)
pub model GuidedProgramCard with Identified[GuidedCardId]:
    """Reviewed card declaration and its single deterministic forward edge."""

    pub card_id: GuidedCardId
    pub evidence_ids: list[EvidenceId]
    pub memory_ids: list[MemoryId]
    pub language_ids: list[str]
    pub audience_ids: list[str]
    pub choices: list[GuidedProgramChoice]
    pub next_card_id: Option[GuidedCardId]
    pub completion: bool
    pub review_status: ReviewStatus
    pub rights_status: RightsStatus

    def identity(self) -> GuidedCardId:
        """Return the identity this card is declared under."""

        return self.card_id


@derive(Clone, json)
pub model GuidedProgram:
    """Complete package-owned program declaration evaluated by Hees.ai."""

    pub program_id: ProgramId
    pub package_id: PackageId
    pub revision: RevisionType
    pub language_ids: list[str]
    pub audience_ids: list[str]
    pub entry_card_id: GuidedCardId
    pub completion_card_id: GuidedCardId
    pub progress_policy: ProgramProgressPolicy
    pub cards: list[GuidedProgramCard]


@derive(Clone, json)
pub model ProgramProgressSnapshot:
    """Untrusted progress input that must match the exact program identity and declared topology."""

    pub progress_id: ProgressId
    pub package_id: PackageId
    pub program_id: ProgramId
    pub revision: RevisionType
    pub current_card_id: GuidedCardId
    pub history: list[GuidedCardId]


@derive(Clone, json)
pub model ProgramRuntimeFrame:
    """Untrusted execution input and non-authoritative support nominations."""

    pub package_id: PackageId
    pub program_id: ProgramId
    pub revision: RevisionType
    pub current_card_id: Option[GuidedCardId]
    pub history: list[GuidedCardId]
    pub language_id: str
    pub audience_id: str
    pub nominated_memory_ids: list[MemoryId]
    pub nominated_evidence_ids: list[EvidenceId]


@derive(Clone, json)
pub model ProgramEnterAction:
    """Untrusted request to enter at one declared card."""

    pub target_card_id: GuidedCardId


@derive(Clone, json)
pub model ProgramTransitionAction:
    """Untrusted request to move between two explicit cards."""

    pub from_card_id: GuidedCardId
    pub target_card_id: GuidedCardId


@derive(Clone, json)
pub model ProgramChoiceAction:
    """Untrusted request to select one declared choice on the current card."""

    pub from_card_id: GuidedCardId
    pub choice_id: ChoiceId


@derive(Clone, json)
pub model ProgramCurrentCardAction:
    """Untrusted operation whose only payload is the current card identity."""

    pub from_card_id: GuidedCardId


@derive(Clone, json)
pub enum ProgramAction:
    """
    Closed learner operation proposed to the program authority boundary.

    Payload variants make invalid field combinations unrepresentable. Deserialization therefore rejects malformed
    operations before the evaluator considers package authority, topology, support, or progress policy.
    """

    Enter(ProgramEnterAction)
    Advance(ProgramTransitionAction)
    Backtrack(ProgramTransitionAction)
    SelectChoice(ProgramChoiceAction)
    Complete(ProgramCurrentCardAction)
    Resume(ProgramProgressSnapshot)
    SaveProgress(ProgramCurrentCardAction)
    DiscardProgress(ProgramCurrentCardAction)

    def kind(self) -> ProgramActionKind:
        """Return the closed operation kind recorded in traces and capabilities."""

        match self:
            ProgramAction.Enter(_payload) => return ProgramActionKind.Enter
            ProgramAction.Advance(_payload) => return ProgramActionKind.Advance
            ProgramAction.Backtrack(_payload) => return ProgramActionKind.Backtrack
            ProgramAction.SelectChoice(_payload) => return ProgramActionKind.SelectChoice
            ProgramAction.Complete(_payload) => return ProgramActionKind.Complete
            ProgramAction.Resume(_payload) => return ProgramActionKind.Resume
            ProgramAction.SaveProgress(_payload) => return ProgramActionKind.SaveProgress
            ProgramAction.DiscardProgress(_payload) => return ProgramActionKind.DiscardProgress


@derive(Clone, json)
pub model ProgramValidation:
    """Complete package-declaration validation result."""

    pub valid: bool
    pub errors: list[str]


@derive(Clone, json)
pub model ProgramDecisionTrace:
    """Serializable explanation of one eligibility evaluation; it carries no reusable authority."""

    pub eligible: bool
    pub reason: str
    pub action: ProgramActionKind
    pub current_card_id: Option[GuidedCardId]
    pub next_card_id: Option[GuidedCardId]
    pub session_key: Option[str]
    pub session_value: Option[str]
    pub memory_operation: ProgramMemoryOperation


@derive(Clone, json)
pub model ProgramOperationProjection:
    """Inspectable fields from an eligible operation; the projection itself carries no reusable authority."""

    pub action: ProgramActionKind
    pub next_card_id: Option[GuidedCardId]
    pub memory_operation: ProgramMemoryOperation
