"""
Guided-program topology and runtime-context checks.

These helpers validate untrusted history, current-card identity, language, audience, support nominations and progress
against one structurally valid program declaration. They do not retrieve or select memory and do not grant package
or terminal authority.
"""

from crate.identifiers import GuidedCardId, find_declared
from crate.program.models import GuidedProgram, GuidedProgramCard, ProgramProgressSnapshot, ProgramRuntimeFrame


def history_follows_program(program: GuidedProgram, history: list[GuidedCardId], current_card_id: GuidedCardId) -> bool:
    """Check that untrusted prior cards form the exact declared path to the current card."""

    mut expected_card_id = program.entry_card_id.text()
    for history_card_id in history:
        if history_card_id.text() != expected_card_id:
            return false
        maybe_card = find_declared(program.cards, history_card_id)
        if maybe_card is None:
            return false
        match maybe_card.unwrap().next_card_id:
            Some(next_card_id) =>
                expected_card_id = next_card_id.text()
            None => return false
    return current_card_id.text() == expected_card_id


pub def runtime_frame_reason(program: GuidedProgram, frame: ProgramRuntimeFrame) -> Option[str]:
    """Return the first reason an untrusted runtime frame cannot belong to the program."""

    if frame.package_id != program.package_id:
        return Some("package_id_mismatch")
    if frame.program_id != program.program_id:
        return Some("program_id_mismatch")
    if frame.revision != program.revision:
        return Some("program_revision_mismatch")
    if frame.language_id not in program.language_ids:
        return Some("language_not_allowed")
    if frame.audience_id not in program.audience_ids:
        return Some("audience_not_allowed")
    if let Some(current_card_id) = frame.current_card_id:
        match find_declared(program.cards, current_card_id):
            Some(_card) => pass
            None => return Some("current_card_unknown")
        for history_card_id in frame.history:
            match find_declared(program.cards, history_card_id):
                Some(_card) => pass
                None => return Some("history_card_unknown")
        if not history_follows_program(program, frame.history, current_card_id):
            return Some("history_not_declared")
        return None
    if len(frame.history) > 0:
        return Some("history_without_current_card")
    return None


pub def card_nomination_reason(card: GuidedProgramCard, frame: ProgramRuntimeFrame) -> Option[str]:
    """Return why nominated support cannot make the card eligible for this language and audience."""

    if frame.language_id not in card.language_ids:
        return Some("card_language_not_allowed")
    if frame.audience_id not in card.audience_ids:
        return Some("card_audience_not_allowed")
    for memory_id in card.memory_ids:
        if memory_id not in frame.nominated_memory_ids:
            return Some("card_memory_not_nominated")
    for evidence_id in card.evidence_ids:
        if evidence_id not in frame.nominated_evidence_ids:
            return Some("card_evidence_not_nominated")
    return None


pub def action_origin_reason(frame: ProgramRuntimeFrame, from_card_id: GuidedCardId) -> Option[str]:
    """Require an operation's explicit origin to match the runtime's current card."""

    if Some(from_card_id) != frame.current_card_id:
        return Some("action_origin_mismatch")
    return None


pub def progress_snapshot_reason(program: GuidedProgram, snapshot: ProgramProgressSnapshot) -> Option[str]:
    """Return why a durable snapshot cannot resume the exact program revision and path."""

    if snapshot.package_id != program.package_id:
        return Some("progress_package_mismatch")
    if snapshot.program_id != program.program_id:
        return Some("progress_program_mismatch")
    if snapshot.revision != program.revision:
        return Some("progress_revision_mismatch")
    match find_declared(program.cards, snapshot.current_card_id):
        Some(_card) => pass
        None => return Some("progress_card_unknown")
    for card_id in snapshot.history:
        match find_declared(program.cards, card_id):
            Some(_card) => pass
            None => return Some("progress_history_card_unknown")
    if not history_follows_program(program, snapshot.history, snapshot.current_card_id):
        return Some("progress_history_not_declared")
    return None
