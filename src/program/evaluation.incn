"""
Direct guided-program operation evaluation.

The evaluator checks one untrusted action and runtime frame against a validated program declaration. Its result is
safe to serialize and inspect but is not reusable authority. Eligibility is not package admission or terminal Spectrum
authority. No state or persistence mutation occurs inside this module.
"""

from crate.identifiers import GuidedCardId, find_declared
from crate.program.context import (
    action_origin_reason,
    card_nomination_reason,
    progress_snapshot_reason,
    runtime_frame_reason,
)
from crate.program.decision import ProgramEvaluation
from crate.program.models import (
    GuidedProgram,
    ProgramAction,
    ProgramActionKind,
    ProgramChoiceAction,
    ProgramCurrentCardAction,
    ProgramEnterAction,
    ProgramMemoryOperation,
    ProgramProgressPolicy,
    ProgramProgressSnapshot,
    ProgramRuntimeFrame,
    ProgramTransitionAction,
)
from crate.program.validation import validate_guided_program


def evaluate_enter(program: GuidedProgram, frame: ProgramRuntimeFrame, action: ProgramEnterAction) -> ProgramEvaluation:
    """Make entry eligible only at the declared first card with complete nominated support."""

    if frame.current_card_id is not None:
        return ProgramEvaluation.rejected(ProgramActionKind.Enter, "program_already_started", frame.current_card_id)
    if action.target_card_id != program.entry_card_id:
        return ProgramEvaluation.rejected(ProgramActionKind.Enter, "entry_card_mismatch", frame.current_card_id)
    entry_card = find_declared(program.cards, program.entry_card_id).unwrap()
    match card_nomination_reason(entry_card, frame):
        Some(reason) => return ProgramEvaluation.rejected(ProgramActionKind.Enter, reason, frame.current_card_id)
        None =>
            return ProgramEvaluation.eligible(
                ProgramActionKind.Enter,
                frame.current_card_id,
                Some(action.target_card_id),
                None,
                None,
                ProgramMemoryOperation.None,
            )


def evaluate_advance(
    program: GuidedProgram,
    frame: ProgramRuntimeFrame,
    action: ProgramTransitionAction,
) -> ProgramEvaluation:
    """Make only the current card's single declared forward edge eligible."""

    match action_origin_reason(frame, action.from_card_id):
        Some(reason) => return ProgramEvaluation.rejected(ProgramActionKind.Advance, reason, frame.current_card_id)
        None => pass
    current_card = find_declared(program.cards, action.from_card_id).unwrap()
    if Some(action.target_card_id) != current_card.next_card_id:
        return ProgramEvaluation.rejected(ProgramActionKind.Advance, "transition_not_declared", frame.current_card_id)
    target_card = find_declared(program.cards, action.target_card_id).unwrap()
    match card_nomination_reason(target_card, frame):
        Some(reason) => return ProgramEvaluation.rejected(ProgramActionKind.Advance, reason, frame.current_card_id)
        None =>
            return ProgramEvaluation.eligible(
                ProgramActionKind.Advance,
                frame.current_card_id,
                Some(action.target_card_id),
                None,
                None,
                ProgramMemoryOperation.None,
            )


def evaluate_backtrack(
    program: GuidedProgram,
    frame: ProgramRuntimeFrame,
    action: ProgramTransitionAction,
) -> ProgramEvaluation:
    """Make a backtrack eligible only to the immediately preceding supported card."""

    match action_origin_reason(frame, action.from_card_id):
        Some(reason) => return ProgramEvaluation.rejected(ProgramActionKind.Backtrack, reason, frame.current_card_id)
        None => pass
    if len(frame.history) == 0 or action.target_card_id != frame.history[len(frame.history) - 1]:
        return ProgramEvaluation.rejected(ProgramActionKind.Backtrack, "backtrack_not_in_history", frame.current_card_id)
    target_card = find_declared(program.cards, action.target_card_id).unwrap()
    match card_nomination_reason(target_card, frame):
        Some(reason) => return ProgramEvaluation.rejected(ProgramActionKind.Backtrack, reason, frame.current_card_id)
        None => pass
    return ProgramEvaluation.eligible(
        ProgramActionKind.Backtrack,
        frame.current_card_id,
        Some(action.target_card_id),
        None,
        None,
        ProgramMemoryOperation.None,
    )


def evaluate_choice(
    program: GuidedProgram,
    frame: ProgramRuntimeFrame,
    action: ProgramChoiceAction,
) -> ProgramEvaluation:
    """Make one session-only value declared by the supported current card eligible."""

    match action_origin_reason(frame, action.from_card_id):
        Some(reason) => return ProgramEvaluation.rejected(ProgramActionKind.SelectChoice, reason, frame.current_card_id)
        None => pass
    current_card = find_declared(program.cards, action.from_card_id).unwrap()
    match card_nomination_reason(current_card, frame):
        Some(reason) => return ProgramEvaluation.rejected(ProgramActionKind.SelectChoice, reason, frame.current_card_id)
        None => pass
    match find_declared(current_card.choices, action.choice_id):
        Some(choice) =>
            return ProgramEvaluation.eligible(
                ProgramActionKind.SelectChoice,
                frame.current_card_id,
                frame.current_card_id,
                Some(choice.session_key),
                Some(choice.session_value),
                ProgramMemoryOperation.None,
            )
        None =>
            return ProgramEvaluation.rejected(
                ProgramActionKind.SelectChoice,
                "choice_not_declared",
                frame.current_card_id,
            )


def evaluate_complete(
    program: GuidedProgram,
    frame: ProgramRuntimeFrame,
    action: ProgramCurrentCardAction,
) -> ProgramEvaluation:
    """Make completion eligible only from the package-declared completion card."""

    match action_origin_reason(frame, action.from_card_id):
        Some(reason) => return ProgramEvaluation.rejected(ProgramActionKind.Complete, reason, frame.current_card_id)
        None => pass
    if action.from_card_id != program.completion_card_id:
        return ProgramEvaluation.rejected(
            ProgramActionKind.Complete,
            "completion_card_not_reached",
            frame.current_card_id,
        )
    next_card_id: Option[GuidedCardId] = None
    return ProgramEvaluation.eligible(
        ProgramActionKind.Complete,
        frame.current_card_id,
        next_card_id,
        None,
        None,
        ProgramMemoryOperation.None,
    )


def evaluate_resume(
    program: GuidedProgram,
    frame: ProgramRuntimeFrame,
    snapshot: ProgramProgressSnapshot,
) -> ProgramEvaluation:
    """Make a matching durable snapshot eligible only when explicit progress is declared."""

    if frame.current_card_id is not None:
        return ProgramEvaluation.rejected(ProgramActionKind.Resume, "program_already_started", frame.current_card_id)
    if program.progress_policy != ProgramProgressPolicy.ExplicitSave:
        return ProgramEvaluation.rejected(
            ProgramActionKind.Resume,
            "durable_progress_not_allowed",
            frame.current_card_id,
        )
    match progress_snapshot_reason(program, snapshot):
        Some(reason) => return ProgramEvaluation.rejected(ProgramActionKind.Resume, reason, frame.current_card_id)
        None => pass
    resumed_card = find_declared(program.cards, snapshot.current_card_id).unwrap()
    match card_nomination_reason(resumed_card, frame):
        Some(reason) => return ProgramEvaluation.rejected(ProgramActionKind.Resume, reason, frame.current_card_id)
        None =>
            return ProgramEvaluation.eligible(
                ProgramActionKind.Resume,
                frame.current_card_id,
                Some(snapshot.current_card_id),
                None,
                None,
                ProgramMemoryOperation.None,
            )


def evaluate_memory_operation(
    program: GuidedProgram,
    frame: ProgramRuntimeFrame,
    action: ProgramCurrentCardAction,
    action_kind: ProgramActionKind,
    operation: ProgramMemoryOperation,
) -> ProgramEvaluation:
    """Make an explicit progress effect eligible without mutating persistence inside Hees.ai."""

    match action_origin_reason(frame, action.from_card_id):
        Some(reason) => return ProgramEvaluation.rejected(action_kind, reason, frame.current_card_id)
        None => pass
    if program.progress_policy != ProgramProgressPolicy.ExplicitSave:
        return ProgramEvaluation.rejected(action_kind, "durable_progress_not_allowed", frame.current_card_id)
    current_card = find_declared(program.cards, action.from_card_id).unwrap()
    match card_nomination_reason(current_card, frame):
        Some(reason) => return ProgramEvaluation.rejected(action_kind, reason, frame.current_card_id)
        None => pass
    return ProgramEvaluation.eligible(action_kind, frame.current_card_id, frame.current_card_id, None, None, operation)


pub def evaluate_program_action(
    program: GuidedProgram,
    frame: ProgramRuntimeFrame,
    action: ProgramAction,
) -> ProgramEvaluation:
    """Evaluate one complete operation without rendering content or mutating caller state."""

    validation = validate_guided_program(program)
    if not validation.valid:
        return ProgramEvaluation.rejected(action.kind(), "invalid_program", frame.current_card_id)
    match runtime_frame_reason(program, frame):
        Some(reason) => return ProgramEvaluation.rejected(action.kind(), reason, frame.current_card_id)
        None => pass

    match action:
        ProgramAction.Enter(payload) => return evaluate_enter(program, frame, payload)
        ProgramAction.Advance(payload) => return evaluate_advance(program, frame, payload)
        ProgramAction.Backtrack(payload) => return evaluate_backtrack(program, frame, payload)
        ProgramAction.SelectChoice(payload) => return evaluate_choice(program, frame, payload)
        ProgramAction.Complete(payload) => return evaluate_complete(program, frame, payload)
        ProgramAction.Resume(snapshot) => return evaluate_resume(program, frame, snapshot)
        ProgramAction.SaveProgress(payload) =>
            return evaluate_memory_operation(
                program,
                frame,
                payload,
                ProgramActionKind.SaveProgress,
                ProgramMemoryOperation.SaveProgress,
            )
        ProgramAction.DiscardProgress(payload) =>
            return evaluate_memory_operation(
                program,
                frame,
                payload,
                ProgramActionKind.DiscardProgress,
                ProgramMemoryOperation.DiscardProgress,
            )
