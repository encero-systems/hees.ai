"""
Identity and digest helpers for generic governed-profile inputs and artifacts.

Every identity digest hashes a distinct type tag ahead of the current serializer's JSON (``digest_tagged_json``), so
one projection type can never match the digest of another. These encodings are interim and do not conform to RFC 011
structural identity.
"""

from std.serde.json import Serialize
from crate.content_dna import digest_text_bytes
from crate.governed_profile_models import (
    GOVERNED_OBSERVATION_CONTRACT,
    GOVERNED_PROPOSAL_CONTRACT,
    CommitteeObservation,
    CommitteeVerdict,
    GovernedAnswerProjection,
    GovernedMemory,
    GovernedMemoryArtifactProjection,
    GovernedMemoryProvenanceProjection,
    GovernedProfilePackage,
    GovernedProfilePackageArtifactProjection,
    GovernedProposal,
    GovernedRequest,
    GovernedRequestDigestProjection,
)
from crate.identifiers import (
    ActionId,
    AudienceId,
    CommitteeRoleId,
    DigestIdType,
    EvidenceId,
    GuidedMaterialId,
    GuidedStepId,
    MemoryId,
    ObservationId,
    ProposalId,
    RequestId,
    contract_id,
    identifier_text_is_safe,
)
from crate.witness import digest_tagged_json

const DIGEST_TEXT_PREFIX_LENGTH: int = 7
# Type tags hashed ahead of each projection's JSON; one per projection type.
pub const GOVERNED_PACKAGE_TYPE_TAG: str = "hees.ai/profile-package/v0"
pub const GOVERNED_MEMORY_PROVENANCE_TYPE_TAG: str = "hees.ai/memory-provenance/v0"
pub const GOVERNED_REQUEST_TYPE_TAG: str = "hees.ai/profile-request/v0"
pub const GOVERNED_PROPOSAL_TYPE_TAG: str = "hees.ai/profile-proposal/v0"
pub const GOVERNED_ANSWER_TYPE_TAG: str = "hees.ai/profile-answer/v0"


pub def derive_bounded_identifier_text(value: str, source_prefix: str, derived_prefix: str) -> str:
    """
    Derive one canonical identifier from an untrusted source identifier without ever exceeding the identifier bound.

    The source's ``source_prefix`` is replaced by ``derived_prefix`` (for example ``proposal_x`` becomes
    ``decision_x``). When that readable form is not a canonical identifier, because the source is too long or was
    constructed without validation, the result is ``derived_prefix`` followed by the 64 hex characters of the
    SHA-256 digest of the exact source text. Both forms always satisfy ``identifier_text_is_safe`` for a canonical
    ``derived_prefix`` of at most 64 characters, so a trusted identifier constructor never fails on the result.
    """

    mut readable = f"{derived_prefix}{value}"
    if value.startswith(source_prefix):
        readable = f"{derived_prefix}{value[len(source_prefix):]}"
    if identifier_text_is_safe(readable):
        return readable
    return f"{derived_prefix}{digest_text_bytes(value).text()[DIGEST_TEXT_PREFIX_LENGTH:]}"


def digest_serialized_projection(type_tag: str, source: str) -> DigestIdType:
    """
    Digest JSON emitted by this module's own serializer calls under ``type_tag``.

    This helper accepts only serializer-produced model output, so parse failure is a broken invariant rather than an
    invalid digest value. It does not claim a durable cross-version canonical encoding. A caller accepting arbitrary
    external JSON must use ``digest_tagged_json`` directly and handle its ``Result``.
    """

    return digest_tagged_json(type_tag, source).unwrap()


pub def digest_governed_profile_package(package: GovernedProfilePackage) -> DigestIdType:
    """
    Recompute the package digest over every field except ``profile_package_digest`` and each ``provenance_digest``.

    The digest hashes ``GOVERNED_PACKAGE_TYPE_TAG`` ahead of the projection's serializer JSON.
    """

    memory: list[GovernedMemoryArtifactProjection] = [GovernedMemoryArtifactProjection(
        memory_id=atom.memory_id,
        concept=atom.concept,
        evidence_ids=atom.evidence_ids,
        review_state=atom.review_state,
        review_revision=atom.review_revision,
        rights_state=atom.rights_state,
    ) for atom in package.memory]
    projection = GovernedProfilePackageArtifactProjection(
        contract_version=package.contract_version,
        profile_id=package.profile_id,
        package_id=package.package_id,
        domain_id=package.domain_id,
        package_revision=package.package_revision,
        mission=package.mission,
        actions=package.actions,
        evidence=package.evidence,
        memory=memory,
        guided_material=package.guided_material,
        policy=package.policy,
    )
    return digest_serialized_projection(GOVERNED_PACKAGE_TYPE_TAG, projection.to_json())


pub def digest_governed_memory_provenance(package: GovernedProfilePackage, atom: GovernedMemory) -> DigestIdType:
    """Bind one memory atom's core fields to the exact, already-established package identity."""

    projection = GovernedMemoryProvenanceProjection(
        package_id=package.package_id,
        domain_id=package.domain_id,
        package_revision=package.package_revision,
        profile_package_digest=package.profile_package_digest,
        memory_id=atom.memory_id,
        concept=atom.concept,
        evidence_ids=atom.evidence_ids,
        review_state=atom.review_state,
        review_revision=atom.review_revision,
        rights_state=atom.rights_state,
    )
    return digest_serialized_projection(GOVERNED_MEMORY_PROVENANCE_TYPE_TAG, projection.to_json())


pub def digest_governed_request_fields(
    request_id: RequestId,
    question: str,
    language: str,
    audience: AudienceId,
) -> DigestIdType:
    """Bind exact trusted request fields before the complete request exists."""

    projection = GovernedRequestDigestProjection(
        request_id=request_id,
        question=question,
        language=language,
        audience=audience,
    )
    return digest_serialized_projection(GOVERNED_REQUEST_TYPE_TAG, projection.to_json())


pub def bind_governed_request(
    request_id: RequestId,
    question: str,
    language: str,
    audience: AudienceId,
) -> GovernedRequest:
    """Construct one request whose digest binds its exact trusted context."""

    return GovernedRequest(
        request_id=request_id,
        question=question,
        language=language,
        audience=audience,
        request_digest=digest_governed_request_fields(request_id, question, language, audience),
    )


pub def digest_governed_proposal(proposal: GovernedProposal) -> DigestIdType:
    """Bind the complete untrusted proposal to one candidate digest over its serializer JSON."""

    return digest_serialized_projection(GOVERNED_PROPOSAL_TYPE_TAG, proposal.to_json())


pub def digest_governed_answer(visible_output: str) -> DigestIdType:
    """Bind exact delivered visible text without normalizing its prose."""

    return digest_serialized_projection(
        GOVERNED_ANSWER_TYPE_TAG,
        GovernedAnswerProjection(visible_output=visible_output).to_json(),
    )


pub def governed_proposal(
    package: GovernedProfilePackage,
    request: GovernedRequest,
    proposal_id: ProposalId,
    action_id: ActionId,
    visible_output: str,
    evidence_ids: list[EvidenceId],
    memory_ids: list[MemoryId],
    guided_material_id: Option[GuidedMaterialId],
    current_step_id: Option[GuidedStepId],
    next_step_id: Option[GuidedStepId],
) -> GovernedProposal:
    """Construct an untrusted proposal bound to the caller-supplied package and request identity."""

    return GovernedProposal(
        contract_version=contract_id(GOVERNED_PROPOSAL_CONTRACT),
        profile_id=package.profile_id,
        package_id=package.package_id,
        domain_id=package.domain_id,
        package_revision=package.package_revision,
        profile_package_digest=package.profile_package_digest,
        request_id=request.request_id,
        request_digest=request.request_digest,
        proposal_id=proposal_id,
        action_id=action_id,
        visible_output=visible_output,
        evidence_ids=evidence_ids,
        memory_ids=memory_ids,
        guided_material_id=guided_material_id,
        current_step_id=current_step_id,
        next_step_id=next_step_id,
    )


pub def committee_observation(
    package: GovernedProfilePackage,
    request: GovernedRequest,
    proposal: GovernedProposal,
    observation_id: ObservationId,
    role: CommitteeRoleId,
    verdict: CommitteeVerdict,
    evaluator_fingerprint: DigestIdType,
) -> CommitteeObservation:
    """
    Bind one non-authoritative verdict to its exact package, request, and candidate.

    The caller supplies an already-typed ``ObservationId``; this constructor performs no fallible text conversion.
    The observation is still untrusted input: ``evaluate_governed_profile_with_artifacts`` re-validates every field.
    """

    return CommitteeObservation(
        contract_version=contract_id(GOVERNED_OBSERVATION_CONTRACT),
        profile_id=package.profile_id,
        observation_id=observation_id,
        role=role,
        verdict=verdict,
        package_id=package.package_id,
        domain_id=package.domain_id,
        package_revision=package.package_revision,
        profile_package_digest=package.profile_package_digest,
        request_id=request.request_id,
        request_digest=request.request_digest,
        candidate_digest=digest_governed_proposal(proposal),
        evaluator_fingerprint=evaluator_fingerprint,
    )
