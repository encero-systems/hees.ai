"""
Bounded approximate TurboQuant nomination with exact reranking.

A `TurboquantIndex` binds each package-owned memory identifier to one compressed TurboQuant code and retains the
normalized full-precision vector for reranking. A query is transformed once, scored against every code in linear
time, reduced to a bounded approximate candidate set, and reranked by exact cosine similarity. The result is a list of
non-authoritative `MemoryId` nominations; RFC 003 admission still decides whether any of them may become selected
memory.
"""

from std.encoding.hex import hexlify
from std.hash import sha256
from std.io import BytesIO, Endian, IoError
from rust::std::string import FromUtf8Error, String as RustString
from crate.hyperquant.exact import HyperquantEntry, stored_hyperquant_entry
from crate.hyperquant.models import (
    MAX_HYPERQUANT_TOP_K,
    HyperquantError,
    HyperquantErrorKind,
    HyperquantNomination,
    HyperquantProfile,
)
from crate.hyperquant.turboquant import (
    TurboquantCode,
    TurboquantConfiguration,
    read_exact,
    read_f64,
    read_u16,
    read_u32,
    read_u8,
    StoredArtifact,
    written,
)
from crate.hyperquant.vector import normalize_vector, relevance_basis_points
from crate.identifiers import MemoryId, memory_id_from_text

pub const MAX_HYPERQUANT_CANDIDATES: int = 256
# Bytes before the configuration section of a stored index: magic, version, configuration length.
const INDEX_HEADER_BYTES: int = 14
const INDEX_DIGEST_BYTES: int = 32
# Bytes before the first vector in a stored vectors file: magic, version, dimensions, entry count.
pub const STORED_VECTORS_HEADER_BYTES: int = 18
# Bytes of one stored coordinate (binary64).
pub const STORED_COORDINATE_BYTES: int = 8


@derive(Clone)
pub model TurboquantCandidate:
    """One approximate candidate with its compressed estimate and its exact reranked score."""

    pub memory_id: MemoryId
    pub estimated_similarity: float
    pub cosine_similarity: float
    pub relevance_bps: int


@derive(Clone)
pub model TurboquantResult:
    """Reranked nominations plus the bounded approximate candidate trace that produced them."""

    pub profile: HyperquantProfile
    pub dimensions: int
    pub index_fingerprint: str
    pub nominations: list[HyperquantNomination]
    pub candidates: list[TurboquantCandidate]


@derive(Clone)
model ScoredPosition:
    """Index position and compressed estimate retained while scanning."""

    position: int
    estimated_similarity: float


@derive(Clone)
pub class TurboquantIndex:
    """In-memory compressed index over uniquely identified entries of one configured dimension."""

    _configuration: TurboquantConfiguration
    _entries: list[HyperquantEntry]
    _codes: list[TurboquantCode]
    _fingerprint: str

    def profile(self) -> HyperquantProfile:
        """Return the configured TurboQuant profile."""

        return self._configuration.profile()

    def dimensions(self) -> int:
        """Return the configured vector dimension."""

        return self._configuration.dimensions()

    def entry_count(self) -> int:
        """Return the number of indexed entries."""

        return len(self._entries)

    def index_fingerprint(self) -> str:
        """Return the identity of the configuration, entry order, memory identifiers and codes."""

        return self._fingerprint

    def approximate_candidates(self, normalized_query: list[float], candidate_count: int) -> list[ScoredPosition]:
        """Score every code in transform space and retain the bounded best estimates."""

        # Transform the query once. Every code is then scored against the same rotated and projected query, so the
        # per-code work is the estimate alone.
        rotated = self._configuration.rotated_query(normalized_query)
        projected = self._configuration.projected_query(normalized_query)

        # Keep the best `candidate_count` estimates in order while scanning. Each new estimate is appended and
        # moved up to its place, and the worst one is dropped once the list is over the bound, so the list never
        # holds more than `candidate_count + 1` items however many codes the index has.
        mut retained: list[ScoredPosition] = []
        for position in range(len(self._codes)):
            estimate = self._configuration.estimate_transformed(rotated, projected, self._codes[position])
            retained.append(ScoredPosition(position=position, estimated_similarity=estimate))
            mut slot = len(retained) - 1
            while slot > 0 and self.estimate_precedes(retained[slot], retained[slot - 1]):
                retained.swap(slot, slot - 1)
                slot -= 1
            if len(retained) > candidate_count:
                retained.pop()
        return retained

    def estimate_precedes(self, left: ScoredPosition, right: ScoredPosition) -> bool:
        """Order higher estimates first and break exact ties by canonical memory identifier."""

        if left.estimated_similarity != right.estimated_similarity:
            return left.estimated_similarity > right.estimated_similarity
        return self._entries[left.position].memory_id.text() < self._entries[right.position].memory_id.text()

    def reranked(self, normalized_query: list[float], approximate: list[ScoredPosition]) -> list[TurboquantCandidate]:
        """Rerank the approximate candidates by exact cosine similarity over retained vectors."""

        mut candidates: list[TurboquantCandidate] = []
        for scored in approximate:
            # Both vectors are unit length, so their dot product is the exact cosine similarity.
            entry = self._entries[scored.position]
            mut cosine_similarity = 0.0
            for dimension in range(len(normalized_query)):
                cosine_similarity += entry.coordinate(dimension) * normalized_query[dimension]
            candidates.append(
                TurboquantCandidate(
                    memory_id=entry.memory_id,
                    estimated_similarity=scored.estimated_similarity,
                    cosine_similarity=cosine_similarity,
                    relevance_bps=relevance_basis_points(cosine_similarity),
                ),
            )

            # Move the new candidate up to its place, so the list stays ordered by exact similarity.
            mut slot = len(candidates) - 1
            while slot > 0 and candidate_precedes(candidates[slot], candidates[slot - 1]):
                candidates.swap(slot, slot - 1)
                slot -= 1
        return candidates

    def vectors_to_bytes(self) -> Result[bytes, HyperquantError]:
        """
        Return the stored exact vectors: a fixed header, one normalized vector per entry in index order, and a digest.

        Every vector has the same size, so a reader can fetch the vector at one position without reading the others.
        Only the candidates of a query are ever reranked, so only their vectors need to be read.
        """

        return written(self.vectors_wire(), StoredArtifact.Vectors)

    def vectors_wire(self) -> Result[bytes, IoError]:
        """Write the stored vectors' canonical bytes: header, coordinates, and the digest of everything before it."""

        # Header: magic, version, and the two counts a reader needs to find any vector by position. The width of
        # each typed value is its width on the wire.
        writer = BytesIO()
        major: u8 = 0
        minor: u8 = 1
        dimensions_wire: u32 = self.dimensions().wrapping_resize()
        entry_count_wire: u32 = len(self._entries).wrapping_resize()
        writer.write(b"HQTQVEC0")?
        writer.write(major, Endian.Big)?
        writer.write(minor, Endian.Big)?
        writer.write(dimensions_wire, Endian.Big)?
        writer.write(entry_count_wire, Endian.Big)?

        # Body: every entry's coordinates in index order, with no per-entry framing, so vector `p` starts at a
        # fixed offset. The entry is taken once per vector; indexing `self._entries` per coordinate would copy it
        # each time.
        dimensions = self.dimensions()
        for position in range(len(self._entries)):
            entry = self._entries[position]
            for dimension in range(dimensions):
                coordinate: f64 = entry.coordinate(dimension)
                writer.write(coordinate, Endian.Big)?

        # Close the file with the digest of everything written so far. The stored codes record the same digest.
        body = writer.into_bytes()
        writer.write(sha256.digest(body))?
        return Ok(writer.into_bytes())

    def codes_to_bytes(self, vectors_digest: bytes) -> Result[bytes, HyperquantError]:
        """
        Return the stored codes: configuration, fingerprint, the digest of the stored vectors, identifiers and codes.

        An index is built once when a package is made and loaded wherever the package is used. This part is small and
        is always loaded; it names the exact vectors file it belongs with by digest. The stored form is a nomination
        aid only: loading it grants no authority to any memory identifier it contains.
        """

        if len(vectors_digest) != INDEX_DIGEST_BYTES:
            return Err(failure(HyperquantErrorKind.NonCanonicalPayload, "vectors digest must be a SHA-256 digest"))
        return written(self.codes_wire(vectors_digest), StoredArtifact.Index)

    def codes_wire(self, vectors_digest: bytes) -> Result[bytes, IoError]:
        """Write the stored codes' canonical bytes: header, one record per entry, and the digest of everything before it."""

        # Header: magic and version, then the configuration the codes were made with, the index shape, the index
        # fingerprint, and the digest of the stored vectors file this index belongs with. Variable-length fields
        # are preceded by their length.
        writer = BytesIO()
        major: u8 = 0
        minor: u8 = 2
        configuration_bytes = self._configuration.to_bytes()
        configuration_length: u32 = len(configuration_bytes).wrapping_resize()
        dimensions_wire: u32 = self.dimensions().wrapping_resize()
        entry_count_wire: u32 = len(self._entries).wrapping_resize()
        fingerprint_bytes = RustString.from(self._fingerprint).into_bytes()
        fingerprint_length: u16 = len(fingerprint_bytes).wrapping_resize()
        writer.write(b"HQTQIDX0")?
        writer.write(major, Endian.Big)?
        writer.write(minor, Endian.Big)?
        writer.write(configuration_length, Endian.Big)?
        writer.write(configuration_bytes)?
        writer.write(dimensions_wire, Endian.Big)?
        writer.write(entry_count_wire, Endian.Big)?
        writer.write(fingerprint_length, Endian.Big)?
        writer.write(fingerprint_bytes)?
        writer.write(vectors_digest)?

        # Body: one record per entry in index order, the memory identifier and then its code, each preceded by its
        # length.
        for position in range(len(self._entries)):
            identifier = RustString.from(self._entries[position].memory_id.text()).into_bytes()
            identifier_length: u16 = len(identifier).wrapping_resize()
            code_bytes = self._codes[position].to_bytes()
            code_length: u32 = len(code_bytes).wrapping_resize()
            writer.write(identifier_length, Endian.Big)?
            writer.write(identifier)?
            writer.write(code_length, Endian.Big)?
            writer.write(code_bytes)?

        # Close the file with the digest of everything written so far.
        body = writer.into_bytes()
        writer.write(sha256.digest(body))?
        return Ok(writer.into_bytes())

    def nominate(
        self,
        query_values: list[float],
        top_k: int,
        candidate_count: int,
    ) -> Result[TurboquantResult, HyperquantError]:
        """
        Return deterministic reranked nominations from this index without consuming it.

        An index is built once for a package revision and queried many times. `candidate_count` bounds the approximate
        stage; `top_k` bounds the nominations returned after exact reranking.
        """

        # Bound the request before any scoring: `top_k` nominations out of `candidate_count` approximate
        # candidates, each within the contract bound and the size of the index.
        if top_k <= 0 or top_k > MAX_HYPERQUANT_TOP_K or top_k > self.entry_count():
            return Err(
                failure(
                    HyperquantErrorKind.InvalidTopK,
                    "top_k must be positive and no greater than both the index size and contract bound",
                ),
            )
        if candidate_count < top_k or candidate_count > MAX_HYPERQUANT_CANDIDATES or candidate_count > self.entry_count():
            return Err(
                failure(
                    HyperquantErrorKind.InvalidTopK,
                    "candidate_count must be at least top_k and no greater than both the index size and contract bound",
                ),
            )

        # Stored vectors are unit length, so the query is normalized too; the dimension check comes after, on the
        # normalized form.
        normalized_query = normalize_vector(query_values)?
        if len(normalized_query) != self.dimensions():
            return Err(
                failure(
                    HyperquantErrorKind.DimensionMismatch,
                    "query vector dimension does not match the TurboQuant index",
                ),
            )

        # Two stages: an approximate scan over every code keeps `candidate_count` candidates, then those are
        # reordered by exact cosine similarity. The first `top_k` of the exact order become the nominations, ranked
        # from zero.
        candidates = self.reranked(normalized_query, self.approximate_candidates(normalized_query, candidate_count))
        mut nominations: list[HyperquantNomination] = []
        mut rank = 0
        for candidate in candidates:
            if rank >= top_k:
                break
            nominations.append(
                HyperquantNomination(memory_id=candidate.memory_id, rank=rank, relevance_bps=candidate.relevance_bps),
            )
            rank += 1
        return Ok(
            TurboquantResult(
                profile=self.profile(),
                dimensions=self.dimensions(),
                index_fingerprint=self.index_fingerprint(),
                nominations=nominations,
                candidates=candidates,
            ),
        )


@derive(Clone)
pub model TurboquantApproximate:
    """One approximate candidate from the compressed scan, before exact reranking."""

    pub position: int
    pub memory_id: MemoryId
    pub estimated_similarity: float


@derive(Clone)
pub class TurboquantCodeIndex:
    """
    Compressed index loaded from storage: identifiers and codes only, with the exact vectors left on disk.

    A query scans the codes, and the caller then reads the exact vectors of the few candidates from the stored
    vectors file and passes them to `rerank`. The index names that file by digest, so a caller can check it holds
    the right one. It is a nomination aid: nothing it returns is authoritative.
    """

    _configuration: TurboquantConfiguration
    _memory_ids: list[MemoryId]
    _codes: list[TurboquantCode]
    _fingerprint: str
    _vectors_digest: bytes

    def profile(self) -> HyperquantProfile:
        """Return the configured TurboQuant profile."""

        return self._configuration.profile()

    def dimensions(self) -> int:
        """Return the configured vector dimension."""

        return self._configuration.dimensions()

    def entry_count(self) -> int:
        """Return the number of indexed entries."""

        return len(self._memory_ids)

    def index_fingerprint(self) -> str:
        """Return the identity of the configuration, entry order, memory identifiers and codes."""

        return self._fingerprint

    def vectors_digest(self) -> bytes:
        """Return the digest that closes the stored vectors file this index belongs with."""

        return self._vectors_digest

    def matches_stored_vectors(self, payload: bytes) -> bool:
        """
        Report whether a complete stored vectors file is the one this index was built with.

        The file must have the expected header, exactly one vector per entry, and a closing digest that both matches
        its content and equals the digest recorded in this index.
        """

        # The size is fully determined by this index: header, one fixed-size vector per entry, closing digest.
        expected = STORED_VECTORS_HEADER_BYTES + self.entry_count() * self.dimensions() * STORED_COORDINATE_BYTES + INDEX_DIGEST_BYTES
        if len(payload) != expected:
            return false
        body_bytes = len(payload) - INDEX_DIGEST_BYTES
        if payload[:8] != b"HQTQVEC0":
            return false

        # The cheap comparison first: the closing digest must be the one this index recorded. Only then hash the
        # body, which proves the file's content is what that digest names.
        if payload[body_bytes:] != self._vectors_digest:
            return false
        return payload[body_bytes:] == sha256.digest(payload[:body_bytes])

    def approximate(
        self,
        query_values: list[float],
        candidate_count: int,
    ) -> Result[list[TurboquantApproximate], HyperquantError]:
        """Score every code against the query and return the bounded best estimates in deterministic order."""

        if candidate_count <= 0 or candidate_count > MAX_HYPERQUANT_CANDIDATES or candidate_count > self.entry_count():
            return Err(
                failure(
                    HyperquantErrorKind.InvalidTopK,
                    "candidate_count must be positive and no greater than both the index size and contract bound",
                ),
            )
        normalized_query = normalize_vector(query_values)?
        if len(normalized_query) != self.dimensions():
            return Err(
                failure(
                    HyperquantErrorKind.DimensionMismatch,
                    "query vector dimension does not match the TurboQuant index",
                ),
            )

        # Transform the query once, then score every code against it. The best `candidate_count` estimates are kept
        # in order while scanning: each new one is appended and moved up to its place, and the worst is dropped once
        # the list is over the bound.
        rotated = self._configuration.rotated_query(normalized_query)
        projected = self._configuration.projected_query(normalized_query)
        mut retained: list[TurboquantApproximate] = []
        for position in range(len(self._codes)):
            estimate = self._configuration.estimate_transformed(rotated, projected, self._codes[position])
            retained.append(
                TurboquantApproximate(
                    position=position,
                    memory_id=self._memory_ids[position],
                    estimated_similarity=estimate,
                ),
            )
            mut slot = len(retained) - 1
            while slot > 0 and approximate_precedes(retained[slot], retained[slot - 1]):
                retained.swap(slot, slot - 1)
                slot -= 1
            if len(retained) > candidate_count:
                retained.pop()
        return Ok(retained)

    def rerank(
        self,
        query_values: list[float],
        approximate: list[TurboquantApproximate],
        vectors: list[list[float]],
        top_k: int,
    ) -> Result[TurboquantResult, HyperquantError]:
        """
        Rerank approximate candidates by exact cosine similarity over vectors the caller read from storage.

        ``vectors[i]`` must be the stored vector of ``approximate[i]``. Each one must be finite and normalized;
        anything else is rejected rather than scored.
        """

        if top_k <= 0 or top_k > MAX_HYPERQUANT_TOP_K or top_k > len(approximate):
            return Err(
                failure(
                    HyperquantErrorKind.InvalidTopK,
                    "top_k must be positive and no greater than both the candidate count and contract bound",
                ),
            )
        if len(vectors) != len(approximate):
            return Err(failure(HyperquantErrorKind.DimensionMismatch, "one stored vector is required per candidate"))
        normalized_query = normalize_vector(query_values)?
        if len(normalized_query) != self.dimensions():
            return Err(
                failure(
                    HyperquantErrorKind.DimensionMismatch,
                    "query vector dimension does not match the TurboQuant index",
                ),
            )

        # Score each candidate against the vector the caller supplied for it. The vectors come from outside this
        # index, so each is checked for dimension here and for being finite and unit length by
        # `stored_hyperquant_entry`; one bad vector rejects the whole rerank. Candidates are kept ordered by exact
        # similarity as they are added.
        mut candidates: list[TurboquantCandidate] = []
        for slot_index in range(len(approximate)):
            scored = approximate[slot_index]
            if len(vectors[slot_index]) != self.dimensions():
                return Err(failure(HyperquantErrorKind.DimensionMismatch, "stored vector dimension does not match"))
            entry = stored_hyperquant_entry(scored.memory_id, vectors[slot_index])?
            mut cosine_similarity = 0.0
            for dimension in range(len(normalized_query)):
                cosine_similarity += entry.coordinate(dimension) * normalized_query[dimension]
            candidates.append(
                TurboquantCandidate(
                    memory_id=scored.memory_id,
                    estimated_similarity=scored.estimated_similarity,
                    cosine_similarity=cosine_similarity,
                    relevance_bps=relevance_basis_points(cosine_similarity),
                ),
            )
            mut slot = len(candidates) - 1
            while slot > 0 and candidate_precedes(candidates[slot], candidates[slot - 1]):
                candidates.swap(slot, slot - 1)
                slot -= 1

        # The first `top_k` candidates of the exact order become the nominations, ranked from zero.
        mut nominations: list[HyperquantNomination] = []
        mut rank = 0
        for candidate in candidates:
            if rank >= top_k:
                break
            nominations.append(
                HyperquantNomination(memory_id=candidate.memory_id, rank=rank, relevance_bps=candidate.relevance_bps),
            )
            rank += 1
        return Ok(
            TurboquantResult(
                profile=self.profile(),
                dimensions=self.dimensions(),
                index_fingerprint=self.index_fingerprint(),
                nominations=nominations,
                candidates=candidates,
            ),
        )


def approximate_precedes(left: TurboquantApproximate, right: TurboquantApproximate) -> bool:
    """Order higher estimates first and break exact ties by canonical memory identifier."""

    if left.estimated_similarity != right.estimated_similarity:
        return left.estimated_similarity > right.estimated_similarity
    return left.memory_id.text() < right.memory_id.text()


def candidate_precedes(left: TurboquantCandidate, right: TurboquantCandidate) -> bool:
    """Order higher exact scores first and break exact ties by canonical memory identifier."""

    if left.cosine_similarity != right.cosine_similarity:
        return left.cosine_similarity > right.cosine_similarity
    return left.memory_id.text() < right.memory_id.text()


def failure(kind: HyperquantErrorKind, detail: str) -> HyperquantError:
    return HyperquantError.from_kind(kind, detail)


pub def turboquant_index(
    configuration: TurboquantConfiguration,
    entries: list[HyperquantEntry],
) -> Result[TurboquantIndex, HyperquantError]:
    """
    Encode validated entries into a compressed index bound to one configuration.

    The index may hold any number of entries. What a query costs is bounded by its candidate count and ``top_k``.
    """

    if len(entries) == 0:
        return Err(failure(HyperquantErrorKind.EmptyIndex, "TurboQuant index must contain at least one entry"))

    # Encode every entry in the order given. That order is the index order: position `p` names the same entry in
    # the codes, in the stored vectors, and in the fingerprint.
    mut canonical_ids: dict[str, bool] = {}
    mut codes: list[TurboquantCode] = []
    mut identity_lines: list[str] = [configuration.configuration_fingerprint()]
    for entry in entries:
        # An identifier may appear once: a nomination names a memory, so two entries with one name would be
        # ambiguous.
        canonical_id = entry.memory_id.text()
        if canonical_id in canonical_ids:
            return Err(
                failure(HyperquantErrorKind.DuplicateMemoryId, "TurboQuant index memory identifiers must be unique"),
            )
        canonical_ids.insert(canonical_id, true)
        if entry.dimensions != configuration.dimensions():
            return Err(
                failure(
                    HyperquantErrorKind.DimensionMismatch,
                    "entry dimension does not match the TurboQuant configuration",
                ),
            )
        code = configuration.encode([entry.coordinate(dimension) for dimension in range(entry.dimensions)])?
        identity_lines.append(f"{canonical_id} {code.content_fingerprint()}")
        codes.append(code)

    # The fingerprint is the digest of the configuration fingerprint followed by one line per entry, identifier and
    # code fingerprint, in index order. Any change to the configuration, the order, an identifier or a code changes
    # it.
    identity = RustString.from("\n".join(identity_lines)).into_bytes()
    return Ok(
        TurboquantIndex(
            _configuration=configuration,
            _entries=entries,
            _codes=codes,
            _fingerprint=f"sha256:{hexlify(sha256.digest(identity))}",
        ),
    )


pub def turboquant_code_index_from_bytes(
    configuration: TurboquantConfiguration,
    payload: bytes,
) -> Result[TurboquantCodeIndex, HyperquantError]:
    """
    Load the stored codes of an index for one exact configuration, verifying them as they are read.

    The load fails closed when the payload digest does not match, when the index was built with a different
    configuration, when any code is invalid, when an identifier repeats or is not canonical, when bytes follow the
    last entry, or when the fingerprint recomputed from the loaded entries differs from the stored one. Nothing is
    re-encoded: the cost is reading and checking, not building. The exact vectors are not loaded here.
    """

    # Check the closing digest over the whole body before interpreting any field, so every length read below comes
    # from content that is exactly what was written.
    if len(payload) < INDEX_HEADER_BYTES + INDEX_DIGEST_BYTES:
        return Err(failure(HyperquantErrorKind.TruncatedPayload, "truncated TurboQuant index"))
    body_bytes = len(payload) - INDEX_DIGEST_BYTES
    if payload[body_bytes:] != sha256.digest(payload[:body_bytes]):
        return Err(failure(HyperquantErrorKind.IntegrityMismatch, "TurboQuant index digest does not match its content"))

    # Header: framing and version, then the stored configuration, which must be byte-for-byte the one the caller
    # holds. Codes are only meaningful under the configuration that made them.
    reader = BytesIO(payload)
    if read_exact(reader, 8, StoredArtifact.Index)? != b"HQTQIDX0":
        return Err(failure(HyperquantErrorKind.NonCanonicalPayload, "invalid TurboQuant index magic"))
    major = read_u8(reader, StoredArtifact.Index)?
    minor = read_u8(reader, StoredArtifact.Index)?
    if major != 0 or minor != 2:
        return Err(failure(HyperquantErrorKind.UnsupportedVersion, "unsupported TurboQuant index version"))
    configuration_length = read_u32(reader, StoredArtifact.Index)?
    if read_exact(reader, configuration_length, StoredArtifact.Index)? != configuration.to_bytes():
        return Err(
            failure(
                HyperquantErrorKind.ConfigurationMismatch,
                "TurboQuant index was built with a different configuration",
            ),
        )
    dimensions = read_u32(reader, StoredArtifact.Index)?
    if dimensions != configuration.dimensions():
        return Err(failure(HyperquantErrorKind.DimensionMismatch, "TurboQuant index dimension does not match"))
    entry_count = read_u32(reader, StoredArtifact.Index)?
    if entry_count == 0:
        return Err(failure(HyperquantErrorKind.EmptyIndex, "TurboQuant index must contain at least one entry"))
    fingerprint_length = read_u16(reader, StoredArtifact.Index)?
    stored_fingerprint = read_exact(reader, fingerprint_length, StoredArtifact.Index)?
    vectors_digest = read_exact(reader, INDEX_DIGEST_BYTES, StoredArtifact.Index)?

    # Count the bytes read so far, to detect bytes after the last entry: the fixed header, the configuration, the
    # ten bytes of dimensions (4), entry count (4) and fingerprint length (2), the fingerprint, and the vectors
    # digest.
    mut consumed = INDEX_HEADER_BYTES + configuration_length + 10 + fingerprint_length + INDEX_DIGEST_BYTES

    # Entries, in index order. Each record is an identifier and a code, each preceded by its length. The
    # fingerprint lines are rebuilt from what is read, exactly as `turboquant_index` builds them.
    mut canonical_ids: dict[str, bool] = {}
    mut memory_ids: list[MemoryId] = []
    mut codes: list[TurboquantCode] = []
    mut identity_lines: list[str] = [configuration.configuration_fingerprint()]
    for _position in range(entry_count):
        # The identifier must be text, unique in this index, and a canonical memory identifier.
        identifier_length = read_u16(reader, StoredArtifact.Index)?
        identifier_bytes = read_exact(reader, identifier_length, StoredArtifact.Index)?
        decoded: Result[str, FromUtf8Error] = RustString.from_utf8(identifier_bytes)
        canonical_id = decoded.map_err(
            (_error) => failure(HyperquantErrorKind.NonCanonicalPayload, "index identifier is not text"),
        )?
        if canonical_id in canonical_ids:
            return Err(
                failure(HyperquantErrorKind.DuplicateMemoryId, "TurboQuant index memory identifiers must be unique"),
            )
        canonical_ids.insert(canonical_id, true)
        memory_id = memory_id_from_text(canonical_id).map_err(
            (_error) => failure(HyperquantErrorKind.NonCanonicalPayload, "index identifier is not canonical"),
        )?

        # The code is decoded, not copied: `decode` checks it belongs to this configuration and is well formed.
        code_length = read_u32(reader, StoredArtifact.Index)?
        code = configuration.decode(read_exact(reader, code_length, StoredArtifact.Index)?)?

        # Six bytes of framing per record: identifier length (2) and code length (4).
        consumed += 6 + identifier_length + code_length
        memory_ids.append(memory_id)
        identity_lines.append(f"{canonical_id} {code.content_fingerprint()}")
        codes.append(code)
    if consumed != body_bytes:
        return Err(failure(HyperquantErrorKind.TrailingPayload, "TurboQuant index has bytes after its last entry"))

    # The fingerprint recomputed from the loaded entries must equal the stored one. This ties the header's claim
    # to the entries actually read.
    identity = RustString.from("\n".join(identity_lines)).into_bytes()
    fingerprint = f"sha256:{hexlify(sha256.digest(identity))}"
    if RustString.from(fingerprint).into_bytes() != stored_fingerprint:
        return Err(
            failure(HyperquantErrorKind.IntegrityMismatch, "TurboQuant index fingerprint does not match its entries"),
        )
    return Ok(
        TurboquantCodeIndex(
            _configuration=configuration,
            _memory_ids=memory_ids,
            _codes=codes,
            _fingerprint=fingerprint,
            _vectors_digest=vectors_digest,
        ),
    )


pub def stored_vector_from_bytes(payload: bytes, dimensions: int) -> Result[list[float], HyperquantError]:
    """Decode one stored vector: exactly ``dimensions`` big-endian binary64 values."""

    if len(payload) != dimensions * STORED_COORDINATE_BYTES:
        return Err(failure(HyperquantErrorKind.TruncatedPayload, "stored vector has the wrong length"))
    reader = BytesIO(payload)
    mut values: list[float] = []
    for _dimension in range(dimensions):
        values.append(read_f64(reader, StoredArtifact.Vectors)?)
    return Ok(values)


pub def turboquant_query(
    index: TurboquantIndex,
    query_values: list[float],
    top_k: int,
    candidate_count: int,
) -> Result[TurboquantResult, HyperquantError]:
    """
    Return deterministic reranked nominations without assigning authority to them.

    `candidate_count` bounds the approximate stage; `top_k` bounds the nominations returned after exact reranking.
    A caller that queries one index repeatedly should hold the index and call `TurboquantIndex.nominate`.
    """

    return index.nominate(query_values, top_k, candidate_count)
