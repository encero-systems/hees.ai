pub def append_memory_id(mut values: list[MemoryId], value: MemoryId) -> list[MemoryId]:
    """Append a memory ID inside the defining module for Incan 0.4 compatibility."""

    values.append(value)
    return values


pub def id_type_text(identifier: IdType) -> str:
    """Expose canonical text only at serialization, hashing, and presentation boundaries."""

    return identifier.0


pub def id_type_is_safe(identifier: IdType) -> bool:
    """Revalidate deserialized ID storage until Incan issue #904 is resolved."""

    return id_text_is_safe(identifier.0)


pub def symbolic_id_type_text(identifier: SymbolicIdType) -> str:
    """Expose canonical symbolic text at serialization, hashing, and presentation boundaries."""

    return id_type_text(identifier.0)


pub def symbolic_id_type_is_safe(identifier: SymbolicIdType) -> bool:
    """Revalidate a deserialized symbolic identity and its shared storage bound."""

    return id_type_is_safe(identifier.0) and identifier_text_is_safe(id_type_text(identifier.0))


pub def digest_id_type_text(identifier: DigestIdType) -> str:
    """Expose an exact content identity at hashing and presentation boundaries."""

    return id_type_text(identifier.0)


pub def digest_id_type_is_safe(identifier: DigestIdType) -> bool:
    """Revalidate deserialized digest identity storage until Incan issue #904 is resolved."""

    return id_type_is_safe(identifier.0) and digest_id_text_is_safe(id_type_text(identifier.0))


pub def action_id_text(identifier: ActionId) -> str:
    return symbolic_id_type_text(identifier.0)


pub def action_id_is_safe(identifier: ActionId) -> bool:
    return symbolic_id_type_is_safe(identifier.0)


