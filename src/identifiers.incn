pub def unit_id(value: str) -> UnitId:
    """Wrap trusted canonical text as a visible-unit identity."""

    return UnitId(trusted_symbolic_id(value))


pub def id_type_text(identifier: IdType) -> str:
    """Expose canonical text only at serialization, hashing, and presentation boundaries."""

    return identifier.0


pub def symbolic_id_type_text(identifier: SymbolicIdType) -> str:
    """Expose canonical symbolic text at serialization, hashing, and presentation boundaries."""

    return id_type_text(identifier.0)


pub def digest_id_type_text(identifier: DigestIdType) -> str:
    """Expose an exact content identity at hashing and presentation boundaries."""

    return id_type_text(identifier.0)


pub def revision_text(value: RevisionType) -> str:
    """Expose revision text at serialization and presentation boundaries."""

    return value.0


pub def action_id_text(identifier: ActionId) -> str:
    """Project an action identity into canonical wire text."""

    return symbolic_id_type_text(identifier.0)


