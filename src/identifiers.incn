@derive(Clone, Eq, json)
pub type TargetId = newtype SymbolicIdType:
    """Nominal identity for one verifier manifest target."""


@derive(Clone, Eq, json)
pub type UnitId = newtype SymbolicIdType:
    """Nominal identity for one visible proposal unit."""


def symbolic_id_from_text(value: str) -> Result[SymbolicIdType, ValidationError]:
    """Construct a symbolic identity through both validated newtype layers."""

    return IdType.from_underlying(value).and_then((bounded) => SymbolicIdType.from_underlying(bounded))


def trusted_symbolic_id(value: str) -> SymbolicIdType:
    """Validate programmer-authored symbolic text before nominal wrapping."""

    return symbolic_id_from_text(value).unwrap()


def trusted_digest_id(value: str) -> DigestIdType:
    """Validate a programmer-authored digest before nominal wrapping."""

    bounded = IdType.from_underlying(value).unwrap()
    return DigestIdType.from_underlying(bounded).unwrap()


pub def action_id(value: str) -> ActionId:
    """Wrap trusted canonical text as an action identity."""

    return ActionId(trusted_symbolic_id(value))


pub def constraint_plan_id(value: str) -> ConstraintPlanId:
    """Wrap trusted canonical text as a constraint-plan identity."""

    return ConstraintPlanId(trusted_symbolic_id(value))


pub def content_dna_id(value: str) -> ContentDnaId:
    """Wrap a trusted canonical digest as a Content DNA identity."""

    return ContentDnaId(trusted_digest_id(value))


pub def digest_id_type(value: str) -> DigestIdType:
    """Construct a digest already established by a trusted hashing boundary."""

    return trusted_digest_id(value)


pub def contract_id(value: str) -> ContractId:
    """Wrap trusted canonical text as a contract identity."""

    return ContractId(trusted_symbolic_id(value))


