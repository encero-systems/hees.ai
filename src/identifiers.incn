"""Validated nominal identifier vocabulary shared by every public Hees.ai contract."""

from std.serde import json

pub const MAX_IDENTIFIER_LENGTH: int = 128
pub const MAX_ARTIFACT_REVISION_LENGTH: int = 64


def id_text_is_safe(value: str) -> bool:
    """Accept one nonempty, trimmed identifier within the shared storage bound."""

    return value != "" and len(value) <= MAX_IDENTIFIER_LENGTH and value.strip() == value


pub def identifier_text_is_safe(value: str) -> bool:
    """Accept one bounded lowercase ASCII identifier in canonical form."""

    if not id_text_is_safe(value):
        return false
    if "_-".contains(value[0:1]):
        return false
    for character in value:
        if not "abcdefghijklmnopqrstuvwxyz0123456789_-".contains(character):
            return false
    return true


pub def digest_id_text_is_safe(value: str) -> bool:
    """Accept one exact lowercase SHA-256 identity."""

    if len(value) != 71 or not value.startswith("sha256:"):
        return false
    for character in value[7:]:
        if not "0123456789abcdef".contains(character):
            return false
    return true


def revision_text_is_safe(value: str) -> bool:
    """Accept one bounded three-component numeric revision."""

    if value == "" or len(value) > 32:
        return false
    parts = value.split(".")
    if len(parts) != 3:
        return false
    for part in parts:
        if part == "":
            return false
        for character in part:
            if not "0123456789".contains(character):
                return false
    return true


def canonical_number_text_is_safe(value: str) -> bool:
    """Accept one nonempty run of ASCII digits that carries no redundant leading zero."""

    if value == "":
        return false
    for character in value:
        if not "0123456789".contains(character):
            return false
    return value == "0" or value[0:1] != "0"


def prerelease_label_text_is_safe(value: str) -> bool:
    """Accept one prerelease label: a canonical number, or lowercase ASCII alphanumerics joined by single hyphens."""

    if value == "" or value[0:1] == "-" or value[len(value) - 1:] == "-" or value.contains("--"):
        return false
    mut numeric = true
    for character in value:
        if not "abcdefghijklmnopqrstuvwxyz0123456789-".contains(character):
            return false
        if not "0123456789".contains(character):
            numeric = false
    return not numeric or canonical_number_text_is_safe(value)


pub def artifact_revision_text_is_safe(value: str) -> bool:
    """
    Accept one bounded lowercase artifact revision.

    The grammar is the lowercase subset of Semantic Versioning 2.0.0 without build metadata: ``MAJOR.MINOR.PATCH``,
    where each component is a number without a leading zero, optionally followed by ``-`` and one or more dot-separated
    prerelease labels. A label is either a number without a leading zero or lowercase ASCII letters and digits joined by
    single hyphens. The whole revision holds 1 to ``MAX_ARTIFACT_REVISION_LENGTH`` characters.
    """

    if value == "" or len(value) > MAX_ARTIFACT_REVISION_LENGTH:
        return false
    core = value.split("-")[0]
    components = core.split(".")
    if len(components) != 3:
        return false
    for component in components:
        if not canonical_number_text_is_safe(component):
            return false
    if len(core) == len(value):
        return true
    for label in value[len(core) + 1:].split("."):
        if not prerelease_label_text_is_safe(label):
            return false
    return true


pub trait SymbolicIdentifier:
    """Nominal identity over a validated symbolic base; each type supplies only its ``underlying`` accessor."""

    def underlying(self) -> SymbolicIdType

    def text(self) -> str:
        """Project the identity into canonical wire text at serialization, hashing, and presentation boundaries."""

        return self.underlying().text()


pub trait DigestIdentifier:
    """Content-addressed identity over a validated digest base; each type supplies only its ``underlying`` accessor."""

    def underlying(self) -> DigestIdType

    def text(self) -> str:
        """Project the identity into canonical digest text at hashing and presentation boundaries."""

        return self.underlying().text()


@derive(Clone, Eq, json)
pub type IdType = newtype str:
    """Shared bounded string representation beneath every nominal ID namespace."""

    def from_underlying(value: str) -> Result[Self, ValidationError]:
        """Validate shared storage before constructing a bounded identifier."""

        if not id_text_is_safe(value):
            return Err(
                ValidationError(message="identifier must be trimmed and contain 1 to 128 characters", code="invalid_id"),
            )
        return Ok(IdType(value))

    def text(self) -> str:
        """Expose canonical text only at serialization, hashing, and presentation boundaries."""

        return self.0


@derive(Clone, Eq, json)
pub type SymbolicIdType = newtype IdType:
    """Canonical lowercase ASCII identifier representation for symbolic namespaces."""

    def from_underlying(value: IdType) -> Result[Self, ValidationError]:
        """Validate canonical symbolic spelling over bounded identifier storage."""

        if not identifier_text_is_safe(value.0):
            return Err(
                ValidationError(message="identifier must match ^[a-z0-9][a-z0-9_-]{0,127}$", code="invalid_symbolic_id"),
            )
        return Ok(SymbolicIdType(value))

    def text(self) -> str:
        """Expose canonical symbolic text at serialization, hashing, and presentation boundaries."""

        return self.0.text()


@derive(Clone, Eq, json)
pub type ArtifactRevisionType = newtype IdType:
    """Bounded ``MAJOR.MINOR.PATCH`` package or artifact revision with an optional lowercase prerelease suffix."""

    def from_underlying(value: IdType) -> Result[Self, ValidationError]:
        """Validate the ``artifact_revision_text_is_safe`` grammar over shared bounded identifier storage."""

        if not artifact_revision_text_is_safe(value.0):
            return Err(
                ValidationError(
                    message="artifact revision must be 1 to 64 characters of MAJOR.MINOR.PATCH with an optional lowercase -prerelease suffix",
                    code="invalid_artifact_revision",
                ),
            )
        return Ok(ArtifactRevisionType(value))

    def text(self) -> str:
        """Expose an artifact revision at serialization and presentation boundaries."""

        return self.0.text()


@derive(Clone, Eq, json)
pub type DigestIdType = newtype IdType:
    """Exact SHA-256 identity representation for content-addressed artifacts."""

    def from_underlying(value: IdType) -> Result[Self, ValidationError]:
        """Validate a lowercase SHA-256 value over bounded identifier storage."""

        if not digest_id_text_is_safe(value.0):
            return Err(
                ValidationError(message="digest identity must be lowercase sha256:<64 hex>", code="invalid_digest_id"),
            )
        return Ok(DigestIdType(value))

    def text(self) -> str:
        """Expose an exact content identity at hashing and presentation boundaries."""

        return self.0.text()


@derive(Clone, Eq, json)
pub type RevisionType = newtype str:
    """Bounded semantic revision shared by package and policy contracts."""

    def from_underlying(value: str) -> Result[Self, ValidationError]:
        """Validate the three-component revision used by governed contracts."""

        if not revision_text_is_safe(value):
            return Err(
                ValidationError(message="revision must contain three numeric components", code="invalid_revision"),
            )
        return Ok(RevisionType(value))

    def text(self) -> str:
        """Expose revision text at serialization and presentation boundaries."""

        return self.0


