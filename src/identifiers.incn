pub def request_id(value: str) -> RequestId:
    """Wrap trusted canonical text as a request identity."""

    return request_id_from_text(value).unwrap()


pub def request_id_from_text(value: str) -> Result[RequestId, ValidationError]:
    """Validate untrusted text before constructing a request identity."""

    return symbolic_id_from_text(value).map((identifier) => RequestId(identifier))


pub def revision(value: str) -> RevisionType:
    """Construct a revision already established by a trusted package boundary."""

    return RevisionType.from_underlying(value).unwrap()


pub def requirement_id(value: str) -> RequirementId:
    """Wrap trusted canonical text as a requirement identity."""

    return RequirementId(trusted_symbolic_id(value))


pub def response_contract_id(value: str) -> ResponseContractId:
