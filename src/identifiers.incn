pub def has_duplicate_identifiers[T with SymbolicIdentifier](values: list[T]) -> bool:
    """Return whether any identifier repeats an earlier canonical text, in time linear in the number of values."""

    mut seen: Dict[str, bool] = {}
    for value in values:
        text = value.text()
        if seen.contains_key(text):
            return true
        seen[text] = true
    return false


pub def identifier_sets_equal[T with SymbolicIdentifier](left: list[T], right: list[T]) -> bool:
    """
    Return whether two duplicate-free identifier lists hold the same canonical text in any order, in time linear in
    their length.
    """

    if len(left) != len(right):
        return false
    mut right_text: Dict[str, bool] = {}
    for value in right:
        right_text[value.text()] = true
    for value in left:
        if not right_text.contains_key(value.text()):
            return false
    return true


pub trait Identified[I]:
    """Declared item that carries one nominal identity; each type supplies only its ``identity`` accessor."""

    def identity(self) -> I


pub def find_declared[T with (Identified[I], Clone), I with Eq](items: list[T], identifier: I) -> Option[T]:
    """Resolve the first declared item whose identity equals ``identifier``, or None when none is declared."""

    for item in items:
        if item.identity() == identifier:
            return Some(item)
    return None


pub def is_declared[T with (Identified[I], Clone), I with Eq](items: list[T], identifier: I) -> bool:
    """Return whether any declared item carries ``identifier`` as its identity."""

    for item in items:
        if item.identity() == identifier:
            return true
    return false


pub def declared_position[T with (Identified[I], Clone), I with Eq](items: list[T], identifier: I) -> Option[int]:
    """Return the declaration index of the first item whose identity equals ``identifier``, or None."""

    for index, item in enumerate(items):
        if item.identity() == identifier:
            return Some(index)
    return None
