"""
Generic in-memory package and proposal-admission contracts.

The runtime does not invoke a model, retrieve evidence, or claim semantic verification. A caller supplies a package and
an untrusted proposal; Hees checks structural authority before admitting the visible output.
"""

from crate.identifiers import ActionId, DomainId, EvidenceId, PackageId

const GOVERNED_PACKAGE_SCHEMA_VERSION: str = "0.1"


def contains_control_characters(value: str) -> bool:
    """Detect control characters forbidden by the structural runtime contracts."""

    return value.contains("\n") or value.contains("\r") or value.contains("\t")


@derive(Clone)
pub enum ReviewStatus(str):
    """Review state carried by a deployable evidence record."""

    Approved = "approved"
    Pending = "pending"
    Rejected = "rejected"


@derive(Clone)
pub enum RightsStatus(str):
    """Whether runtime use of an evidence record is allowed."""

    Allowed = "allowed"
    Restricted = "restricted"
    Denied = "denied"


@derive(Clone)
pub enum RuntimeDecision(str):
    """Terminal structural-admission result."""

    Admit = "admit"
    Reject = "reject"


@derive(Clone)
pub model ActionContract:
    """Package-declared action and its evidence requirement."""

    pub id: ActionId
    pub evidence_required: bool


@derive(Clone)
pub model EvidenceRecord:
    """Reviewed support record; raw source text is deliberately absent."""

    pub id: EvidenceId
    pub claim: str
    pub guidance: str
    pub source_ref: str
    pub rights_status: RightsStatus
    pub review_status: ReviewStatus


@derive(Clone)
pub model GovernedPackage:
    """Small runtime-ready package contract owned by an external implementation."""

    pub schema_version: str
    pub package_id: PackageId
    pub domain_id: DomainId
    pub mission: str
    pub actions: list[ActionContract]
    pub evidence: list[EvidenceRecord]


@derive(Clone)
pub model ModelProposal:
    """Untrusted visible output and the package artifacts it claims to use."""

    pub package_id: PackageId
    pub domain_id: DomainId
    pub action_id: ActionId
    pub visible_output: str
    pub evidence_ids: list[EvidenceId]


@derive(Clone)
pub model PackageValidation:
    """Complete structural validation result for a runtime package."""

    pub valid: bool
    pub errors: list[str]


@derive(Clone)
pub model AdmissionResult:
    """Runtime decision and cited evidence identifiers, without chain-of-thought."""

    pub admitted: bool
    pub decision: RuntimeDecision
    pub reason: str
    pub evidence_ids: list[EvidenceId]
    pub package_errors: list[str]


pub def action_contract(id: ActionId, evidence_required: bool) -> ActionContract:
    """Construct one package-owned action declaration."""
    return ActionContract(id=id, evidence_required=evidence_required)


pub def evidence_record(
    id: EvidenceId,
    claim: str,
    guidance: str,
    source_ref: str,
    rights_status: RightsStatus,
    review_status: ReviewStatus,
) -> EvidenceRecord:
    """Construct one source-safe support record."""
    return EvidenceRecord(
        id=id,
        claim=claim,
        guidance=guidance,
        source_ref=source_ref,
        rights_status=rights_status,
        review_status=review_status,
    )


pub def approved_evidence_record(id: EvidenceId, claim: str, guidance: str, source_ref: str) -> EvidenceRecord:
    """Construct the approved/allowed projection used by checked profile adapters."""
    return evidence_record(id, claim, guidance, source_ref, RightsStatus.Allowed, ReviewStatus.Approved)


pub def admission_is_admitted(result: AdmissionResult) -> bool:
    """Expose structural admission without leaking model representation across module boundaries."""
    return result.admitted


pub def admission_reason(result: AdmissionResult) -> str:
    """Return the checked kernel's stable structural reason."""
    return result.reason


pub def admission_evidence_ids(result: AdmissionResult) -> list[EvidenceId]:
    """Return the kernel-admitted evidence identifiers in checked order."""
    return result.evidence_ids


pub def governed_package(
    schema_version: str,
    package_id: PackageId,
    domain_id: DomainId,
    mission: str,
    actions: list[ActionContract],
    evidence: list[EvidenceRecord],
) -> GovernedPackage:
    """Construct a runtime package without loading files or invoking providers."""
    return GovernedPackage(
        schema_version=schema_version,
        package_id=package_id,
        domain_id=domain_id,
        mission=mission,
        actions=actions,
        evidence=evidence,
    )


pub def model_proposal(
    package_id: PackageId,
    domain_id: DomainId,
    action_id: ActionId,
    visible_output: str,
    evidence_ids: list[EvidenceId],
) -> ModelProposal:
    """Construct untrusted model output for admission at the runtime boundary."""
    return ModelProposal(
        package_id=package_id,
        domain_id=domain_id,
        action_id=action_id,
        visible_output=visible_output,
        evidence_ids=evidence_ids,
    )


def source_ref_is_safe(value: str) -> bool:
    """Accept a repository-style source reference without traversal or URI syntax."""

    if value == "" or value.strip() != value or contains_control_characters(value):
        return false
    if value.contains("\\") or value.contains("..") or value.contains("file://") or value.contains(":/"):
        return false
    parts = value.split("/")
    if len(parts) > 0 and parts[0] == "":
        return false
    return true


def has_duplicate_action_ids(actions: list[ActionContract]) -> bool:
    """Return whether package actions repeat an earlier identifier."""

    for left in range(len(actions)):
        for right in range(len(actions)):
            if right > left and actions[left].id == actions[right].id:
                return true
    return false


def has_duplicate_evidence_ids(evidence: list[EvidenceRecord]) -> bool:
    """Return whether package evidence repeats an earlier identifier."""

    for left in range(len(evidence)):
        for right in range(len(evidence)):
            if right > left and evidence[left].id == evidence[right].id:
                return true
    return false


def has_duplicate_evidence_references(values: list[EvidenceId]) -> bool:
    """Return whether a proposal repeats an earlier evidence identifier."""

    for left in range(len(values)):
        for right in range(len(values)):
            if right > left and values[left] == values[right]:
                return true
    return false


pub def validate_governed_package(package: GovernedPackage) -> PackageValidation:
    """Reject malformed, ambiguous, unreviewed, or rights-blocked runtime packages."""
    mut errors: list[str] = []
    if package.schema_version != GOVERNED_PACKAGE_SCHEMA_VERSION:
        errors.append("unsupported_schema_version")
    if package.mission.strip() == "":
        errors.append("missing_mission")
    if len(package.actions) == 0:
        errors.append("missing_actions")
    if has_duplicate_action_ids(package.actions):
        errors.append("duplicate_action_id")
    if has_duplicate_evidence_ids(package.evidence):
        errors.append("duplicate_evidence_id")
    for record in package.evidence:
        if record.claim.strip() == "":
            errors.append("missing_evidence_claim")
        if record.guidance.strip() == "":
            errors.append("missing_evidence_guidance")
        if not source_ref_is_safe(f"{record.source_ref}"):
            errors.append("unsafe_source_ref")
        if record.rights_status != RightsStatus.Allowed:
            errors.append("evidence_rights_not_allowed")
        if record.review_status != ReviewStatus.Approved:
            errors.append("evidence_not_approved")
    return PackageValidation(valid=len(errors) == 0, errors=errors)


def rejected_admission(reason: str, package_errors: list[str]) -> AdmissionResult:
    """Construct a structural rejection without admitted evidence identifiers."""

    return AdmissionResult(
        admitted=false,
        decision=RuntimeDecision.Reject,
        reason=reason,
        evidence_ids=[],
        package_errors=package_errors,
    )


pub def admit_model_proposal(package: GovernedPackage, proposal: ModelProposal) -> AdmissionResult:
    """Admit only a visible proposal whose declared action and evidence belong to a valid package."""
    validation = validate_governed_package(package)
    if not validation.valid:
        return rejected_admission("invalid_package", validation.errors)
    if proposal.package_id != package.package_id:
        return rejected_admission("package_id_mismatch", [])
    if proposal.domain_id != package.domain_id:
        return rejected_admission("domain_id_mismatch", [])
    if proposal.visible_output.strip() == "":
        return rejected_admission("missing_visible_output", [])

    mut action_known = false
    mut evidence_required = false
    for action in package.actions:
        if action.id == proposal.action_id:
            action_known = true
            evidence_required = action.evidence_required
    if not action_known:
        return rejected_admission("unknown_action", [])
    if has_duplicate_evidence_references(proposal.evidence_ids):
        return rejected_admission("duplicate_evidence_reference", [])
    if evidence_required and len(proposal.evidence_ids) == 0:
        return rejected_admission("evidence_required", [])

    package_evidence_ids = [record.id for record in package.evidence]
    for evidence_id in proposal.evidence_ids:
        if not package_evidence_ids.contains(evidence_id):
            return rejected_admission("unknown_evidence", [])

    return AdmissionResult(
        admitted=true,
        decision=RuntimeDecision.Admit,
        reason="admitted",
        evidence_ids=proposal.evidence_ids,
        package_errors=[],
    )
