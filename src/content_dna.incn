"""
Closed admitted-answer Content DNA and profile-receipt envelope builders.

The profile passes only already-validated terminal projections into this module. Hashing remains Incan-authored and no
host or provider can construct these authority-bearing envelopes.
"""

from rust::std::string import String as RustString
from std.encoding.hex import hexlify
from std.hash import sha256
from std.json import JsonValue
from std.serde import json
from crate.identifiers import (
    ConstraintPlanId,
    ContentDnaId,
    ContractId,
    DecisionId,
    DigestIdType,
    DomainId,
    EvidenceId,
    MemoryId,
    PackageId,
    ProfileId,
    ProposalId,
    ReceiptId,
    RevisionType,
    RequestId,
    ResponseContractId,
    content_dna_id_text,
    digest_id_type,
    digest_id_type_text,
    receipt_id_text,
)


@derive(Clone, json)
pub model ContentDnaPackage:
    """Fixed governed-package identity bound into admitted-answer provenance."""

    pub package_id: PackageId
    pub domain_id: DomainId
    pub package_revision: RevisionType
    pub artifact_digest: DigestIdType


@derive(Clone, json)
pub model ContentDnaTerminal:
    """Terminal Spectrum decision recorded by admitted-answer provenance."""

    pub decision: str
    pub reason_namespace: str
    pub reason: str


@derive(Clone, json)
pub model ContentDnaPolicy:
    """Package-owned constraint and response-contract identity for one answer."""

    pub constraint_plan_id: ConstraintPlanId
    pub constraint_plan_revision: RevisionType
    pub response_contract_id: ResponseContractId
    pub response_contract_revision: RevisionType


@derive(Clone, json)
pub model ContentDnaEntry:
    """Source-safe provenance projection for one terminally selected memory atom."""

    pub memory_id: MemoryId
    pub source_ref: str
    pub source_kind: str
    pub source_fingerprint: DigestIdType
    pub provenance_digest: DigestIdType
    pub review_state: str
    pub review_revision: RevisionType
    pub rights_state: str
    pub authority_class: str
    pub evidence_kind: str


@derive(Clone, json)
pub model ContentDnaBody:
    """Closed admitted-answer provenance body before envelope sealing."""

    pub contract_version: ContractId
    pub state: str
    pub package: ContentDnaPackage
    pub proposal_id: ProposalId
    pub spectrum_decision_id: DecisionId
    pub terminal: ContentDnaTerminal
    pub policy: ContentDnaPolicy
    pub entries: list[ContentDnaEntry]
    pub source_digests: list[DigestIdType]
    pub answer_digest: DigestIdType


@derive(Clone, json)
pub model ContentDna:
    """Internally sealed Content DNA envelope and its canonical identity."""

    pub body: ContentDnaBody
    pub content_dna_id: ContentDnaId


@derive(Clone, json)
pub model AdmittedReceiptBody:
    """Redacted terminal receipt body for an admitted visible answer."""

    pub contract_version: ContractId
    pub profile_id: ProfileId
    pub package_id: PackageId
    pub domain_id: DomainId
    pub package_revision: RevisionType
    pub artifact_digest: DigestIdType
    pub request_id: RequestId
    pub request_digest: DigestIdType
    pub proposal_id: ProposalId
    pub candidate_digest: DigestIdType
    pub decision: str
    pub reason_namespace: str
    pub reason: str
    pub structural_reason: Option[str]
    pub admitted_evidence_ids: list[EvidenceId]
    pub selected_memory_ids: list[MemoryId]
    pub content_dna_id: ContentDnaId


@derive(Clone, json)
pub model RejectedReceiptBody:
    """Redacted receipt body for a rejection with safely established identity."""

    pub contract_version: ContractId
    pub profile_id: ProfileId
    pub package_id: PackageId
    pub domain_id: DomainId
    pub package_revision: RevisionType
    pub artifact_digest: DigestIdType
    pub request_id: RequestId
    pub request_digest: DigestIdType
    pub proposal_id: ProposalId
    pub candidate_digest: DigestIdType
    pub decision: str
    pub reason_namespace: str
    pub reason: str
    pub structural_reason: Option[str]


@derive(Clone, json)
pub model ProfileReceipt:
    """Internally sealed receipt projection and its canonical identity."""

    pub body: JsonValue
    pub receipt_id: ReceiptId


def serialize_json_value(value: JsonValue) -> Result[str, str]:
    """Serialize one parsed value while preserving failure as data."""

    return value.to_json().map_err((_error) => f"json_serialization_failed")


pub def digest_text_bytes(value: str) -> DigestIdType:
    """Return the lowercase SHA-256 identity of exact UTF-8 text."""

    return digest_id_type(f"sha256:{hexlify(sha256.digest(RustString.from(value).into_bytes()))}")


pub def digest_canonical_json(source: str) -> Result[DigestIdType, str]:
    """Normalize arbitrary JSON with the current Incan serializer and hash the rendered bytes."""

    return JsonValue
        .parse(source)
        .map_err((_error) => f"invalid_json")
        .and_then(serialize_json_value)
        .map(digest_text_bytes)


pub def construct_content_dna(body: ContentDnaBody) -> Option[ContentDna]:
    """Seal one admitted-answer body, or fail closed if its JSON projection cannot be normalized."""

    match digest_canonical_json(body.to_json()):
        Err(_) => return None
        Ok(identity) => return Some(ContentDna(body=body, content_dna_id=ContentDnaId(identity)))


pub def content_dna_identity(value: ContentDna) -> str:
    """Expose the sealed identity without requiring sibling modules to inspect model storage."""
    return content_dna_id_text(value.content_dna_id)


pub def content_dna_identifier(value: ContentDna) -> ContentDnaId:
    """Expose the nominal sealed identity for authority-bearing sibling contracts."""
    return value.content_dna_id


pub def content_dna_answer_digest(value: ContentDna) -> str:
    """Expose the answer binding without making the sealed body caller-constructible."""
    return digest_id_type_text(value.body.answer_digest)


def construct_profile_receipt(body_source: str) -> Option[ProfileReceipt]:
    """Seal one typed receipt body after converting it to an opaque JSON projection."""
    match JsonValue.parse(body_source):
        Err(_) => return None
        Ok(body) =>
            match body.to_json():
                Err(_) => return None
                Ok(canonical) =>
                    return Some(ProfileReceipt(body=body, receipt_id=ReceiptId(digest_text_bytes(canonical))))


pub def construct_admitted_receipt(body: AdmittedReceiptBody) -> Option[ProfileReceipt]:
    """Seal one redacted admitted receipt under its canonical digest."""
    return construct_profile_receipt(body.to_json())


pub def construct_rejected_receipt(body: RejectedReceiptBody) -> Option[ProfileReceipt]:
    """Seal one redacted rejected receipt without admitted-only members."""
    return construct_profile_receipt(body.to_json())


pub def profile_receipt_identity(value: ProfileReceipt) -> str:
    """Expose the receipt digest while keeping its sealed body non-constructible."""
    return receipt_id_text(value.receipt_id)
