"""Fail-closed validation for generic governed packages, requests, and proposals."""

from crate.governed_profile_identity import digest_governed_request_fields
from crate.governed_profile_models import (
    GovernedAction,
    GovernedEvidence,
    GovernedMemory,
    GovernedOutcomeKind,
    GovernedProfilePackage,
    GovernedProposal,
    GovernedRequest,
    GovernedValidation,
    GuidedMaterial,
    GuidedTransition,
)
from crate.identifiers import (
    ActionId,
    EvidenceId,
    GuidedMaterialId,
    GuidedStepId,
    MemoryId,
    action_id_text,
    artifact_revision_text,
    artifact_revision_text_is_safe,
    audience_id_text,
    committee_role_id_text,
    contract_id_text,
    digest_id_type_text,
    digest_id_text_is_safe,
    domain_id_text,
    evidence_id_text,
    guided_material_id_text,
    guided_step_id_text,
    identifier_text_is_safe,
    memory_id_text,
    observation_id_text,
    package_id_text,
    profile_id_text,
    proposal_id_text,
    request_id_text,
)


const PACKAGE_CONTRACT: str = "governed_profile_package_0_1"
const PROPOSAL_CONTRACT: str = "governed_profile_proposal_0_1"
const PROFILE_ID: str = "governed_profile_0_1"


pub def governed_validation_ok() -> GovernedValidation:
    """Construct the shared successful validation result."""

    return GovernedValidation(valid=true, reason="ok", errors=[])


pub def governed_validation_error(reason: str, error: str) -> GovernedValidation:
    """Construct one stable public reason with one bounded diagnostic."""

    return GovernedValidation(valid=false, reason=reason, errors=[error])


def has_duplicate_strings(values: list[str]) -> bool:
    """Return whether one bounded text projection repeats an earlier value."""

    mut seen: list[str] = []
    for value in values:
        if seen.contains(value):
            return true
        seen.append(value)
    return false


def source_ref_is_safe(value: str) -> bool:
    """Accept a bounded source-safe reference while rejecting traversal and local paths."""

    if value == "" or len(value) > 256 or value.strip() != value:
        return false
    if value.contains("\n") or value.contains("\r") or value.contains("\t"):
        return false
    if value.contains("..") or value.contains("\\") or value.contains("file://") or value.startswith("/"):
        return false
    for character in value:
        if not "abcdefghijklmnopqrstuvwxyz0123456789_./:-".contains(character):
            return false
    return true


def language_is_safe(value: str) -> bool:
    """Accept one lowercase package language tag without implicit fallback."""

    if len(value) < 2 or len(value) > 16 or "-_".contains(value[0:1]):
        return false
    for character in value:
        if not "abcdefghijklmnopqrstuvwxyz0123456789-".contains(character):
            return false
    return true


def action_identity_is_safe(action: GovernedAction) -> bool:
    return identifier_text_is_safe(action_id_text(action.action_id))


def evidence_identity_is_safe(evidence: GovernedEvidence) -> bool:
    return identifier_text_is_safe(evidence_id_text(evidence.evidence_id))


def memory_identity_is_safe(memory: GovernedMemory) -> bool:
    return identifier_text_is_safe(memory_id_text(memory.memory_id))


def guided_identity_is_safe(material: GuidedMaterial) -> bool:
    return (
        identifier_text_is_safe(guided_material_id_text(material.guided_material_id))
        and artifact_revision_text_is_safe(artifact_revision_text(material.artifact_revision))
        and digest_id_text_is_safe(digest_id_type_text(material.artifact_digest))
        and identifier_text_is_safe(audience_id_text(material.audience))
    )


pub def find_governed_action(
    actions: list[GovernedAction],
    action_id: ActionId,
) -> Option[GovernedAction]:
    """Resolve one package-declared action by nominal identity."""

    for action in actions:
        if action.action_id == action_id:
            return Some(action)
    return None


pub def find_governed_evidence(
    evidence: list[GovernedEvidence],
    evidence_id: EvidenceId,
) -> Option[GovernedEvidence]:
    """Resolve one package evidence record by nominal identity."""

    for record in evidence:
        if record.evidence_id == evidence_id:
            return Some(record)
    return None


pub def find_governed_memory(
    memory: list[GovernedMemory],
    memory_id: MemoryId,
) -> Option[GovernedMemory]:
    """Resolve one governed memory atom by nominal identity."""

    for atom in memory:
        if atom.memory_id == memory_id:
            return Some(atom)
    return None


pub def find_guided_material(
    guided_material: list[GuidedMaterial],
    guided_material_id: GuidedMaterialId,
) -> Option[GuidedMaterial]:
    """Resolve one package-owned guided artifact declaration."""

    for material in guided_material:
        if material.guided_material_id == guided_material_id:
            return Some(material)
    return None


def evidence_ids_equal_set(left: list[EvidenceId], right: list[EvidenceId]) -> bool:
    if len(left) != len(right):
        return false
    for value in left:
        if not right.contains(value):
            return false
    return true


def memory_ids_equal_set(left: list[MemoryId], right: list[MemoryId]) -> bool:
    if len(left) != len(right):
        return false
    for value in left:
        if not right.contains(value):
            return false
    return true


def selected_evidence_for_memory(
    package: GovernedProfilePackage,
    memory_ids: list[MemoryId],
) -> list[EvidenceId]:
    """Collect the duplicate-free evidence union of selected memory in package order."""

    mut result: list[EvidenceId] = []
    for memory_id in memory_ids:
        match find_governed_memory(package.memory, memory_id):
            None => return []
            Some(atom) =>
                for evidence_id in atom.evidence_ids:
                    if not result.contains(evidence_id):
                        result.append(evidence_id)
    return result


def validate_package_header(package: GovernedProfilePackage) -> GovernedValidation:
    if contract_id_text(package.contract_version) != PACKAGE_CONTRACT:
        return governed_validation_error("invalid_package", "unsupported_package_contract")
    if profile_id_text(package.profile_id) != PROFILE_ID:
        return governed_validation_error("invalid_package", "unsupported_profile")
    if not identifier_text_is_safe(package_id_text(package.package_id)):
        return governed_validation_error("invalid_package", "invalid_package_id")
    if not identifier_text_is_safe(domain_id_text(package.domain_id)):
        return governed_validation_error("invalid_package", "invalid_domain_id")
    if not artifact_revision_text_is_safe(artifact_revision_text(package.package_revision)):
        return governed_validation_error("invalid_package", "invalid_package_revision")
    if not digest_id_text_is_safe(digest_id_type_text(package.artifact_digest)):
        return governed_validation_error("invalid_package", "invalid_artifact_digest")
    if package.mission.strip() == "" or len(package.mission) > 512:
        return governed_validation_error("invalid_package", "invalid_mission")
    return governed_validation_ok()


def validate_package_shape(package: GovernedProfilePackage) -> GovernedValidation:
    if len(package.actions) == 0 or len(package.actions) > 16:
        return governed_validation_error("invalid_package", "invalid_action_count")
    if len(package.evidence) == 0 or len(package.evidence) > 64:
        return governed_validation_error("invalid_package", "invalid_evidence_count")
    if len(package.memory) == 0 or len(package.memory) > 64:
        return governed_validation_error("invalid_package", "invalid_memory_count")
    if len(package.guided_material) > 16:
        return governed_validation_error("invalid_package", "invalid_guided_material_count")
    if has_duplicate_strings([action_id_text(value.action_id) for value in package.actions]):
        return governed_validation_error("invalid_package", "duplicate_action_id")
    if has_duplicate_strings([evidence_id_text(value.evidence_id) for value in package.evidence]):
        return governed_validation_error("invalid_package", "duplicate_evidence_id")
    if has_duplicate_strings([memory_id_text(value.memory_id) for value in package.memory]):
        return governed_validation_error("invalid_package", "duplicate_memory_id")
    if has_duplicate_strings(
        [guided_material_id_text(value.guided_material_id) for value in package.guided_material],
    ):
        return governed_validation_error("invalid_package", "duplicate_guided_material_id")
    return governed_validation_ok()


def validate_action(action: GovernedAction) -> GovernedValidation:
    if not action_identity_is_safe(action):
        return governed_validation_error("invalid_package", "invalid_action_id")
    if action.outcome_kind in [GovernedOutcomeKind.Refusal, GovernedOutcomeKind.Escalation]:
        if action.evidence_required or action.committee_required:
            return governed_validation_error("invalid_package", "terminal_boundary_action_requires_support")
    if action.outcome_kind in [
        GovernedOutcomeKind.Answer,
        GovernedOutcomeKind.GuidedMaterial,
        GovernedOutcomeKind.GuidedNavigation,
    ]:
        if not action.evidence_required:
            return governed_validation_error("invalid_package", "deliverable_action_missing_evidence_requirement")
    return governed_validation_ok()


def validate_evidence(record: GovernedEvidence) -> GovernedValidation:
    if not evidence_identity_is_safe(record):
        return governed_validation_error("invalid_package", "invalid_evidence_id")
    if record.claim.strip() == "" or len(record.claim) > 512:
        return governed_validation_error("invalid_package", "invalid_evidence_claim")
    if record.guidance.strip() == "" or len(record.guidance) > 512:
        return governed_validation_error("invalid_package", "invalid_evidence_guidance")
    if not source_ref_is_safe(record.source_ref) or record.source_kind.strip() == "" or len(record.source_kind) > 64:
        return governed_validation_error("invalid_package", "invalid_evidence_source")
    if not digest_id_text_is_safe(digest_id_type_text(record.source_fingerprint)):
        return governed_validation_error("invalid_package", "invalid_source_fingerprint")
    if not language_is_safe(record.language):
        return governed_validation_error("invalid_package", "invalid_evidence_language")
    if record.review_state != "approved" or record.rights_state != "allowed":
        return governed_validation_error("invalid_package", "evidence_not_admitted")
    if record.authority_class.strip() == "" or len(record.authority_class) > 64:
        return governed_validation_error("invalid_package", "invalid_evidence_authority")
    if record.evidence_kind.strip() == "" or len(record.evidence_kind) > 64:
        return governed_validation_error("invalid_package", "invalid_evidence_kind")
    return governed_validation_ok()


def validate_memory(package: GovernedProfilePackage, atom: GovernedMemory) -> GovernedValidation:
    if not memory_identity_is_safe(atom):
        return governed_validation_error("invalid_package", "invalid_memory_id")
    if atom.concept.strip() == "" or len(atom.concept) > 512:
        return governed_validation_error("invalid_package", "invalid_memory_concept")
    if len(atom.evidence_ids) == 0 or len(atom.evidence_ids) > 8:
        return governed_validation_error("invalid_package", "invalid_memory_evidence_count")
    if has_duplicate_strings([evidence_id_text(value) for value in atom.evidence_ids]):
        return governed_validation_error("invalid_package", "duplicate_memory_evidence")
    for evidence_id in atom.evidence_ids:
        match find_governed_evidence(package.evidence, evidence_id):
            None => return governed_validation_error("invalid_package", "unknown_memory_evidence")
            Some(_) => pass
    if atom.review_state != "approved" or atom.rights_state != "allowed":
        return governed_validation_error("invalid_package", "memory_not_admitted")
    if not digest_id_text_is_safe(digest_id_type_text(atom.provenance_digest)):
        return governed_validation_error("invalid_package", "invalid_memory_provenance")
    return governed_validation_ok()


def transition_is_declared(material: GuidedMaterial, current: GuidedStepId, next: GuidedStepId) -> bool:
    for transition in material.transitions:
        if transition.current_step_id == current and transition.next_step_id == next:
            return true
    return false


def validate_transition(material: GuidedMaterial, transition: GuidedTransition) -> GovernedValidation:
    if not material.steps.contains(transition.current_step_id) or not material.steps.contains(transition.next_step_id):
        return governed_validation_error("invalid_package", "unknown_guided_transition_step")
    if transition.current_step_id == transition.next_step_id:
        return governed_validation_error("invalid_package", "self_guided_transition")
    return governed_validation_ok()


def validate_guided_material(
    package: GovernedProfilePackage,
    material: GuidedMaterial,
) -> GovernedValidation:
    if not guided_identity_is_safe(material):
        return governed_validation_error("invalid_package", "invalid_guided_material_identity")
    if not language_is_safe(material.language):
        return governed_validation_error("invalid_package", "invalid_guided_material_language")
    if material.review_state != "approved" or material.rights_state != "allowed":
        return governed_validation_error("invalid_package", "guided_material_not_admitted")
    if len(material.memory_ids) == 0 or len(material.memory_ids) > 8:
        return governed_validation_error("invalid_package", "invalid_guided_memory_count")
    if len(material.evidence_ids) == 0 or len(material.evidence_ids) > 16:
        return governed_validation_error("invalid_package", "invalid_guided_evidence_count")
    if has_duplicate_strings([memory_id_text(value) for value in material.memory_ids]):
        return governed_validation_error("invalid_package", "duplicate_guided_memory")
    if has_duplicate_strings([evidence_id_text(value) for value in material.evidence_ids]):
        return governed_validation_error("invalid_package", "duplicate_guided_evidence")
    for memory_id in material.memory_ids:
        match find_governed_memory(package.memory, memory_id):
            None => return governed_validation_error("invalid_package", "unknown_guided_memory")
            Some(_) => pass
    for evidence_id in material.evidence_ids:
        match find_governed_evidence(package.evidence, evidence_id):
            None => return governed_validation_error("invalid_package", "unknown_guided_evidence")
            Some(_) => pass
    if not evidence_ids_equal_set(
        material.evidence_ids,
        selected_evidence_for_memory(package, material.memory_ids),
    ):
        return governed_validation_error("invalid_package", "guided_memory_evidence_mismatch")
    match find_governed_action(package.actions, material.presentation_action_id):
        None => return governed_validation_error("invalid_package", "unknown_guided_presentation_action")
        Some(action) =>
            if action.outcome_kind != GovernedOutcomeKind.GuidedMaterial:
                return governed_validation_error("invalid_package", "invalid_guided_presentation_action")
    match find_governed_action(package.actions, material.navigation_action_id):
        None => return governed_validation_error("invalid_package", "unknown_guided_navigation_action")
        Some(action) =>
            if action.outcome_kind != GovernedOutcomeKind.GuidedNavigation:
                return governed_validation_error("invalid_package", "invalid_guided_navigation_action")
    if len(material.steps) == 0 or len(material.steps) > 8:
        return governed_validation_error("invalid_package", "invalid_guided_steps")
    if has_duplicate_strings([guided_step_id_text(value) for value in material.steps]):
        return governed_validation_error("invalid_package", "duplicate_guided_step")
    mut transition_keys: list[str] = []
    for transition in material.transitions:
        validation = validate_transition(material, transition)
        if not validation.valid:
            return validation
        if transition_keys.contains(
            f"{guided_step_id_text(transition.current_step_id)}->{guided_step_id_text(transition.next_step_id)}",
        ):
            return governed_validation_error("invalid_package", "duplicate_guided_transition")
        transition_keys.append(
            f"{guided_step_id_text(transition.current_step_id)}->{guided_step_id_text(transition.next_step_id)}",
        )
    return governed_validation_ok()


def validate_policy(package: GovernedProfilePackage) -> GovernedValidation:
    roles = package.policy.required_roles
    if len(roles) == 0 or len(roles) > 16:
        return governed_validation_error("invalid_package", "invalid_committee_role_count")
    if has_duplicate_strings([committee_role_id_text(value) for value in roles]):
        return governed_validation_error("invalid_package", "duplicate_committee_role")
    for role in roles:
        if not identifier_text_is_safe(committee_role_id_text(role)):
            return governed_validation_error("invalid_package", "invalid_committee_role")
    if not package.policy.require_all_passed:
        return governed_validation_error("invalid_package", "unsupported_committee_policy")
    return governed_validation_ok()


pub def validate_governed_profile_package(package: GovernedProfilePackage) -> GovernedValidation:
    """Validate one generic package projection without authoring or activating it."""

    for validation in [validate_package_header(package), validate_package_shape(package)]:
        if not validation.valid:
            return validation
    for action in package.actions:
        validation = validate_action(action)
        if not validation.valid:
            return validation
    for record in package.evidence:
        validation = validate_evidence(record)
        if not validation.valid:
            return validation
    for atom in package.memory:
        validation = validate_memory(package, atom)
        if not validation.valid:
            return validation
    for material in package.guided_material:
        validation = validate_guided_material(package, material)
        if not validation.valid:
            return validation
    return validate_policy(package)


pub def validate_governed_request(request: GovernedRequest) -> GovernedValidation:
    """Validate exact question and trusted request context."""

    if not identifier_text_is_safe(request_id_text(request.request_id)):
        return governed_validation_error("invalid_request", "invalid_request_id")
    if request.question.strip() == "" or len(request.question) > 1024:
        return governed_validation_error("invalid_request", "invalid_question")
    if not language_is_safe(request.language):
        return governed_validation_error("invalid_request", "invalid_request_language")
    if not identifier_text_is_safe(audience_id_text(request.audience)):
        return governed_validation_error("invalid_request", "invalid_request_audience")
    expected = digest_governed_request_fields(
        request.request_id,
        request.question,
        request.language,
        request.audience,
    )
    if expected != request.request_digest:
        return governed_validation_error("request_digest_mismatch", "request_digest_mismatch")
    return governed_validation_ok()


pub def validate_governed_proposal_identity(
    package: GovernedProfilePackage,
    request: GovernedRequest,
    proposal: GovernedProposal,
) -> GovernedValidation:
    if contract_id_text(proposal.contract_version) != PROPOSAL_CONTRACT:
        return governed_validation_error("unsupported_proposal_contract", "unsupported_proposal_contract")
    if profile_id_text(proposal.profile_id) != PROFILE_ID or proposal.profile_id != package.profile_id:
        return governed_validation_error("profile_id_mismatch", "profile_id_mismatch")
    if proposal.package_id != package.package_id:
        return governed_validation_error("package_id_mismatch", "package_id_mismatch")
    if proposal.domain_id != package.domain_id:
        return governed_validation_error("domain_id_mismatch", "domain_id_mismatch")
    if proposal.package_revision != package.package_revision:
        return governed_validation_error("package_revision_mismatch", "package_revision_mismatch")
    if proposal.artifact_digest != package.artifact_digest:
        return governed_validation_error("artifact_digest_mismatch", "artifact_digest_mismatch")
    if proposal.request_id != request.request_id:
        return governed_validation_error("request_id_mismatch", "request_id_mismatch")
    if proposal.request_digest != request.request_digest:
        return governed_validation_error("request_digest_mismatch", "request_digest_mismatch")
    if not identifier_text_is_safe(proposal_id_text(proposal.proposal_id)):
        return governed_validation_error("invalid_proposal", "invalid_proposal_id")
    if proposal.visible_output.strip() == "" or len(proposal.visible_output) > 4096:
        return governed_validation_error("missing_visible_output", "invalid_visible_output")
    return governed_validation_ok()


def validate_guided_nomination(
    package: GovernedProfilePackage,
    request: GovernedRequest,
    proposal: GovernedProposal,
    action: GovernedAction,
) -> GovernedValidation:
    match proposal.guided_material_id:
        None => return governed_validation_error("guided_material_required", "guided_material_required")
        Some(identifier) =>
            match find_guided_material(package.guided_material, identifier):
                None => return governed_validation_error("unknown_guided_material", "unknown_guided_material")
                Some(material) =>
                    if material.language != request.language:
                        return governed_validation_error(
                            "guided_material_language_mismatch",
                            "guided_material_language_mismatch",
                        )
                    if material.audience != request.audience:
                        return governed_validation_error(
                            "guided_material_audience_mismatch",
                            "guided_material_audience_mismatch",
                        )
                    if not memory_ids_equal_set(proposal.memory_ids, material.memory_ids):
                        return governed_validation_error(
                            "guided_material_memory_mismatch",
                            "guided_material_memory_mismatch",
                        )
                    if not evidence_ids_equal_set(proposal.evidence_ids, material.evidence_ids):
                        return governed_validation_error(
                            "guided_material_evidence_mismatch",
                            "guided_material_evidence_mismatch",
                        )
                    if action.outcome_kind == GovernedOutcomeKind.GuidedMaterial:
                        if action.action_id != material.presentation_action_id:
                            return governed_validation_error(
                                "guided_material_action_mismatch",
                                "guided_material_action_mismatch",
                            )
                        match proposal.current_step_id:
                            None => pass
                            Some(_) =>
                                return governed_validation_error(
                                    "invalid_guided_transition",
                                    "unexpected_guided_transition",
                                )
                        match proposal.next_step_id:
                            None => pass
                            Some(_) =>
                                return governed_validation_error(
                                    "invalid_guided_transition",
                                    "unexpected_guided_transition",
                                )
                        return governed_validation_ok()
                    if action.outcome_kind == GovernedOutcomeKind.GuidedNavigation:
                        if action.action_id != material.navigation_action_id:
                            return governed_validation_error(
                                "guided_material_action_mismatch",
                                "guided_material_action_mismatch",
                            )
                        match proposal.current_step_id:
                            None =>
                                return governed_validation_error(
                                    "invalid_guided_transition",
                                    "current_step_required",
                                )
                            Some(current) =>
                                match proposal.next_step_id:
                                    None =>
                                        return governed_validation_error(
                                            "invalid_guided_transition",
                                            "next_step_required",
                                        )
                                    Some(next) =>
                                        if not transition_is_declared(material, current, next):
                                            return governed_validation_error(
                                                "invalid_guided_transition",
                                                "transition_not_declared",
                                            )
                                        return governed_validation_ok()
                    return governed_validation_error(
                        "guided_material_not_allowed",
                        "guided_material_not_allowed",
                    )


def validate_proposal_for_action(
    package: GovernedProfilePackage,
    request: GovernedRequest,
    proposal: GovernedProposal,
    action: GovernedAction,
) -> GovernedValidation:
    if action.outcome_kind in [GovernedOutcomeKind.GuidedMaterial, GovernedOutcomeKind.GuidedNavigation]:
        match proposal.guided_material_id:
            None => return governed_validation_error("guided_material_required", "guided_material_required")
            Some(identifier) =>
                match find_guided_material(package.guided_material, identifier):
                    None => return governed_validation_error("unknown_guided_material", "unknown_guided_material")
                    Some(_) => pass
    else:
        match proposal.guided_material_id:
            None => pass
            Some(_) => return governed_validation_error("guided_material_not_allowed", "guided_material_not_allowed")
        match proposal.current_step_id:
            None => pass
            Some(_) => return governed_validation_error("guided_material_not_allowed", "guided_material_not_allowed")
        match proposal.next_step_id:
            None => pass
            Some(_) => return governed_validation_error("guided_material_not_allowed", "guided_material_not_allowed")
    if has_duplicate_strings([evidence_id_text(value) for value in proposal.evidence_ids]):
        return governed_validation_error("duplicate_evidence_reference", "duplicate_evidence_reference")
    if has_duplicate_strings([memory_id_text(value) for value in proposal.memory_ids]):
        return governed_validation_error("duplicate_memory_reference", "duplicate_memory_reference")
    for evidence_id in proposal.evidence_ids:
        match find_governed_evidence(package.evidence, evidence_id):
            None => return governed_validation_error("unknown_evidence", "unknown_evidence")
            Some(_) => pass
    for memory_id in proposal.memory_ids:
        match find_governed_memory(package.memory, memory_id):
            None => return governed_validation_error("unknown_memory", "unknown_memory")
            Some(_) => pass
    if action.evidence_required and (len(proposal.evidence_ids) == 0 or len(proposal.memory_ids) == 0):
        return governed_validation_error("evidence_required", "evidence_and_memory_required")
    if not evidence_ids_equal_set(
        proposal.evidence_ids,
        selected_evidence_for_memory(package, proposal.memory_ids),
    ):
        return governed_validation_error("memory_evidence_mismatch", "memory_evidence_mismatch")
    if action.outcome_kind in [GovernedOutcomeKind.Refusal, GovernedOutcomeKind.Escalation]:
        if len(proposal.evidence_ids) > 0 or len(proposal.memory_ids) > 0:
            return governed_validation_error("terminal_boundary_support_not_allowed", "terminal_boundary_support_not_allowed")
        return governed_validation_ok()
    if action.outcome_kind in [GovernedOutcomeKind.GuidedMaterial, GovernedOutcomeKind.GuidedNavigation]:
        return validate_guided_nomination(package, request, proposal, action)
    return governed_validation_ok()


pub def validate_governed_proposal(
    package: GovernedProfilePackage,
    request: GovernedRequest,
    proposal: GovernedProposal,
) -> GovernedValidation:
    """Validate one untrusted proposal before committee findings or Spectrum."""

    identity = validate_governed_proposal_identity(package, request, proposal)
    if not identity.valid:
        return identity
    match find_governed_action(package.actions, proposal.action_id):
        None => return governed_validation_error("unknown_action", "unknown_action")
        Some(action) => return validate_proposal_for_action(package, request, proposal, action)
